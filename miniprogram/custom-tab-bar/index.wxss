:host {
  display: block;
}

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  box-sizing: content-box;
  height: 50px;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
}

.tab-bar::before {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: #e5e5e5;
  content: '';
  transform: scaleY(.5);
  transform-origin: top;
}

.tab-bar-items {
  display: flex;
  height: 50px;
}

.tab-bar-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #99a1ae;
}

.tab-bar-item.is-selected {
  color: #b29764;
}

.tab-bar-icon-wrap {
  position: relative;
  width: 24px;
  height: 24px;
}

.tab-bar-icon {
  display: block;
  width: 24px;
  height: 24px;
}

.tab-bar-label {
  margin-top: 2px;
  font-size: 10px;
  line-height: 14px;
}

.tab-bar-alert-dot {
  position: absolute;
  top: -1px;
  right: -5px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ff4d4f;
}
