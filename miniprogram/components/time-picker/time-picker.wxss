.time-picker-overlay {
  position: fixed;
  z-index: 1100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
}

.time-picker-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
}

.time-picker-sheet {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-height: calc(100vh - 24rpx);
  padding: 28rpx 32rpx 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.time-picker-header {
  color: #333;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
  text-align: center;
}

.time-picker-labels {
  display: flex;
  margin-top: 24rpx;
  color: #888;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.time-picker-labels text {
  width: 50%;
}

.time-picker-wheel {
  width: 100%;
  height: 400rpx;
  max-height: 40vh;
  min-height: 216rpx;
}

.time-picker-indicator {
  height: 80rpx;
}

.time-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  font-size: 40rpx;
  line-height: 80rpx;
}

.time-picker-actions {
  display: flex;
  margin-top: 20rpx;
}

.time-picker-button {
  flex: 1;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 84rpx;
}

.time-picker-button::after {
  border: 0;
}

.time-picker-cancel {
  margin-right: 24rpx;
  background: #f3f3f3;
  color: #555;
}

.time-picker-confirm {
  background: #b29764;
  color: #fff;
}

.time-picker-confirm[disabled] {
  background: #cbb99a;
  color: #fff;
}

@media (max-height: 500px) {
  .time-picker-sheet {
    padding: 12px 16px;
    padding-bottom: calc(12px + constant(safe-area-inset-bottom));
    padding-bottom: calc(12px + env(safe-area-inset-bottom));
  }

  .time-picker-header {
    font-size: 18px;
    line-height: 26px;
  }

  .time-picker-labels {
    margin-top: 6px;
    font-size: 14px;
    line-height: 20px;
  }

  .time-picker-wheel {
    height: 180px;
    min-height: 0;
  }

  .time-picker-indicator {
    height: 40px;
  }

  .time-picker-item {
    font-size: 22px;
    line-height: 40px;
  }

  .time-picker-actions {
    margin-top: 8px;
  }

  .time-picker-button {
    font-size: 18px;
    line-height: 44px;
  }
}
