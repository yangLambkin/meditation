.nickname-avatar {
  display: block;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-image,
.avatar-initial {
  width: 100%;
  height: 100%;
}

.avatar-image { display: block; }

.avatar-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #b29764;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}
