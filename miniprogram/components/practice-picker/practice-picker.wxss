.practice-picker-overlay {
  position: fixed;
  z-index: 1100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
}

.practice-picker-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(29, 40, 56, .45);
}

.practice-picker-sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  max-height: calc(100vh - 40rpx);
  padding: 0 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  border-radius: 32rpx 32rpx 0 0;
  background: #f8fafc;
  color: #354152;
  box-shadow: 0 -12rpx 60rpx rgba(29, 40, 56, .08);
}

.practice-picker-handle-area {
  flex: none;
  padding: 16rpx 0 12rpx;
}

.practice-picker-handle {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto;
  border-radius: 8rpx;
  background: #dce0e5;
}

.practice-picker-header {
  display: flex;
  align-items: flex-start;
  flex: none;
  gap: 20rpx;
  padding: 8rpx 0 28rpx;
}

.practice-picker-heading {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
}

.practice-picker-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
}

.practice-picker-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8c949e;
  font-size: 24rpx;
  line-height: 1.6;
}

button.practice-picker-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 76rpx;
  height: 76rpx;
  margin: 0 -8rpx 0 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: #8c949e;
  line-height: 1;
}

button.practice-picker-close-hover {
  background: #e9ecf0;
}

.practice-picker-close-icon {
  position: relative;
  width: 27rpx;
  height: 27rpx;
}

.practice-picker-close-icon::before,
.practice-picker-close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 27rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
  transform: rotate(45deg);
}

.practice-picker-close-icon::after {
  transform: rotate(-45deg);
}

.practice-picker-scroll {
  min-height: 0;
  max-height: calc(100vh - 360rpx);
  max-height: calc(100vh - 360rpx - constant(safe-area-inset-bottom));
  max-height: calc(100vh - 360rpx - env(safe-area-inset-bottom));
  flex-shrink: 1;
}

.practice-picker-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

button.practice-picker-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: calc(50% - 8rpx);
  min-height: 132rpx;
  margin: 0;
  padding: 20rpx 22rpx;
  border: 2rpx solid #e9ecf0;
  border-radius: 20rpx;
  background: #fff;
  color: #354152;
  text-align: left;
  line-height: 1.5;
}

button.practice-picker-option-all {
  width: 100%;
}

button.practice-picker-option-selected {
  border-color: #b29764;
  background: #f7f2e8;
}

button.practice-picker-option-hover {
  background: #f1ece2;
}

.practice-picker-option-copy {
  flex: 1;
  min-width: 0;
}

.practice-picker-option-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

.practice-picker-option-hint {
  display: block;
  margin-top: 6rpx;
  color: #99a1ae;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.5;
}

.practice-picker-option-selected .practice-picker-option-name {
  color: #927442;
}

.practice-picker-option-selected .practice-picker-option-hint {
  color: #a58b60;
}

.practice-picker-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
  width: 32rpx;
  height: 32rpx;
  margin-left: 14rpx;
  border: 2rpx solid #dce0e5;
  border-radius: 50%;
  background: #fff;
}

.practice-picker-option-selected .practice-picker-radio {
  border-color: #b29764;
  background: #b29764;
}

.practice-picker-check {
  width: 12rpx;
  height: 7rpx;
  margin-top: -3rpx;
  border-bottom: 3rpx solid #fff;
  border-left: 3rpx solid #fff;
  transform: rotate(-45deg);
}

.practice-picker-empty {
  box-sizing: border-box;
  padding: 44rpx 20rpx;
  text-align: center;
}

.practice-picker-empty-title {
  display: block;
  color: #7a8493;
  font-size: 27rpx;
  line-height: 1.6;
}

.practice-picker-empty-hint {
  display: block;
  margin-top: 10rpx;
  color: #99a1ae;
  font-size: 23rpx;
  line-height: 1.7;
}

.practice-picker-footer {
  flex: none;
  padding: 24rpx 0 20rpx;
}

button.practice-picker-settings {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #eef0f3;
  color: #7a8493;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 80rpx;
}

button.practice-picker-settings-hover {
  background: #e5e8ec;
}

.practice-picker-settings-arrow {
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}

button::after {
  border: none;
}

@media (max-height: 500px) {
  .practice-picker-handle-area { padding: 12rpx 0 6rpx; }
  .practice-picker-header { padding-bottom: 18rpx; }
  .practice-picker-scroll { max-height: calc(100vh - 300rpx); max-height: calc(100vh - 300rpx - env(safe-area-inset-bottom)); }
  .practice-picker-footer { padding-top: 18rpx; padding-bottom: 16rpx; }
}
