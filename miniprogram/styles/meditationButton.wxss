/* 首页和功课页共用的操作按钮。页面只设置宽度和外部间距。 */
.weui-btn.meditation-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 16rpx;
  background-color: #b29764;
  color: #fff;
  font-size: 18px;
  line-height: 1;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  overflow: hidden;
  transition: all 0.3s ease;
}

.weui-btn.meditation-btn::after {
  border: none;
}

.meditation-btn.meditation-btn-secondary {
  border: 2rpx solid #b297644d;
  background-color: #f0eae0;
  color: #927a4e;
}

.meditation-btn-secondary.checkin-record-active {
  background-color: #e8decd;
}

.meditation-btn.primary.weui-btn_active {
  background-color: #9c8357;
}

.meditation-btn:active {
  transform: scale(0.98);
  box-shadow: 0rpx 2rpx 4rpx rgba(178, 151, 100, 0.3);
}

.weui-btn.meditation-btn[disabled] {
  background-color: #cbbda3;
  color: #fff;
  transform: none;
  box-shadow: none;
}

.meditation-btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.meditation-btn-text {
  font-size: 30rpx;
  font-family: Arimo;
  font-weight: 600;
  line-height: 1;
}
