{
  "pages": [
    "pages/index/index",
    "pages/example/index",
    "pages/timer/timer",
    "pages/recorder/recorder",
    "pages/daily/daily1",
    "pages/me/me",
    "pages/history/history",
    "pages/profile/profile",
    "pages/badge/badge",
    "pages/team/team"
  ],
  "subPackages": [
    {
      "root": "subpackages/team",
      "pages": [
        "pages/createTeam/createTeam",
        "pages/teamDetails/teamDetails",
        "pages/joinTeam/joinTeam"
      ]
    },
    {
      "root": "subpackages/chattool",
      "name": "chattool",
      "pages": [
        "pages/invite/invite"
      ],
      "independent": true,
      "renderer": "skyline",
      "componentFramework": "glass-easel"
    }
  ],
  "chatTools": [
    {
      "root": "subpackages/chattool",
      "entryPagePath": "pages/invite/invite",
      "desc": "团队邀请工具",
      "scopes": ["scope.userInfo"]
    }
  ],
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "sdkVersionBegin": "3.7.0"
    }
  },
  "window": {
    "backgroundColor": "#F6F6F6",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#F6F6F6",
    "navigationBarTitleText": "静坐觉察",
    "navigationBarTextStyle": "black"
  },
  "tabBar": {
    "color": "#99a1ae",
    "selectedColor": "#b29764",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "/images/icons/home.png",
        "selectedIconPath": "/images/icons/home-active.png"
      },
      {
        "pagePath": "pages/timer/timer",
        "text": "计时",
        "iconPath": "/images/icons/timer.png",
        "selectedIconPath": "/images/icons/timer-active.png"
      },
      {
        "pagePath": "pages/team/team",
        "text": "团队",
        "iconPath": "/images/icons/team.png",
        "selectedIconPath": "/images/icons/team-active.png"
      },
      {
        "pagePath": "pages/me/me",
        "text": "我",
        "iconPath": "/images/icons/me.png",
        "selectedIconPath": "/images/icons/me-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents"
}