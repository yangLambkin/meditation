/* 聊天工具模式页面样式 */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f6f6f6;
  padding: 40rpx;
}

/* 加载状态 */
.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

.loading-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.sub-text {
  font-size: 28rpx;
  color: #666;
}

/* 成功状态 */
.success-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
  background: #52c41a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.success-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.auto-return-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
}

/* 失败状态 */
.error-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  background: #ff4d4f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.error-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 40rpx;
}

/* 确认按钮 */
.confirm-button, .retry-button {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  box-shadow: 0 4rpx 16rpx rgba(24,144,255,0.3);
  text-align: center;
}

.confirm-button:active, .retry-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(24,144,255,0.3);
}

.confirm-text, .retry-text {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}