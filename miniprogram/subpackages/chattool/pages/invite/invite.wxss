/* 聊天工具模式页面样式 */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f6f6f6;
  padding: 40rpx;
}

/* 邀请卡片样式 */
.invite-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  color: white;
  margin-bottom: 60rpx;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.team-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.team-name {
  font-size: 36rpx;
  font-weight: bold;
  flex: 1;
}

.card-content {
  margin-bottom: 30rpx;
}

.invite-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.invite-desc {
  font-size: 28rpx;
  opacity: 0.9;
  line-height: 1.4;
}

.card-footer {
  border-top: 1rpx solid rgba(255,255,255,0.3);
  padding-top: 20rpx;
}

.inviter {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 发送按钮 */
.send-button {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  box-shadow: 0 4rpx 16rpx rgba(24,144,255,0.3);
  width: 100%;
  max-width: 600rpx;
  text-align: center;
}

.send-text {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

.send-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(24,144,255,0.3);
}

/* 加载状态 */
.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

.loading-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}