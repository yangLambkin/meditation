/* subpackages/chattool/pages/login/login.wxss */
.login-container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}

/* 头部标题 */
.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #7f8c8d;
}

/* 头像选择区域 */
.avatar-section {
  text-align: center;
  margin-bottom: 50rpx;
}

.avatar-label {
  font-size: 32rpx;
  color: #2c3e50;
  margin-bottom: 30rpx;
}

.avatar-button {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0 auto 20rpx;
  border: 4rpx solid #e1e8ed;
  background-color: #ffffff;
}

.avatar-button::after {
  border: none;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-hint {
  font-size: 26rpx;
  color: #95a5a6;
}

/* 昵称输入区域 */
.nickname-section {
  margin-bottom: 60rpx;
}

.nickname-label {
  font-size: 32rpx;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.nickname-input {
  background-color: #ffffff;
  border: 2rpx solid #e1e8ed;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.nickname-input:focus {
  border-color: #3498db;
}

.nickname-hint {
  font-size: 24rpx;
  color: #95a5a6;
  min-height: 32rpx;
}

.nickname-hint.valid {
  color: #27ae60;
}

.nickname-hint.invalid {
  color: #e74c3c;
}

/* 操作按钮区域 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 50rpx;
}

.primary-button {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  color: white;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.primary-button:disabled {
  background: #bdc3c7;
  opacity: 0.6;
}

.secondary-button {
  background: transparent;
  color: #7f8c8d;
  border: 2rpx solid #bdc3c7;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
}

.secondary-button::after {
  border: none;
}

/* 提示信息 */
.tip-section {
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  padding: 32rpx;
  border-left: 4rpx solid #3498db;
}

.tip-item {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.tip-item:last-child {
  margin-bottom: 0;
}