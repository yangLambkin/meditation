<!-- 用户切换测试页面 -->
<view class="container">
  <view class="section">
    <text class="title">用户身份切换测试</text>
    
    <!-- 当前用户信息 -->
    <view class="user-info">
      <text class="label">当前用户:</text>
      <text class="value">{{currentUser.nickname || '未登录'}}</text>
      <text class="value">({{currentUser.openid}})</text>
    </view>
    
    <!-- 用户切换按钮 -->
    <view class="user-buttons">
      <button class="user-btn creator" bindtap="switchToCreator">
        切换为创建者
      </button>
      <button class="user-btn member-b" bindtap="switchToUserB">
        切换为用户B
      </button>
      <button class="user-btn member-c" bindtap="switchToUserC">
        切换为用户C
      </button>
    </view>
    
    <!-- 快速跳转链接 -->
    <view class="quick-links">
      <text class="link-title">快速测试:</text>
      <button class="link-btn" bindtap="gotoJoinTeam">
        跳转到团队加入页面
      </button>
      <view class="team-info">
        <text>团队ID: {{teamId}}</text>
        <text>团队名称: {{teamName}}</text>
      </view>
    </view>
  </view>
</view>