/* 用户切换测试页面样式 */
.container {
  padding: 40rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 32rpx;
  display: block;
}

.user-info {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
}

.value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-top: 8rpx;
}

.user-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.user-btn {
  background: #6190e8;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.user-btn::after {
  border: none;
}

.user-btn.creator {
  background: #b29764;
}

.user-btn.member-b {
  background: #34c759;
}

.user-btn.member-c {
  background: #ff9500;
}

.quick-links {
  border-top: 1rpx solid #e0e0e0;
  padding-top: 32rpx;
}

.link-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.link-btn {
  background: #ff6b6b;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.link-btn::after {
  border: none;
}

.team-info {
  background: #e8f4fd;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #666;
}