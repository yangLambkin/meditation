/* 团队加入页面样式 - skyline 版本 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 团队信息卡片 - 采用teamDetails相同样式 */
.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.justify-start {
  justify-content: flex-start;
}

.items-center {
  align-items: center;
}

.items-end {
  align-items: flex-end;
}

.relative {
  position: relative;
}

.self-stretch {
  align-self: stretch;
}

.section {
  background: #b29764;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.group {
  margin: 0;
}

.section_3 {
  padding: 0;
}

.group_2 {
  margin: 0;
}

.group_3 {
  margin-left: 0rpx;
  padding-bottom: 8rpx;
  height: 250rpx;
}

.team-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.font {
  font-size: 28rpx;
  font-family: Arimo;
  line-height: 33.98rpx;
  font-weight: 700;
  color: #ffffff;
}

.text_2 {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 25rpx;
}

.pos_2 {
  text-align: center;
}

.text_3 {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.5;
}

.pos_3 {
  text-align: center;
}

.mt-26 {
  margin-top: 52rpx;
}

.ml-12 {
  margin-left: 24rpx;
}

.mt-4 {
  margin-top: 8rpx;
}

.mt-9 {
  margin-top: 9rpx;
}

.mt-3 {
  margin-top: 6rpx;
}

.mt-20 {
  margin-top: 40rpx;
}

.equal-division {
  padding: 30rpx;
  margin: 0 40rpx;
  justify-content: space-between;
}

.equal-division-item {
  padding: 10rpx 0;
  background-color: #0000001a;
  border-radius: 20rpx;
  height: 120rpx;
  border: solid 2rpx #ffffff1a;
  flex: 1;
  max-width: 200rpx;
}

.section_4 {
  flex: 1 1 100rpx;
}

.image {
  width: 40rpx;
  height: 40rpx;
}

.font_2 {
  font-size: 24rpx;
  font-family: Arimo;
  line-height: 22.08rpx;
  color: #ffffff;
}

.team-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin: 0 auto 24rpx;
}

.team-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 16rpx;
}

.team-description {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.team-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

/* 团队成员列表 */
.members-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.members-list {
  max-height: 400rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #e8f4fd;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-icon {
  font-size: 36rpx;
}

.member-info {
  flex: 1;
}

.member-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-right: 16rpx;
}

.member-role {
  font-size: 22rpx;
  color: #ffffff;
  background: #6190e8;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.member-stats {
  display: flex;
  align-items: center;
}

.checkin-count {
  font-size: 24rpx;
  color: #666666;
  margin-right: 24rpx;
}

.last-active {
  font-size: 24rpx;
  color: #999999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #6190e8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
}

/* 加入按钮 */
.join-button-container {
  padding: 20rpx;
}

.custom-join-button {
  background: #ffffff !important;
  color: #b29764 !important;
  border: none !important;
  border-radius: 12rpx !important;
  padding: 22rpx !important;
  font-size: 32rpx !important;
  font-weight: 500 !important;
  width: 60% !important;
  height: auto !important;
  line-height: normal !important;
  display: block !important;
  margin: 0 auto !important;
}

.custom-join-button::after {
  border: none !important;
}

.joined-status {
  text-align: center;
  padding: 40rpx 20rpx;
}

.joined-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 错误状态 */
.error-container {
  text-align: center;
  padding: 80rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 40rpx;
}

.retry-button {
  background: #6190e8;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

.retry-button::after {
  border: none;
}