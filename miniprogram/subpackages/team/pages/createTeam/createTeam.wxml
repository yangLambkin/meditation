<view class="create-team-page">
  <view class="page-heading">
    <text class="page-title">创建团队</text>
    <text class="page-description">一起觉察，让练习成为日常</text>
  </view>

  <view class="team-form-card">
    <view class="team-form-field">
      <text class="team-form-label">团队头像</text>
      <view class="team-form-avatar-row">
        <image class="team-form-avatar {{!selectedIcon ? 'team-form-avatar-placeholder' : ''}}"
          src="{{teamIcons[0].path}}" mode="{{selectedIcon ? 'aspectFill' : 'aspectFit'}}" />
        <button class="team-form-avatar-button" bindtap="selectTeamIcon" loading="{{isChoosingIcon}}"
          disabled="{{isCreating || isChoosingIcon || hasCreatedTeam}}">
          {{isChoosingIcon ? '上传中…' : selectedIcon ? '更换头像' : '选择头像'}}
        </button>
      </view>
    </view>

    <view class="team-form-field">
      <view class="team-form-label-row">
        <text class="team-form-label">团队名称</text>
        <text class="team-form-count">{{nameCharCount}}/20</text>
      </view>
      <view class="team-form-control">
        <input class="team-form-input" placeholder="填写团队名称" placeholder-class="team-form-placeholder"
          value="{{teamName}}" bindinput="onTeamNameInput" maxlength="20"
          disabled="{{isCreating || hasCreatedTeam}}" />
      </view>
    </view>

    <view class="team-form-field">
      <view class="team-form-label-row">
        <text class="team-form-label">团队介绍 <text class="team-form-optional">选填</text></text>
        <text class="team-form-count">{{descCharCount}}/100</text>
      </view>
      <textarea class="team-form-textarea" placeholder="介绍一下你的团队" placeholder-class="team-form-placeholder"
        value="{{teamDescription}}" bindinput="onTeamDescriptionInput" maxlength="100"
        disabled="{{isCreating || hasCreatedTeam}}" />
    </view>
  </view>

  <view class="team-form-card">
    <view class="team-form-heading team-form-rules-heading">
      <view class="team-form-rules-summary">
        <text class="team-form-title">练习规则</text>
        <text class="team-form-help">{{practiceRulesEnabled ? '每日多次练习累计计算' : '开启后可设置统计日期和每日期望分钟。'}}</text>
      </view>
      <switch class="team-form-rules-switch" checked="{{practiceRulesEnabled}}" bindchange="onPracticeRulesChange"
        color="#b29764" aria-label="启用练习规则" disabled="{{isCreating || hasCreatedTeam}}" />
    </view>
    <view wx:if="{{practiceRulesEnabled}}" class="team-form-rules-content">
      <view class="team-form-field">
        <view class="team-form-label-row">
          <text class="team-form-label">统计起始日期 <text class="team-form-optional">选填</text></text>
          <button wx:if="{{practiceStartDate}}" class="team-form-clear" bindtap="clearPracticeStartDate"
            disabled="{{isCreating || hasCreatedTeam}}">清空</button>
        </view>
        <picker mode="date" value="{{practiceStartDate || maxPracticeStartDate}}" end="{{maxPracticeStartDate}}"
          bindchange="onPracticeStartDateChange" disabled="{{isCreating || hasCreatedTeam}}">
          <view class="team-form-control">
            <text class="{{!practiceStartDate ? 'team-form-placeholder' : ''}}">{{practiceStartDate || '不设置，默认从创建日统计'}}</text>
            <text class="team-form-chevron">›</text>
          </view>
        </picker>
        <text class="team-form-help">全体当前成员从这一天开始统计，不区分加入时间。</text>
      </view>
      <view class="team-form-field">
        <text class="team-form-label">每日期望分钟 <text class="team-form-optional">选填</text></text>
        <view class="team-form-control">
          <input class="team-form-input" type="number" value="{{dailyGoalMinutes}}"
            bindinput="onDailyGoalInput" maxlength="4" placeholder="手动填写分钟数" placeholder-class="team-form-placeholder"
            disabled="{{isCreating || hasCreatedTeam}}" />
          <text class="team-form-unit">分钟 / 天</text>
        </view>
        <text class="team-form-help">可选推荐值，也可输入 1–1440 的整数；留空则不设置。</text>
        <view class="team-form-presets">
          <button class="team-form-preset {{dailyGoalMinutes === '' ? 'selected' : ''}}"
            bindtap="clearDailyGoal" disabled="{{isCreating || hasCreatedTeam}}">不设置</button>
          <button wx:for="{{dailyGoalPresets}}" wx:key="*this"
            class="team-form-preset {{dailyGoalMinutes == item ? 'selected' : ''}}"
            data-minutes="{{item}}" bindtap="selectDailyGoal" disabled="{{isCreating || hasCreatedTeam}}">
            {{item}} 分钟
          </button>
        </view>
      </view>
      <view class="team-form-note">
        <text>练习日为北京时间 02:00 至次日 02:00。</text>
        <text>当日多次练习累计计算；未设置期望分钟时不判断达标。</text>
      </view>
    </view>
  </view>

  <view class="team-form-actions">
    <button class="team-form-submit" bindtap="createTeam" hover-class="team-form-button-hover"
      loading="{{isCreating || isChoosingIcon}}" disabled="{{isCreating || isChoosingIcon}}">
      {{hasCreatedTeam ? '返回团队列表' : isChoosingIcon ? '图标检测中' : isCreating ? '创建中' : '创建团队'}}
    </button>
  </view>
</view>
