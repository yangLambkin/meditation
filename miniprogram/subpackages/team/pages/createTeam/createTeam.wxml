<view class="create-team-page">
  <view class="page-heading">
    <text class="page-title">创建团队</text>
    <text class="page-description">选择功课，邀请伙伴一起坚持</text>
  </view>

  <view class="team-form-card">
    <view class="team-form-field">
      <text class="team-form-label">团队头像</text>
      <view class="team-form-avatar-row">
        <image class="team-form-avatar {{!selectedIcon ? 'team-form-avatar-placeholder' : ''}}"
          src="{{teamIcons[0].path}}" mode="{{selectedIcon ? 'aspectFill' : 'aspectFit'}}" />
        <button class="team-form-avatar-button" bindtap="selectTeamIcon" loading="{{isChoosingIcon}}"
          disabled="{{isCreating || isChoosingIcon || hasCreatedTeam}}">
          {{isChoosingIcon ? '上传中…' : selectedIcon ? '更换头像' : '选择头像'}}
        </button>
      </view>
    </view>

    <view class="team-form-field">
      <view class="team-form-label-row">
        <text class="team-form-label">团队名称</text>
        <text class="team-form-count">{{nameCharCount}}/20</text>
      </view>
      <view class="team-form-control">
        <input class="team-form-input" placeholder="填写团队名称" placeholder-class="team-form-placeholder"
          value="{{teamName}}" bindinput="onTeamNameInput" maxlength="20"
          disabled="{{isCreating || hasCreatedTeam}}" />
      </view>
    </view>

    <view class="team-form-field">
      <view class="team-form-label-row">
        <text class="team-form-label">团队介绍 <text class="team-form-optional">选填</text></text>
        <text class="team-form-count">{{descCharCount}}/100</text>
      </view>
      <textarea class="team-form-textarea" placeholder="介绍一下你的团队" placeholder-class="team-form-placeholder"
        value="{{teamDescription}}" bindinput="onTeamDescriptionInput" maxlength="100"
        disabled="{{isCreating || hasCreatedTeam}}" />
    </view>
  </view>

  <view class="team-form-card">
    <view class="team-form-label-row">
      <text class="team-form-title">选择功课</text>
      <text class="team-form-selection-count">已选 {{selectedPracticeCards.length}} / 6</text>
    </view>
    <text class="team-form-help">至少选择一项，可同时选择多项，共用团队成员。</text>
    <view class="team-form-practice-grid">
      <button wx:for="{{practiceSelectionOptions}}" wx:key="type" class="team-form-practice-option {{item.selected ? 'selected' : ''}}"
        data-type="{{item.type}}" bindtap="toggleCreatePractice" hover-class="team-form-button-hover"
        aria-label="{{item.name}}，{{item.selected ? '已选择，点击取消' : '未选择，点击选择'}}" disabled="{{isCreating || hasCreatedTeam}}">
        <text class="team-form-checkbox {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</text>
        <text class="team-form-option-name">{{item.name}}</text>
      </button>
    </view>
  </view>

  <view class="team-form-card">
    <text class="team-form-title">功课规则</text>
    <text class="team-form-help">每项分别设置，点击功课展开。未设置目标时只记录练习情况。</text>
    <view class="team-form-rule-list">
      <view wx:for="{{selectedPracticeCards}}" wx:key="practiceType" id="create-practice-{{item.practiceType}}" class="team-form-rule-item {{expandedPracticeType === item.practiceType ? 'expanded' : ''}}">
        <button class="team-form-rule-toggle" data-type="{{item.practiceType}}" bindtap="expandCreatePractice"
          hover-class="team-form-button-hover" aria-label="设置{{item.name}}规则" disabled="{{isCreating || hasCreatedTeam}}">
          <view class="team-form-rule-identity"><text class="team-form-label">{{item.name}}</text><text class="team-form-rule-summary">{{item.summary}}</text></view>
          <text class="team-form-rule-action">{{expandedPracticeType === item.practiceType ? '编辑中' : '设置 ›'}}</text>
        </button>
        <view wx:if="{{expandedPracticeType === item.practiceType}}" class="team-form-rule-editor">
          <view class="team-form-heading team-form-rules-heading">
            <view class="team-form-rules-summary"><text class="team-form-label">设置练习规则</text><text class="team-form-help">起始日期和每日目标均可不设。</text></view>
            <switch class="team-form-rules-switch" checked="{{practiceEditor.rulesEnabled}}" data-type="{{item.practiceType}}" data-field="rulesEnabled"
              bindchange="changeCreatePracticeRule" color="#b29764" aria-label="启用{{item.name}}练习规则" disabled="{{isCreating || hasCreatedTeam}}" />
          </view>
          <view wx:if="{{practiceEditor.rulesEnabled}}" class="team-form-rules-content">
            <view class="team-form-field">
              <view class="team-form-label-row">
                <text class="team-form-label">统计起始日期 <text class="team-form-optional">选填</text></text>
                <button wx:if="{{practiceEditor.practiceStartDate}}" class="team-form-clear" data-type="{{item.practiceType}}" data-field="practiceStartDate"
                  bindtap="clearCreatePracticeRule" disabled="{{isCreating || hasCreatedTeam}}">清空</button>
              </view>
              <picker mode="date" value="{{practiceEditor.practiceStartDate || maxPracticeStartDate}}" end="{{maxPracticeStartDate}}"
                data-type="{{item.practiceType}}" data-field="practiceStartDate" bindchange="changeCreatePracticeRule" disabled="{{isCreating || hasCreatedTeam}}">
                <view class="team-form-control"><text class="{{!practiceEditor.practiceStartDate ? 'team-form-placeholder' : ''}}">{{practiceEditor.practiceStartDate || '不设置，默认从创建日统计'}}</text><text class="team-form-chevron">›</text></view>
              </picker>
            </view>
            <view class="team-form-field">
              <text class="team-form-label">每日目标 <text class="team-form-optional">选填</text></text>
              <view class="team-form-control">
                <input class="team-form-input" type="number" value="{{practiceEditor.dailyGoalMinutes}}" maxlength="7"
                  data-type="{{item.practiceType}}" data-field="dailyGoalMinutes" bindinput="changeCreatePracticeRule"
                  placeholder="手动填写目标" placeholder-class="team-form-placeholder" disabled="{{isCreating || hasCreatedTeam}}" />
                <text class="team-form-unit">{{practiceEditor.unit}} / 天</text>
              </view>
              <text class="team-form-help">可输入 1–{{practiceEditor.maxGoal}} 的整数；留空则不设置。</text>
              <view class="team-form-presets">
                <button class="team-form-preset {{practiceEditor.dailyGoalMinutes === '' ? 'selected' : ''}}" data-type="{{item.practiceType}}" data-field="dailyGoalMinutes" bindtap="clearCreatePracticeRule" disabled="{{isCreating || hasCreatedTeam}}">不设置</button>
                <button wx:for="{{practiceEditor.presets}}" wx:for-item="goal" wx:key="*this" class="team-form-preset {{practiceEditor.dailyGoalMinutes == goal ? 'selected' : ''}}"
                  data-type="{{item.practiceType}}" data-goal="{{goal}}" bindtap="chooseCreatePracticeGoal" disabled="{{isCreating || hasCreatedTeam}}">{{goal}} {{practiceEditor.unit}}</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="team-form-note"><text>练习日为北京时间 02:00 至次日 02:00；当日多次练习累计计算。</text></view>
  </view>

  <view class="team-form-actions">
    <button class="team-form-submit" bindtap="createTeam" hover-class="team-form-button-hover"
      loading="{{isCreating || isChoosingIcon}}" disabled="{{isCreating || isChoosingIcon}}">
      {{hasCreatedTeam ? '返回团队列表' : isChoosingIcon ? '图标检测中' : isCreating ? '创建中' : '创建团队'}}
    </button>
  </view>
</view>
