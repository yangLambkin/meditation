page {
  background-color: #f8fafc;
}

.create-team-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  color: #354152;
}

.page-heading {
  padding: 8rpx 4rpx 28rpx;
}

.page-title {
  display: block;
  color: #1d293d;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.page-description {
  display: block;
  margin-top: 12rpx;
  color: #697282;
  font-size: 26rpx;
  line-height: 1.5;
}

.form-card {
  padding: 28rpx;
  border: 2rpx solid #f2f4f6;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.form-field + .form-field {
  margin-top: 32rpx;
}

.field-heading,
.practice-rules-heading,
.practice-rule-row,
.practice-date-field,
.practice-date-value,
.practice-goal-field,
.practice-goal-presets {
  display: flex;
  align-items: center;
}

.field-heading,
.practice-rules-heading,
.practice-rule-row {
  justify-content: space-between;
}

.field-label {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

.field-count {
  color: #99a1ae;
  font-size: 23rpx;
}

.team-icons-container {
  margin-top: 20rpx;
}

.team-icons-row {
  display: flex;
  gap: 8rpx;
}

.team-icons-row + .team-icons-row {
  margin-top: 12rpx;
}

.team-icon-item {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background-color: #f8fafc;
}

.team-icon-item.selected {
  border-color: #b29764;
  background-color: #f7f3eb;
}

.icon-image {
  display: block;
  width: 64rpx;
  height: 64rpx;
  max-width: 100%;
  border-radius: 12rpx;
}

.input-field,
.textarea-field {
  box-sizing: border-box;
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #edf0f3;
  border-radius: 12rpx;
  background-color: #f8fafc;
  color: #354152;
  font-size: 28rpx;
  line-height: 1.6;
}

.input-field {
  height: 88rpx;
}

.textarea-field {
  min-height: 168rpx;
}

.field-placeholder {
  color: #99a1ae;
}

.practice-rules {
  margin-top: 20rpx;
}

.practice-rules-heading {
  margin-bottom: 16rpx;
}

.practice-rules-title {
  color: #354152;
  font-size: 30rpx;
  font-weight: 600;
}

.practice-rules-badge {
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background-color: #f7f3eb;
  color: #b29764;
  font-size: 22rpx;
}

.practice-rule-row {
  min-height: 96rpx;
}

.practice-rule-label {
  color: #697282;
  font-size: 27rpx;
}

.practice-date-value {
  padding: 16rpx 0 16rpx 12rpx;
  color: #b29764;
  font-size: 27rpx;
  white-space: nowrap;
}

.practice-rule-placeholder {
  color: #99a1ae;
}

.practice-date-clear {
  margin: 0 0 0 12rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background-color: #f8fafc;
  color: #697282;
  font-size: 23rpx;
  line-height: 1.5;
}

.practice-date-arrow {
  margin-left: 12rpx;
  color: #99a1ae;
  font-size: 36rpx;
}

.practice-goal-row {
  border-top: 2rpx solid #f2f4f6;
}

.practice-goal-field {
  padding: 8rpx 16rpx;
  border: 2rpx solid #edf0f3;
  border-radius: 12rpx;
  background-color: #f8fafc;
}

.practice-goal-input {
  width: 98rpx;
  height: 48rpx;
  color: #354152;
  font-size: 30rpx;
  text-align: right;
}

.practice-goal-unit {
  margin-left: 12rpx;
  color: #697282;
  font-size: 25rpx;
}

.practice-goal-presets {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 8rpx 0 24rpx;
}

.practice-goal-preset {
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid #edf0f3;
  border-radius: 12rpx;
  background-color: #f8fafc;
  color: #697282;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.practice-goal-preset.selected {
  border-color: #b29764;
  background-color: #f7f3eb;
  color: #b29764;
}

.practice-rules-note {
  display: block;
  color: #99a1ae;
  font-size: 23rpx;
  line-height: 1.65;
}

.create-action {
  margin-top: 28rpx;
}

.create-button {
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background-color: #b29764;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.create-button::after,
.practice-date-clear::after,
.practice-goal-preset::after {
  border: none;
}

.create-button[disabled] {
  background-color: #b29764;
  color: #ffffff;
  opacity: 0.5;
}

.team-icon-item.disabled,
.practice-date-clear[disabled],
.practice-goal-preset[disabled] {
  opacity: 0.5;
}

.button-hover {
  opacity: 0.85;
}
