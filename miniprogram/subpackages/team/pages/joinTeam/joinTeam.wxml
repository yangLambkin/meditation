<!--subpackages/team/pages/joinTeam/joinTeam.wxml-->
<view class="flex-col justify-center items-center page">
  <!-- 团队信息 -->
  <view class="flex-col justify-center items-center team-info" wx:if="{{teamInfo}}">
    <image class="team-icon" src="{{teamInfo.icon}}" mode="aspectFit" />
    <text class="team-name">{{teamInfo.name}}</text>
    <text class="team-description">{{teamInfo.description || '暂无团队介绍'}}</text>
    <text class="team-creator">创建者：{{teamInfo.creatorName || '未知'}}</text>
  </view>

  <!-- 加入按钮 -->
  <view class="join-button-container">
    <button class="join-button" bindtap="joinTeam" wx:if="{{!isMember}}">
      加入团队
    </button>
    <view class="joined-status" wx:if="{{isMember}}">
      <text class="joined-text">您已是团队成员</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{!isLoading && !teamInfo}}">
    <text class="error-text">团队信息加载失败</text>
  </view>
</view>