/* subpackages/team/pages/joinTeam/joinTeam.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  padding: 60rpx 40rpx;
}

.team-info {
  margin-bottom: 80rpx;
}

.team-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  object-fit: cover;
  margin-bottom: 40rpx;
}

.team-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #1d293d;
  margin-bottom: 20rpx;
  text-align: center;
}

.team-description {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 20rpx;
  line-height: 1.5;
  max-width: 500rpx;
}

.team-creator {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.join-button-container {
  margin-top: 40rpx;
}

.join-button {
  width: 400rpx;
  height: 80rpx;
  background: linear-gradient(180deg, #b29764 0%, #c9a870 100%);
  border: none;
  border-radius: 40rpx;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0rpx 8rpx 16rpx rgba(178, 151, 100, 0.3);
}

.join-button:active {
  transform: scale(0.98);
}

.joined-status {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f5e8;
  border: 2rpx solid #4caf50;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  width: 400rpx;
}

.joined-text {
  color: #4caf50;
  font-size: 28rpx;
  font-weight: bold;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

.error-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
}

.error-text {
  color: #ff4d4f;
  font-size: 28rpx;
}