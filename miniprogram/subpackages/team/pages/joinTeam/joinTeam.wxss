page {
  background-color: #f8fafc;
}

.join-team-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 260rpx;
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  color: #354152;
}

.team-header,
.members-section {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #f2f4f6;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.team-info {
  display: flex;
  align-items: flex-start;
}

.team-icon {
  width: 104rpx;
  height: 104rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  background-color: #f8fafc;
}

.team-details {
  flex: 1;
  min-width: 0;
}

.team-name {
  display: block;
  color: #1d293d;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.team-description {
  display: block;
  margin-top: 12rpx;
  color: #697282;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.team-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.stat-item {
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background-color: #f8fafc;
  color: #697282;
  font-size: 23rpx;
  line-height: 1.5;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #f2f4f6;
  border-top-color: #b29764;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #99a1ae;
  font-size: 26rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.section-title {
  color: #354152;
  font-size: 30rpx;
  font-weight: 600;
}

.member-count {
  color: #99a1ae;
  font-size: 24rpx;
}

.empty-members {
  padding: 60rpx 20rpx;
  color: #99a1ae;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
}

.retry-button {
  display: inline-block;
  margin: 24rpx auto 0;
  padding: 0 32rpx;
  border-radius: 12rpx;
  background-color: #f7f3eb;
  color: #b29764;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 68rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f2f4f6;
}

.member-item:last-child {
  padding-bottom: 4rpx;
  border-bottom: none;
}

.member-avatar {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background-color: #f8fafc;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  display: block;
  overflow: hidden;
  color: #354152;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  display: block;
  margin-top: 4rpx;
  color: #697282;
  font-size: 24rpx;
  line-height: 1.5;
}

.member-stats {
  display: block;
  margin-top: 4rpx;
  color: #99a1ae;
  font-size: 23rpx;
}

.action-section {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 24rpx 28rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f2f4f6;
  background-color: #ffffff;
}

.join-tip,
.member-tip {
  display: block;
  color: #697282;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.member-tip {
  margin-bottom: 20rpx;
}

.join-btn,
.view-details-btn {
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background-color: #b29764;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.join-btn::after,
.view-details-btn::after,
.retry-button::after {
  border: none;
}

.join-btn[disabled] {
  background-color: #b29764;
  color: #ffffff;
  opacity: 0.5;
}

.btn-hover {
  opacity: 0.85;
}
