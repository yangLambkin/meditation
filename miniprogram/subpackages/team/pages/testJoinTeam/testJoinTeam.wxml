<!-- JoinTeam页面测试 -->
<view class="test-container">
  
  <!-- 页面标题 -->
  <view class="header">
    <text class="title">JoinTeam页面测试</text>
    <text class="subtitle">测试登录和未登录状态下的加入流程</text>
  </view>

  <!-- 当前用户状态 -->
  <view class="status-section">
    <view class="status-card">
      <text class="status-label">当前用户状态:</text>
      <view class="status-info">
        <text class="status-badge {{currentUserStatus}}">
          {{currentUserStatus === 'logged_in' ? '✅ 已登录' : 
            currentUserStatus === 'logged_out' ? '❌ 未登录' : '❓ 未知状态'}}
        </text>
        <text class="user-info">{{currentUserInfo.nickname}} ({{currentUserInfo.openid}})</text>
      </view>
    </view>
  </view>

  <!-- 用户状态切换 -->
  <view class="switch-section">
    <text class="section-title">用户状态切换</text>
    <view class="switch-buttons">
      <button class="switch-btn logged-in" bindtap="switchToLoggedIn">
        🔑 切换到登录状态
      </button>
      <button class="switch-btn logged-out" bindtap="switchToLoggedOut">
        🚪 切换到未登录状态
      </button>
    </view>
  </view>

  <!-- 测试场景 -->
  <view class="scenarios-section">
    <text class="section-title">测试场景</text>
    
    <!-- 场景1：用户已登录 -->
    <view class="scenario-card">
      <text class="scenario-title">场景1：用户已登录</text>
      <text class="scenario-desc">用户已登录状态下进入JoinTeam页面，直接点击"加入团队"</text>
      <button class="scenario-btn scenario1" bindtap="testScenario1LoggedIn">
        🚀 开始测试场景1
      </button>
    </view>

    <!-- 场景2：用户未登录 -->
    <view class="scenario-card">
      <text class="scenario-title">场景2：用户未登录</text>
      <text class="scenario-desc">用户未登录状态下进入JoinTeam页面，点击"加入团队"后跳转登录</text>
      <button class="scenario-btn scenario2" bindtap="testScenario2LoggedOut">
        🚀 开始测试场景2
      </button>
    </view>

    <!-- 场景3：完整流程 -->
    <view class="scenario-card">
      <text class="scenario-title">场景3：完整流程测试</text>
      <text class="scenario-desc">完整流程：未登录 → JoinTeam页面 → 登录 → 自动加入团队 → 团队详情页</text>
      <button class="scenario-btn scenario3" bindtap="testScenario3FullFlow">
        🎯 开始完整流程测试
      </button>
    </view>
  </view>

  <!-- 手动操作 -->
  <view class="manual-section">
    <text class="section-title">手动操作</text>
    <view class="manual-buttons">
      <button class="manual-btn" bindtap="gotoJoinTeam">
        📱 直接进入JoinTeam页面
      </button>
      <button class="manual-btn" bindtap="gotoTeamDetails">
        🏢 跳转到团队详情页
      </button>
    </view>
  </view>

  <!-- 测试结果 -->
  <view class="results-section">
    <view class="results-header">
      <text class="section-title">测试记录</text>
      <view class="results-actions">
        <button class="action-btn verify" bindtap="verifyTestResults">
          🔍 验证结果
        </button>
        <button class="action-btn clear" bindtap="clearTestResults">
          🗑️ 清除记录
        </button>
      </view>
    </view>
    
    <scroll-view class="results-list" scroll-y="true">
      <view wx:if="{{testResults.length === 0}}" class="empty-results">
        <text>暂无测试记录</text>
      </view>
      
      <view wx:for="{{testResults}}" wx:key="id" class="result-item">
        <view class="result-header">
          <text class="result-title">{{item.title}}</text>
          <text class="result-time">{{item.timestamp}}</text>
        </view>
        <text class="result-desc">{{item.description}}</text>
      </view>
    </scroll-view>
  </view>

</view>