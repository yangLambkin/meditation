page { background: #f8fafc; color: #354152; }
.history-details-page { min-height: 100vh; padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
button { margin: 0; font-weight: 400; }
button::after { border: none; }
.overview-card, .date-card { background: #ffffff; border-radius: 24rpx; }
.overview-card { padding: 28rpx; }
.overview-heading, .date-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12rpx 20rpx; }
.page-title { font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.day-count { color: #b29764; font-size: 36rpx; font-weight: 500; overflow-wrap: anywhere; }
.day-count text { font-size: 22rpx; font-weight: 400; }
.month-navigation { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; }
.month-navigation .month-arrow { flex: none; width: 64rpx; min-width: 0; height: 64rpx; min-height: 0; padding: 0; font-size: 40rpx; line-height: 58rpx; color: #a68a57; background: #b2976410; border-radius: 14rpx; }
.month-navigation .month-arrow[disabled] { color: #cbd0d8; background: #f8fafc; }
.month-picker { flex: 1; min-width: 0; }
.month-picker-label { display: flex; align-items: center; justify-content: center; gap: 12rpx; padding: 12rpx 8rpx; color: #354152; font-size: 29rpx; font-weight: 500; line-height: 1.5; }
.month-picker-label text { overflow-wrap: anywhere; }
.month-picker-chevron { flex: none; color: #99a1ae; font-size: 26rpx; }
.overview-card .current-month-button { width: auto; min-height: 0; padding: 8rpx 20rpx; margin: 8rpx auto 0; color: #a68a57; background: transparent; font-size: 23rpx; line-height: 1.5; }
.range-label { display: block; margin-top: 18rpx; color: #697282; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.member-scope { display: block; margin-top: 16rpx; color: #a68a57; font-size: 25rpx; line-height: 1.6; word-break: break-all; overflow-wrap: anywhere; }
.rule-label { display: block; margin-top: 10rpx; color: #99a1ae; font-size: 22rpx; line-height: 1.7; }
.filter-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin: 28rpx 0 20rpx; }
.filter-row .filter-chip { flex: none; width: auto; min-height: 0; padding: 12rpx 24rpx; border: 2rpx solid transparent; border-radius: 12rpx; font-size: 24rpx; line-height: 1.5; color: #7a8493; background: #f2f4f6; }
.filter-row .filter-chip.active { color: #a68a57; background: #b2976414; border-color: #b2976433; }
.list-note { display: block; margin: 0 3rpx 24rpx; color: #99a1ae; font-size: 22rpx; line-height: 1.7; }
.date-group { margin-top: 24rpx; }
.date-heading { margin: 0 4rpx 16rpx; }
.date-title { font-size: 26rpx; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.date-count { color: #99a1ae; font-size: 22rpx; line-height: 1.5; }
.date-card { overflow: hidden; }
.member-row { display: flex; align-items: flex-start; gap: 18rpx; padding: 26rpx 24rpx; }
.member-row + .member-row { border-top: 2rpx solid #f2f4f6; }
.member-row-pressed { background: #f6f3ed; }
.member-avatar { flex: none; width: 76rpx; height: 76rpx; border-radius: 50%; background: #f2f4f6; }
.member-content { flex: 1; min-width: 0; }
.member-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 10rpx; }
.member-name { max-width: 100%; font-size: 28rpx; font-weight: 500; line-height: 1.5; white-space: normal; word-break: break-all; overflow-wrap: anywhere; }
.creator-tag { flex: none; white-space: nowrap; padding: 2rpx 8rpx; color: #a68a57; background: #b2976414; font-size: 20rpx; line-height: 1.5; border-radius: 6rpx; }
.member-status-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx 16rpx; margin-top: 12rpx; }
.status-badge { flex: none; padding: 6rpx 10rpx; border-radius: 8rpx; font-size: 21rpx; line-height: 1.5; }
.status-not_practiced { color: #7a8493; background: #f3f4f6; }
.status-below_goal { color: #a68a57; background: #b2976414; }
.status-qualified, .status-practiced { color: #52a277; background: #edf7f0; }
.minutes-label { max-width: 100%; color: #697282; font-size: 26rpx; line-height: 1.5; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.minutes-unit { color: #99a1ae; font-size: 22rpx; }
.remaining-label { display: block; margin-top: 10rpx; color: #a68a57; font-size: 22rpx; line-height: 1.6; overflow-wrap: anywhere; }
.row-chevron { align-self: center; flex: none; color: #a9b0ba; font-size: 34rpx; line-height: 1; }
.state-panel { display: flex; flex-direction: column; align-items: center; padding: 88rpx 30rpx; text-align: center; }
.state-title { display: block; font-size: 28rpx; color: #697282; line-height: 1.6; }
.state-description { display: block; color: #99a1ae; font-size: 24rpx; line-height: 1.8; margin-top: 14rpx; word-break: break-all; }
.empty-mark { color: #b29764; font-size: 62rpx; font-weight: 300; margin-bottom: 24rpx; }
.loading-dot { width: 34rpx; height: 34rpx; margin-bottom: 28rpx; border: 4rpx solid #edf0f3; border-top-color: #b29764; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.secondary-button { margin: 24rpx auto 0; width: auto; padding: 0 38rpx; line-height: 72rpx; font-size: 25rpx; border: 1rpx solid #edf0f3; border-radius: 36rpx; background: transparent; color: #a68a57; }
.pagination { display: flex; flex-direction: column; align-items: center; padding: 12rpx 12rpx 20rpx; text-align: center; }
.pagination-note { display: block; margin-top: 24rpx; font-size: 22rpx; line-height: 1.7; color: #99a1ae; overflow-wrap: anywhere; }
@media (max-width: 360px) { .member-row { padding: 24rpx 20rpx; gap: 14rpx; } .filter-row .filter-chip { padding: 12rpx 20rpx; } }
