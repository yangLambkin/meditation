<!--subpackages/team/pages/teamDetails/teamDetails.wxml-->
<view class="flex-col justify-start page">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <text class="loading-text">加载中...</text>
  </view>
  
  <!-- 空间信息 -->
  <view class="flex-col justify-start section" wx:if="{{!isLoading && teamInfo}}">
    <view class="flex-col group">
      <view class="flex-col section_3">
        <!-- 返回首页按钮 -->
        <view class="back-home-container">
          <view class="back-home-btn" bindtap="goToHomePage">
            <image class="home-icon" src="/images/icons/home.png" mode="aspectFit" />
            <text class="back-home-text">首页</text>
          </view>
        </view>
        
        <view class="flex-col self-stretch group_2">
          <view class="flex-col justify-start items-end relative group_3">
            <!-- 空间图标 -->
            <image class="team-icon" src="{{teamInfo.icon}}" mode="aspectFit" />
            <!-- 空间名称 -->
            <text class="font text_2 pos_2">{{teamInfo.name}}</text>
            <!-- 空间描述 -->
            <text class="text_3 pos_3">{{teamInfo.description || '暂无空间介绍'}}</text>
          </view>
          <!-- 空间统计信息 -->
          <view class="mt-26 flex-row equal-division">
            <view class="flex-col items-center section_4 equal-division-item">
              <image
                class="image"
                src="/subpackages/team/images/icons/team.png"
              />
              <text class="mt-4 font mt-9">{{members.length}}人</text>
              <text class="mt-4 font_2 mt-9">成员</text>
            </view>
            <view class="ml-12 flex-col items-center section_4 equal-division-item">
              <image
                class="image"
                src="/subpackages/team/images/icons/totalCheckin.png"
              />
              <text class="font mt-3 mt-9">{{teamTotalCheckins}}</text>
              <text class="font_2 mt-3 mt-9">总打卡</text>
            </view>
            <view class="ml-12 flex-col items-center section_4 equal-division-item">
              <image
                class="image"
                src="/subpackages/team/images/icons/activity.png"
              />
              <text class="font mt-3">{{teamActivityRate}}%</text>
              <text class="font_2 mt-3">活跃度</text>
            </view>
          </view>
          
          <!-- 功能按钮区域 -->
          <view class="flex-col justify-center items-center mt-20 button-group">
            <view class="flex-row justify-center items-center">
              <!-- 邀请成员按钮（仅从"我加入的空间"页面进入时可见） -->
              <button class="flex-row justify-center items-center button-item" open-type="share" wx:if="{{fromTab === 'created'}}">
                <image
                  class="image_2"
                  src="/subpackages/team/images/icons/invite.png"
                />
                <text class="font_3 text_4 ml-9">邀请成员</text>
              </button>
              <!-- 解散空间按钮（仅创建者可见，且从"我加入的空间"页面进入） -->
              <view class="flex-row justify-center items-center button-item" wx:if="{{isCreator && fromTab === 'created'}}" bindtap="confirmDeleteTeam">
                <image
                  class="image_2"
                  src="/subpackages/team/images/icons/delete.png"
                />
                <text class="font_3 text-danger ml-9">解散空间</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 标签页切换 -->
      <view class="tab-container">
        <view 
          class="tab-item {{currentTab === 'members' ? 'active' : ''}}" 
          bindtap="switchTab" 
          data-tab="members"
        >
          <text class="tab-text">空间成员</text>
          <view class="tab-indicator"></view>
        </view>
        <view 
          class="tab-item {{currentTab === 'activities' ? 'active' : ''}}" 
          bindtap="switchTab" 
          data-tab="activities"
        >
          <text class="tab-text">练习动态</text>
          <view class="tab-indicator"></view>
        </view>
      </view>

      <!-- 空间成员列表 -->
      <view class="flex-col relative group_4" wx:if="{{currentTab === 'members'}}">
        
        <view class="flex-col list">
          <view
            class="flex-row items-center mt-12 list-item"
            wx:for="{{members}}"
            wx:for-item="member"
            wx:for-index="index"
            wx:key="id"
          >
            <image class="member-avatar" src="{{member.avatar}}" mode="aspectFill" />
            <view class="ml-12 flex-col flex-1">
              <view class="flex-row items-center">
                <view class="flex-col justify-start items-left text-wrapper_4">
                  <text class="font_5 text_8">{{member.name}}</text>
                </view>
                <view class="ml-8 flex-col justify-start items-center text-wrapper_5" wx:if="{{member.role === '团长'}}">
                  <text class="text_9 leader-tag">{{member.role}}</text>
                </view>
              </view>
              <view class="flex-row items-center mt-5">
                <image
                  class="image_3"
                  src="/subpackages/team/images/icons/checkin.png"
                />
                <text class="text_9 ml-4">打卡 {{member.checkInCount}} 次</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 练习动态 -->
      <view class="flex-col relative group_4" wx:if="{{currentTab === 'activities'}}">
          <view class="flex-col justify-start items-start text-wrapper_2">
            <text class="font_4 text_7">本周练习动态</text>
          </view>
        <view class="flex-col list">
          <!-- 加载状态 -->
          <view class="loading-state" wx:if="{{activitiesLoading}}">
            <view class="loading-spinner"></view>
            <text class="loading-text">加载中...</text>
          </view>
          
          <!-- 错误状态 -->
          <view class="error-state" wx:if="{{activitiesError}}">
            <image class="error-icon" src="/images/icons/error.png" />
            <text class="error-text">加载失败，请重试</text>
            <button class="retry-btn" bindtap="loadActivitiesData">重新加载</button>
          </view>
          
          <!-- 正常内容 -->
          <view wx:if="{{!activitiesLoading && !activitiesError}}">
            <view 
              class="flex-col mt-12 activity-item" 
              wx:for="{{activities}}" 
              wx:for-item="activity" 
              wx:for-index="index" 
              wx:key="id"
            >
              <view class="flex-row items-center">
                <!-- 成员头像 -->
                <image class="member-avatar" src="{{activity.avatar}}" mode="aspectFill" />
                <view class="ml-12 flex-col flex-1">
                  <view class="flex-row items-center">
                    <view class="flex-col justify-start items-left text-wrapper_4">
                      <text class="font_5 text_8">{{activity.memberName}}</text>
                    </view>
                    <view class="ml-8 flex-col justify-start items-center text-wrapper_5">
                      <text class="font_7 text_10">{{activity.duration}}</text>
                    </view>
                  </view>
                  <view class="flex-col mt-5">
                    <view class="flex-row items-center mt-4">
                      <image
                        class="image_3"
                        src="/subpackages/team/images/icons/time.png"
                      />
                      <text class="text_9 ml-4">{{activity.originalTime || activity.dateTime || activity.time || formatTime(activity.timestamp)}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
            
            <!-- 空状态 -->
            <view class="empty-state" wx:if="{{activities.length === 0}}">
              <text class="empty-text">暂无练习动态</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{!isLoading && !teamInfo}}">
    <text class="error-text">空间信息加载失败</text>
  </view>
</view>