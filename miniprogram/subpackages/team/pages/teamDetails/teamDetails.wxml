<view class="team-page">
  <view wx:if="{{teamInfo}}" class="team-content">
    <view class="team-overview">
      <view class="team-identity">
        <image class="team-icon" src="{{teamInfo.icon || '/images/icons/team.png'}}" mode="aspectFill" />
        <view class="team-name-row">
          <text class="team-name">{{teamInfo.name}}</text>
          <button wx:if="{{isCreator}}" class="hero-edit" size="mini" bindtap="openSettings">编辑</button>
        </view>
        <text class="team-description">{{teamInfo.description || ''}}</text>
      </view>
      <view class="team-stats">
        <view class="team-stat"><text class="team-stat-value">{{teamMembers.length}}</text><text class="team-stat-label">团队成员</text></view>
        <view class="team-stat"><text class="team-stat-value">{{overview ? overview.totalPracticeCount : '—'}}</text><text class="team-stat-label">累计练习</text></view>
        <view class="team-stat"><text class="team-stat-value">{{overview ? overview.activityRate + '%' : '—'}}</text><text class="team-stat-label">今日活跃度</text></view>
      </view>
      <view wx:if="{{isCreator}}" class="hero-actions">
        <button class="invite-button" bindtap="prepareInvite" loading="{{isPreparingInvite}}" disabled="{{isPreparingInvite || isSaving || isDeleting}}">{{isPreparingInvite ? '准备中…' : '邀请成员'}}</button>
        <button class="hero-dissolve" bindtap="confirmDeleteTeam" disabled="{{isSaving || isDeleting}}">解散团队</button>
      </view>
      <text wx:if="{{isCreator && inviteError}}" class="invite-note invite-error">{{inviteError}}</text>
    </view>

    <view class="main-tabs">
      <view class="main-tab {{currentTab === 'members' ? 'active' : ''}}" data-tab="members" bindtap="switchTab">团队成员</view>
      <view class="main-tab {{currentTab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="switchTab">查看记录</view>
    </view>

    <view wx:if="{{currentTab === 'members'}}" class="members-view">
      <view class="section-heading"><view><text class="section-title">一起练习的伙伴</text><text wx:if="{{isCreator}}" class="section-caption">长按成员可移除</text></view><text class="member-total">{{teamMembers.length}} 位成员</text></view>
      <view class="roster-card" wx:for="{{teamMembers}}" wx:key="openid" data-member-openid="{{item.openid}}" data-view="month" bindtap="openMemberRecords" catchlongpress="confirmRemoveMember" hover-class="member-card-pressed" aria-role="button" aria-label="查看{{item.nickname}}的练习记录{{isCreator && !item.isCreator ? '，长按可移除成员' : ''}}">
        <image class="member-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="member-identity">
          <view class="member-name-row"><text class="member-name">{{item.nickname}}</text><text wx:if="{{item.isCreator}}" class="creator-tag">团长</text></view>
          <text wx:if="{{report && item.totalPracticeCount !== undefined}}" class="member-subtitle">练习 {{item.totalPracticeCount}} 次 · {{item.cumulativeMinutesLabel}} 分钟</text>
          <text wx:if="{{report}}" class="member-last-practice">{{item.lastPracticeLabel ? '最近练习 · ' + item.lastPracticeLabel : (item.totalPracticeCount === 0 ? '还没有练习记录' : '')}}</text>
          <text wx:if="{{removingMemberId === item.openid}}" class="member-remove-status">正在移除…</text>
        </view>
        <text class="member-card-chevron" aria-hidden="true">›</text>
      </view>
      <view wx:if="{{isLoading}}" class="member-load-note">正在同步成员练习数据…</view>
      <view wx:elif="{{reportError}}" class="member-load-note"><text>成员已加载，练习数据暂不可用</text><button class="text-button" bindtap="loadTeamData">重新加载</button></view>
      <text wx:elif="{{report}}" class="page-footnote">练习次数与时长从 {{report.settings.effectivePracticeStartDate || report.settings.practiceStartDate}} 起统计</text>
    </view>

    <block wx:if="{{currentTab === 'records'}}">
      <view class="record-toolbar"><view class="record-tabs"><view class="record-tab {{recordTab === 'today' ? 'active' : ''}}" data-tab="today" bindtap="switchRecordTab">今日练习</view><view class="record-tab {{recordTab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchRecordTab">历史统计</view></view><text class="record-rules" bindtap="openSettings">{{hasGoal ? '期望 ' + teamInfo.dailyGoalMinutes + ' 分钟 / 天' : '未设置期望分钟'}} ›</text></view>
    <view wx:if="{{isLoading}}" class="state-panel">
      <view class="loading-dot"></view>
      <text class="state-title">正在同步练习数据</text>
      <text class="state-description">请稍候</text>
    </view>
    <view wx:elif="{{reportError}}" class="state-panel error-panel">
      <text class="state-symbol">↻</text>
      <text class="state-title">暂时无法获取练习数据</text>
      <text class="state-description">{{reportError}}</text>
      <button class="secondary-button" bindtap="loadTeamData">重新加载</button>
    </view>

    <block wx:elif="{{report}}">
      <view wx:if="{{recordTab === 'today'}}" class="today-view">
        <view class="section-heading">
          <view>
            <text class="section-title">{{dayLabel}}<text class="date-caption"> · 练习日</text></text>
            <text class="section-caption">02:00 — 次日 02:00 · 当日多次练习累计计算</text>
          </view>
          <text class="member-total">{{report.summary.memberCount}} 位成员</text>
        </view>

        <view class="today-summary">
          <view class="summary-item {{todayFilter === 'not_practiced' ? 'selected' : ''}}" data-filter="not_practiced" bindtap="changeTodayFilter">
            <text class="summary-number neutral-number">{{report.summary.notPracticedCount}}</text>
            <text class="summary-label">尚未练习</text>
          </view>
          <view wx:if="{{hasGoal}}" class="summary-item {{todayFilter === 'below_goal' ? 'selected' : ''}}" data-filter="below_goal" bindtap="changeTodayFilter">
            <text class="summary-number gold-number">{{report.summary.belowGoalCount}}</text>
            <text class="summary-label">时长不足</text>
          </view>
          <view wx:if="{{hasGoal}}" class="summary-item {{todayFilter === 'qualified' ? 'selected' : ''}}" data-filter="qualified" bindtap="changeTodayFilter">
            <text class="summary-number green-number">{{report.summary.qualifiedCount}}</text>
            <text class="summary-label">已达标</text>
          </view>
          <view wx:if="{{!hasGoal}}" class="summary-item {{todayFilter === 'practiced' ? 'selected' : ''}}" data-filter="practiced" bindtap="changeTodayFilter"><text class="summary-number green-number">{{report.summary.practicedCount}}</text><text class="summary-label">已练习</text></view>
        </view>

        <view class="filter-row">
          <view class="filter-chip {{todayFilter === 'attention' ? 'active' : ''}}" data-filter="attention" bindtap="changeTodayFilter">待关注 <text class="filter-count">{{attentionCount}}</text></view>
          <view class="filter-chip {{todayFilter === (hasGoal ? 'qualified' : 'practiced') ? 'active' : ''}}" data-filter="{{hasGoal ? 'qualified' : 'practiced'}}" bindtap="changeTodayFilter">{{hasGoal ? '已达标' : '已练习'}}</view>
          <view class="filter-chip {{todayFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="changeTodayFilter">全部</view>
          <button class="reminder-button" bindtap="showReminderList" loading="{{isPreparingReminder}}" disabled="{{isPreparingReminder || isSaving || isDeleting || removingMemberId}}" aria-label="{{hasGoal ? '查看今日未达标名单' : '查看今日未练习名单'}}">提醒</button>
        </view>
        <text class="list-note">{{todayFilter === 'attention' ? (hasGoal ? '先显示尚未练习的成员，再显示时长不足的成员' : '本练习日尚无练习记录的成员') : (todayFilter === 'not_practiced' ? '本练习日尚无练习记录的成员' : (todayFilter === 'below_goal' ? '本练习日累计时长未达目标的成员' : (todayFilter === 'qualified' ? '已完成本练习日目标的成员' : (todayFilter === 'practiced' ? '本练习日已有练习记录的成员' : '全体成员的当日累计练习情况'))))}}</text>

        <view class="member-list" wx:if="{{todayMembers.length}}">
          <view class="practice-card" wx:for="{{todayMembers}}" wx:key="openid" data-member-openid="{{item.openid}}" data-view="day" bindtap="openMemberRecords" hover-class="member-card-pressed" aria-role="button" aria-label="查看{{item.nickname}}今日的练习记录">
            <view class="member-row">
              <image class="member-avatar" src="{{item.avatar}}" mode="aspectFill" />
              <view class="member-identity">
                <view class="member-name-row"><text class="member-name">{{item.nickname}}</text><text wx:if="{{item.isCreator}}" class="creator-tag">团长</text></view>
                <text class="member-subtitle">{{item.todayStatus === 'not_practiced' ? '今天的练习，还未开始' : (item.todayStatus === 'below_goal' ? '距离目标还差 ' + item.remainingMinutesLabel + ' 分钟' : (hasGoal ? '今日目标已完成' : '今天已完成练习'))}}</text>
              </view>
              <view class="member-card-trailing"><text class="status-badge status-{{item.todayStatus}}">{{item.statusLabel}}</text><text class="member-card-chevron" aria-hidden="true">›</text></view>
            </view>
            <view class="practice-detail">
              <view class="minutes-line"><text class="minutes-value">{{item.todayMinutesLabel}}</text><text class="minutes-unit">{{hasGoal ? ' / ' + report.settings.dailyGoalMinutes : ''}} 分钟</text><text wx:if="{{item.todayPracticeCount > 0}}" class="session-count">{{item.todayPracticeCount}} 次练习</text></view>
              <view wx:if="{{hasGoal}}" class="progress-track"><view class="progress-fill progress-{{item.todayStatus}}" style="width: {{item.progress}}%;"></view></view>
            </view>
          </view>
        </view>
        <view wx:else class="empty-panel">
          <text class="empty-mark">{{todayFilter === 'attention' ? '✓' : '—'}}</text>
          <text class="state-title">{{todayFilter === 'attention' ? (hasGoal ? '今天，大家都已完成目标' : '今天，大家都已练习') : '当前分类暂无成员'}}</text>
          <text class="state-description">{{todayFilter === 'attention' ? '一起把这份坚持，带到明天。' : '可以切换其他分类，查看团队练习情况。'}}</text>
        </view>
        <text class="page-footnote">{{nextDayLabel}} 02:00 更新为下一个练习日 · 北京时间</text>
      </view>

      <view wx:else class="history-view">
        <view class="section-heading"><view><text class="section-title">历史练习统计</text><text class="section-caption">从起始日期至昨日，今日不计入历史</text></view></view>
        <view class="history-overview">
          <view class="history-overview-top"><text class="history-range">{{report.history.totalDays > 0 ? historyRangeLabel : '今天是统计的第一天'}}</text><text class="history-day-count">{{report.history.totalDays}}<text> 天</text></text></view>
          <text class="history-rule">{{hasGoal ? '每天累计 ' + report.settings.dailyGoalMinutes + ' 分钟即达标；未达标天数包含未练习。' : '未设置期望分钟，记录实际练习天数与时长。'}}</text><text wx:if="{{!report.settings.practiceStartDate}}" class="history-rule">未设置起始日期，从团队创建日开始统计。</text>
        </view>
        <block wx:if="{{report.history.totalDays > 0}}">
          <view wx:if="{{historySummary}}" class="history-summary">
            <view class="today-summary history-summary-metrics">
              <view class="summary-item" data-filter="{{hasGoal ? 'unmet' : 'not_practiced'}}" bindtap="openHistoryDetails" hover-class="member-card-pressed" aria-role="button" aria-label="查看{{hasGoal ? '未达标' : '未练习'}}成员和日期">
                <text class="summary-number gold-number">{{hasGoal ? historySummary.unmetMemberCount : historySummary.missedMemberCount}}<text class="history-summary-unit"> 人</text></text>
                <text class="summary-label">{{hasGoal ? '未达标人数' : '未练习人数'}} ›</text>
              </view>
              <view class="summary-item" data-filter="{{hasGoal ? 'unmet' : 'not_practiced'}}" bindtap="openHistoryDetails" hover-class="member-card-pressed" aria-role="button" aria-label="查看累计{{hasGoal ? '未达标' : '未练习'}}明细">
                <text class="summary-number gold-number">{{hasGoal ? historySummary.unmetCount : historySummary.missedCount}}<text class="history-summary-unit"> 人次</text></text>
                <text class="summary-label">{{hasGoal ? '累计未达标' : '累计未练习'}} ›</text>
              </view>
              <view class="summary-item" data-filter="all" bindtap="openHistoryDetails" hover-class="member-card-pressed" aria-role="button" aria-label="查看全部成员每日练习情况">
                <text class="summary-number green-number">{{historySummary.rateLabel}}</text>
                <text class="summary-label">{{hasGoal ? '总体达标率' : '练习参与率'}} ›</text>
              </view>
            </view>
            <view wx:if="{{hasGoal}}" class="history-summary-breakdown">
              <view data-filter="not_practiced" bindtap="openHistoryDetails" hover-class="member-card-pressed" aria-role="button" aria-label="查看未练习成员和日期"><text class="status-dot neutral-dot"></text><text>未练习</text><text class="breakdown-number">{{historySummary.missedMemberCount}} 人 · {{historySummary.missedCount}} 人次 ›</text></view>
              <view data-filter="below_goal" bindtap="openHistoryDetails" hover-class="member-card-pressed" aria-role="button" aria-label="查看时长不足成员和日期"><text class="status-dot gold-dot"></text><text>时长不足</text><text class="breakdown-number">{{historySummary.belowGoalMemberCount}} 人 · {{historySummary.belowGoalCount}} 人次 ›</text></view>
            </view>
            <view class="history-summary-footer"><text>共 {{historySummary.memberCount}} 位成员</text><text>{{hasGoal ? '全程达标' : '每天都练习'}} {{historySummary.fullAttendanceCount}} 人</text></view>
          </view>
          <text wx:if="{{historySummary}}" class="history-summary-note">人数为整个统计期间曾{{hasGoal ? '未达标' : '未练习'}}的成员数；每人每天计 1 人次。点击统计可按月查看明细。{{hasGoal ? '两类未达标人数可能重叠。' : ''}}</text>
          <view class="history-list-caption"><text>成员练习记录</text><text>{{hasGoal ? '按未达标天数排序' : '按练习天数排序'}}</text></view>
          <view class="history-card" wx:for="{{historyMembers}}" wx:key="openid" data-member-openid="{{item.openid}}" data-view="month" data-record-scope="history" bindtap="openMemberRecords" hover-class="member-card-pressed" aria-role="button" aria-label="查看{{item.nickname}}的历史练习记录">
            <view class="member-row">
              <image class="member-avatar history-avatar" src="{{item.avatar}}" mode="aspectFill" />
              <view class="member-identity"><view class="member-name-row"><text class="member-name">{{item.nickname}}</text><text wx:if="{{item.isCreator}}" class="creator-tag">团长</text></view></view>
              <view class="member-card-trailing"><text wx:if="{{hasGoal}}" class="history-qualified">已达标 {{item.qualifiedDays}} 天</text><text class="member-card-chevron" aria-hidden="true">›</text></view>
            </view>
            <view class="history-metrics">
              <view class="history-metric"><text class="metric-label">练习天数</text><text class="metric-value">{{item.practiceDays}}<text class="metric-unit"> 天</text></text></view>
              <view class="metric-divider"></view>
              <view wx:if="{{hasGoal}}" class="history-metric" data-filter="unmet" data-member-openid="{{item.openid}}" catchtap="openHistoryDetails" hover-class="member-card-pressed" aria-role="button" aria-label="查看{{item.nickname}}未达标的日期"><text class="metric-label">未达标天数 ›</text><text class="metric-value {{item.unmetDays > 0 ? 'gold-number' : ''}}">{{item.unmetDays}}<text class="metric-unit"> 天</text></text></view>
              <view wx:else class="history-metric"><text class="metric-label">练习时长</text><text class="metric-value">{{item.totalMinutesLabel}}<text class="metric-unit"> 分钟</text></text></view>
            </view>
            <view class="history-breakdown"><text data-filter="not_practiced" data-member-openid="{{item.openid}}" catchtap="openHistoryDetails" hover-class="member-card-pressed" aria-role="button" aria-label="查看{{item.nickname}}未练习的日期">未练习 <text class="breakdown-number">{{item.missedDays}}</text> 天 ›</text><text wx:if="{{hasGoal}}" data-filter="below_goal" data-member-openid="{{item.openid}}" catchtap="openHistoryDetails" hover-class="member-card-pressed" aria-role="button" aria-label="查看{{item.nickname}}时长不足的日期">时长不足 <text class="breakdown-number">{{item.belowGoalDays}}</text> 天 ›</text></view>
          </view>
        </block>
        <view wx:else class="empty-panel"><text class="empty-mark">○</text><text class="state-title">暂无历史统计</text><text class="state-description">当前练习日结束后，这里会展示每位成员的积累。</text></view>
        <text class="page-footnote">全体当前成员使用同一起始日期 · 每日 02:00 结算</text>
      </view>
    </block>
    </block>
  </view>

  <view wx:else class="state-panel full-page-state">
    <view wx:if="{{isLoading}}" class="loading-dot"></view>
    <text class="state-title">{{isLoading ? '正在打开团队' : '暂时无法打开团队'}}</text>
    <text class="state-description">{{isLoading ? '请稍候' : loadError}}</text>
    <button wx:if="{{!isLoading && teamId}}" class="secondary-button" bindtap="loadTeamData">重新加载</button>
    <button wx:if="{{!isLoading}}" class="text-button" bindtap="goToTeamList">返回团队列表</button>
  </view>

  <view wx:if="{{reminderDialogOpen}}" class="invite-overlay" bindtap="closeReminderDialog" catchtouchmove="noop">
    <view class="invite-dialog reminder-dialog" catchtap="noop" aria-role="dialog" aria-label="{{hasGoal ? '今日未达标名单' : '今日未练习名单'}}">
      <view class="invite-dialog-heading">
        <text class="invite-dialog-title">{{hasGoal ? '今日未达标名单' : '今日未练习名单'}}</text>
        <button class="invite-dialog-close" bindtap="closeReminderDialog" aria-label="关闭名单">×</button>
      </view>
      <text class="reminder-caption">{{reminderDate}} · {{reminderCount}} 位同学</text>
      <scroll-view class="reminder-list" scroll-y="true" style="height: {{(reminderCount > 8 ? 8 : reminderCount) * 52 + 32}}rpx;">
        <text class="reminder-names" user-select="{{true}}">{{reminderText}}</text>
      </scroll-view>
      <view class="invite-dialog-actions">
        <button class="invite-dialog-share" bindtap="copyReminderList" loading="{{isCopyingReminder}}" disabled="{{isCopyingReminder}}">复制名单</button>
      </view>
    </view>
  </view>

  <view wx:if="{{inviteDialogOpen}}" class="invite-overlay" bindtap="closeInviteDialog" catchtouchmove="noop">
    <view class="invite-dialog" catchtap="noop" aria-role="dialog" aria-label="邀请成员">
      <view class="invite-dialog-heading">
        <text class="invite-dialog-title">邀请成员</text>
        <button class="invite-dialog-close" bindtap="closeInviteDialog" aria-label="关闭邀请弹窗">×</button>
      </view>
      <view class="invite-dialog-team">
        <image class="invite-dialog-icon" src="{{teamInfo.icon || '/images/icons/team.png'}}" mode="aspectFill" />
        <text class="invite-dialog-name">{{teamInfo.name}}</text>
        <text class="invite-dialog-description">邀请好友加入团队，一起养成冥想习惯。</text>
      </view>
      <text wx:if="{{inviteReady && inviteExpiresLabel}}" class="invite-dialog-expiry">邀请有效期至 {{inviteExpiresLabel}}</text>
      <text wx:if="{{!inviteReady}}" class="invite-dialog-error">{{isPreparingInvite ? '正在准备邀请…' : (inviteError || '邀请已失效，请重新生成后分享')}}</text>
      <view class="invite-dialog-actions">
        <button wx:if="{{inviteReady}}" class="invite-dialog-share" open-type="share" disabled="{{isPreparingInvite || isSaving || isDeleting}}">分享给好友</button>
        <button wx:else class="invite-dialog-share" bindtap="prepareInvite" loading="{{isPreparingInvite}}" disabled="{{isPreparingInvite || isSaving || isDeleting}}">{{isPreparingInvite ? '准备中…' : '重新生成邀请'}}</button>
        <button class="invite-dialog-cancel" bindtap="closeInviteDialog">取消</button>
      </view>
    </view>
  </view>

  <view wx:if="{{settingsOpen}}" class="sheet-overlay" style="bottom: {{keyboardHeight}}px;">
    <view class="sheet-backdrop" catchtap="closeSettings" catchtouchmove="preventSheetClose"></view>
    <view class="settings-sheet" catchtap="preventSheetClose">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"><text class="sheet-title">{{isCreator ? '编辑团队' : '团队练习规则'}}</text><button class="sheet-close" bindtap="closeSettings" disabled="{{isSaving || isDeleting}}">×</button></view>
      <scroll-view class="settings-scroll" scroll-y="true" scroll-into-view="{{settingsScrollTarget}}" scroll-with-animation="true" enhanced="true" bounces="false">
        <view class="settings-scroll-content">
          <text class="sheet-description">{{isCreator ? '完善团队资料，练习设置可以随时调整。' : '查看团队的统计起点和每日期望时长。'}}</text>
          <view wx:if="{{isCreator}}" class="team-form-card">
            <view class="team-form-field">
              <text class="team-form-label">团队头像</text>
              <view class="team-form-avatar-row">
                <image class="team-form-avatar" src="{{draftIcon}}" mode="aspectFill" />
                <button class="team-form-avatar-button" bindtap="chooseTeamIcon" loading="{{isChoosingIcon}}"
                  disabled="{{isSaving || isDeleting || isChoosingIcon}}">{{isChoosingIcon ? '上传中…' : '更换头像'}}</button>
              </view>
            </view>
            <view class="team-form-field" id="team-name-field">
              <view class="team-form-label-row">
                <text class="team-form-label">团队名称</text>
                <text class="team-form-count">{{draftName.length}}/20</text>
              </view>
              <view class="team-form-control">
                <input class="team-form-input" value="{{draftName}}" placeholder="填写团队名称"
                  placeholder-class="team-form-placeholder" maxlength="20" bindinput="changeTeamName"
                  bindkeyboardheightchange="onFieldKeyboardHeightChange" data-field="team-name-field"
                  adjust-position="{{false}}" disabled="{{isSaving || isDeleting}}" />
              </view>
            </view>
            <view class="team-form-field" id="team-description-field">
              <view class="team-form-label-row">
                <text class="team-form-label">团队介绍 <text class="team-form-optional">选填</text></text>
                <text class="team-form-count">{{draftDescription.length}}/100</text>
              </view>
              <textarea class="team-form-textarea" value="{{draftDescription}}" placeholder="介绍一下你的团队"
                placeholder-class="team-form-placeholder" maxlength="100" bindinput="changeTeamDescription"
                bindkeyboardheightchange="onFieldKeyboardHeightChange" data-field="team-description-field"
                adjust-position="{{false}}" show-confirm-bar="{{false}}" disabled="{{isSaving || isDeleting}}" />
            </view>
          </view>
          <view class="team-form-card">
            <view class="team-form-heading team-form-rules-heading">
              <view class="team-form-rules-summary">
                <text class="team-form-title">练习规则</text>
                <text class="team-form-help">{{draftPracticeRulesEnabled ? '每日多次练习累计计算' : isCreator ? '开启后可设置统计日期和每日期望分钟。' : '未开启练习规则，按实际练习记录统计。'}}</text>
              </view>
              <switch wx:if="{{isCreator}}" class="team-form-rules-switch" checked="{{draftPracticeRulesEnabled}}"
                bindchange="changePracticeRulesEnabled" color="#b29764" aria-label="启用练习规则"
                disabled="{{isSaving || isDeleting}}" />
              <text wx:else class="team-form-badge">{{draftPracticeRulesEnabled ? '已开启' : '未开启'}}</text>
            </view>
            <view wx:if="{{draftPracticeRulesEnabled}}" class="team-form-rules-content">
              <view class="team-form-field">
                <view class="team-form-label-row">
                  <text class="team-form-label">统计起始日期 <text class="team-form-optional">选填</text></text>
                  <button wx:if="{{isCreator && draftStartDate}}" class="team-form-clear" bindtap="clearStartDate"
                    disabled="{{isSaving || isDeleting}}">清空</button>
                </view>
                <picker wx:if="{{isCreator}}" mode="date" value="{{draftStartDate || dateMax}}" end="{{dateMax}}"
                  bindchange="changeStartDate" disabled="{{isSaving || isDeleting}}">
                  <view class="team-form-control">
                    <text class="{{!draftStartDate ? 'team-form-placeholder' : ''}}">{{draftStartDate || '不设置，默认从创建日统计'}}</text>
                    <text class="team-form-chevron">›</text>
                  </view>
                </picker>
                <view wx:else class="team-form-readonly">{{draftStartDate || '未设置，从团队创建日统计'}}</view>
                <text class="team-form-help">全体当前成员从这一天开始统计，不区分加入时间。</text>
              </view>
              <view class="team-form-field" id="daily-goal-field">
                <text class="team-form-label">每日期望分钟 <text class="team-form-optional">选填</text></text>
                <view wx:if="{{isCreator}}" class="team-form-control">
                  <input class="team-form-input" placeholder="手动填写分钟数" placeholder-class="team-form-placeholder"
                    type="number" value="{{draftGoalMinutes}}" bindinput="changeGoalMinutes"
                    bindkeyboardheightchange="onGoalKeyboardHeightChange" adjust-position="{{false}}"
                    cursor-spacing="24" maxlength="4" disabled="{{isSaving || isDeleting}}" />
                  <text class="team-form-unit">分钟 / 天</text>
                </view>
                <view wx:else class="team-form-readonly">{{draftGoalMinutes ? draftGoalMinutes + ' 分钟 / 天' : '未设置'}}</view>
                <block wx:if="{{isCreator}}">
                  <text class="team-form-help">可选推荐值，也可输入 1–1440 的整数；留空则不设置。</text>
                  <view class="team-form-presets">
                    <button class="team-form-preset {{draftGoalMinutes === '' ? 'selected' : ''}}" data-minutes=""
                      bindtap="chooseGoalMinutes" disabled="{{isSaving || isDeleting}}">不设置</button>
                    <button class="team-form-preset {{draftGoalMinutes == 20 ? 'selected' : ''}}" data-minutes="20"
                      bindtap="chooseGoalMinutes" disabled="{{isSaving || isDeleting}}">20 分钟</button>
                    <button class="team-form-preset {{draftGoalMinutes == 30 ? 'selected' : ''}}" data-minutes="30"
                      bindtap="chooseGoalMinutes" disabled="{{isSaving || isDeleting}}">30 分钟</button>
                    <button class="team-form-preset {{draftGoalMinutes == 60 ? 'selected' : ''}}" data-minutes="60"
                      bindtap="chooseGoalMinutes" disabled="{{isSaving || isDeleting}}">60 分钟</button>
                  </view>
                </block>
              </view>
              <view class="team-form-note">
                <text>练习日为北京时间 02:00 至次日 02:00。</text>
                <text>当日多次练习累计计算；未设置期望分钟时不判断达标。</text>
                <text wx:if="{{isCreator}}">修改规则后，历史统计也会按新规则重新计算。</text>
              </view>
            </view>
          </view>
          <text wx:if="{{settingsError}}" class="settings-error">{{settingsError}}</text>
          <view class="team-form-actions">
            <button wx:if="{{isCreator}}" class="team-form-submit" bindtap="saveSettings" loading="{{isSaving}}"
              disabled="{{isSaving || isDeleting || isChoosingIcon}}">{{isSaving ? '保存中…' : '保存修改'}}</button>
            <button wx:else class="team-form-submit" bindtap="closeSettings">知道了</button>
          </view>
          <button wx:if="{{isCreator}}" class="dissolve-button" bindtap="confirmDeleteTeam" disabled="{{isSaving || isDeleting}}">解散团队</button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
