/* 标签页样式 */
.tab-container {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 8rpx;
  margin: 40rpx 32rpx 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  position: relative;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #b29764;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: white;
}

.tab-indicator {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #b29764;
  border-radius: 2rpx;
  opacity: 0;
}

.tab-item.active .tab-indicator {
  opacity: 1;
}

/* 练习动态样式 */
.activity-item {
  padding: 20rpx;
  background-color: #ffffff;
  border-radius: 28rpx;
  filter: drop-shadow(0rpx 4rpx 4rpx #0000001a, 0rpx 8rpx 6rpx #0000001a);
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  color: #999;
  font-size: 28rpx;
}

/* 成员头像样式 */
.member-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 40rpx;
  background-color: #f5f5f5;
  object-fit: cover;
}

/* 加载状态样式 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #b29764;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #666;
  font-size: 28rpx;
}

/* 错误状态样式 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  text-align: center;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  color: #ff6b6b;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: #b29764;
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

/* 解散团队按钮样式 */
.text-danger {
  color: #ffffff !important;
}

.button-item-danger {
  padding: 30rpx 72rpx;
  background-color: #fff1f0;
  border: 2rpx solid #ff4d4f;
  border-radius: 28rpx;
  filter: drop-shadow(0rpx 8rpx 6rpx #0000001a, 0rpx 20rpx 15rpx #0000001a);
}