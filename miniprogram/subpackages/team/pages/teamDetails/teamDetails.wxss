@import "../../styles/teamForm.wxss";

/* 团队概览沿用应用金色，成员与记录共享卡片规格。 */
page { background: #f8fafc; color: #354152; }
.team-page { min-height: 100vh; padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
button { margin: 0; font-weight: 400; }
button::after { border: none; }
.team-overview { margin: 0 -28rpx; padding: 12rpx 32rpx 36rpx; color: #ffffff; background: #b29764; }
.team-name-row, .team-stats, .hero-actions, .main-tabs, .record-toolbar, .record-tabs, .section-heading, .today-summary, .filter-row, .member-row, .member-name-row, .history-overview-top, .history-list-caption, .history-metrics, .history-breakdown, .sheet-heading, .roster-card { display: flex; align-items: center; }
.team-identity { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 18rpx 12rpx 28rpx; }
.team-icon { width: 128rpx; height: 128rpx; border: 4rpx solid rgba(255,255,255,.65); border-radius: 28rpx; background: #f8fafc; }
.team-name-row { max-width: 100%; margin-top: 22rpx; flex-direction: row; flex-wrap: nowrap; justify-content: center; }
.team-name { flex: 0 1 auto; min-width: 0; max-width: 100%; font-size: 36rpx; line-height: 1.5; font-weight: 600; white-space: normal; overflow-wrap: anywhere; word-break: break-all; }
.team-name-row .hero-edit { flex: none; margin: 0 0 0 12rpx; width: auto; min-width: 60rpx; min-height: 0; height: 48rpx; line-height: 48rpx; padding: 0 8rpx; box-sizing: border-box; white-space: nowrap; color: rgba(255,255,255,.82); font-size: 22rpx; background: transparent; border-radius: 8rpx; }
.team-description { margin-top: 12rpx; color: rgba(255,255,255,.85); font-size: 25rpx; line-height: 1.7; word-break: break-all; white-space: pre-wrap; }
.team-stats { gap: 16rpx; }
.team-stat { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 22rpx 8rpx; border-radius: 16rpx; background: rgba(77,57,26,.12); }
.team-stat-value { font-size: 36rpx; font-weight: 600; line-height: 1.25; word-break: break-all; }
.team-stat-label { font-size: 23rpx; color: rgba(255,255,255,.78); }
.hero-actions { justify-content: center; gap: 20rpx; margin-top: 24rpx; }
.invite-button, .hero-dissolve { flex: none; width: auto; min-width: 160rpx; min-height: 0; height: 56rpx; line-height: 54rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.22); border-radius: 12rpx; font-size: 24rpx; font-weight: 400; background: rgba(255,255,255,.06); color: rgba(255,255,255,.85); }
/* 覆盖微信 button[disabled]:not([type]) 的默认白底，保持加载期间的半透明样式。 */
.hero-actions .invite-button[disabled], .hero-actions .hero-dissolve[disabled] { background: rgba(255,255,255,.04); color: rgba(255,255,255,.45); border-color: rgba(255,255,255,.12); }
.invite-note { display: block; margin-top: 16rpx; font-size: 22rpx; line-height: 1.7; color: rgba(255,255,255,.78); text-align: center; }
.invite-error { color: #fff0df; }
.invite-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: calc(32rpx + env(safe-area-inset-top)) 40rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: rgba(29, 40, 56, .45); }
.invite-dialog { width: 100%; max-width: 640rpx; padding: 24rpx 32rpx 20rpx; box-sizing: border-box; border-radius: 28rpx; background: #ffffff; box-shadow: 0 24rpx 80rpx rgba(29, 40, 56, .12); }
.invite-dialog-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.invite-dialog-title { color: #354152; font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.invite-dialog .invite-dialog-close { flex: none; width: 60rpx; min-width: 0; min-height: 0; height: 60rpx; padding: 0; line-height: 60rpx; font-size: 44rpx; font-weight: 300; color: #99a1ae; background: transparent; }
.invite-dialog-team { display: flex; flex-direction: column; align-items: center; padding: 18rpx 10rpx 24rpx; text-align: center; }
.invite-dialog-icon { width: 104rpx; height: 104rpx; border-radius: 24rpx; background: #f8fafc; }
.invite-dialog-name { max-width: 100%; margin-top: 20rpx; color: #354152; font-size: 32rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; word-break: break-all; }
.invite-dialog-description { margin-top: 12rpx; color: #7a8493; font-size: 25rpx; line-height: 1.7; }
.invite-dialog-expiry, .invite-dialog-error { display: block; padding: 14rpx 16rpx; border-radius: 12rpx; font-size: 22rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
.invite-dialog-expiry { color: #a68a57; background: #f8f5ef; }
.invite-dialog-error { color: #a4594e; background: #fcf2ef; }
.invite-dialog-actions { margin-top: 28rpx; }
.invite-dialog .invite-dialog-share { width: 100%; min-height: 0; padding: 0 20rpx; border-radius: 14rpx; color: #ffffff; background: #b29764; font-size: 28rpx; line-height: 82rpx; }
.invite-dialog .invite-dialog-share[disabled] { color: rgba(255,255,255,.72); background: #cbb994; }
.invite-dialog .invite-dialog-cancel { width: 100%; min-height: 0; margin-top: 8rpx; padding: 0 20rpx; color: #99a1ae; background: transparent; font-size: 26rpx; line-height: 72rpx; }
.main-tabs { margin-top: 30rpx; padding: 6rpx; border-radius: 18rpx; background: #ffffff; }
.main-tab { flex: 1; border-radius: 13rpx; font-size: 29rpx; font-weight: 500; line-height: 74rpx; color: #697282; text-align: center; }
.main-tab.active { color: #ffffff; background: #b29764; }
.roster-card { gap: 20rpx; padding: 26rpx 24rpx; border-radius: 22rpx; margin-bottom: 16rpx; background: #ffffff; }
.roster-card .member-avatar { width: 86rpx; height: 86rpx; border-radius: 26rpx; }
.member-last-practice { display: block; margin-top: 8rpx; font-size: 21rpx; line-height: 1.5; color: #99a1ae; }
.member-load-note { padding: 20rpx; text-align: center; color: #99a1ae; font-size: 23rpx; }
.record-toolbar { flex-wrap: wrap; justify-content: space-between; gap: 16rpx; margin-top: 28rpx; }
.record-tabs { gap: 24rpx; }
.record-tab { padding: 10rpx 0; font-size: 26rpx; color: #99a1ae; border-bottom: 4rpx solid transparent; }
.record-tab.active { color: #a68a57; border-color: #b29764; font-weight: 600; }
.record-rules { color: #99a1ae; font-size: 21rpx; line-height: 1.5; }
.session-count { margin-left: 18rpx; font-size: 22rpx; color: #99a1ae; }
.section-heading { justify-content: space-between; margin: 34rpx 0 25rpx; gap: 12rpx; }
.section-title { display: block; font-size: 28rpx; line-height: 1.5; font-weight: 600; }
.date-caption { font-size: 24rpx; font-weight: 400; color: #99a1ae; }
.section-caption { display: block; margin-top: 8rpx; color: #99a1ae; font-size: 22rpx; line-height: 1.65; }
.member-total { color: #99a1ae; font-size: 22rpx; white-space: nowrap; }
.today-summary { padding: 28rpx 16rpx; background: #ffffff; border-radius: 24rpx; }
.summary-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 3rpx 0; }
.summary-item + .summary-item { border-left: 2rpx solid #f2f4f6; }
.summary-item.selected .summary-label { font-weight: 600; color: #354152; }
.summary-number { font-size: 44rpx; line-height: 1.2; font-weight: 600; font-variant-numeric: tabular-nums; }
.neutral-number { color: #7a8493; }
.gold-number { color: #b29764; }
.green-number { color: #52a277; }
.summary-label { display: flex; align-items: center; font-size: 24rpx; color: #99a1ae; gap: 8rpx; }
.status-dot { display: inline-block; width: 8rpx; height: 8rpx; border-radius: 50%; }
.neutral-dot { background: #c0c6cf; }
.gold-dot { background: #b29764; }
.green-dot { background: #81b997; }
.filter-row { gap: 12rpx; margin: 30rpx 0 14rpx; }
.filter-chip { padding: 12rpx 24rpx; border-radius: 12rpx; font-size: 24rpx; line-height: 1.5; color: #7a8493; background: #f2f4f6; border: 2rpx solid transparent; }
.filter-chip.active { color: #a68a57; background: #b2976414; border-color: #b2976433; }
.filter-count { margin-left: 6rpx; font-size: 22rpx; }
.list-note { display: block; margin: 0 3rpx 24rpx; font-size: 22rpx; line-height: 1.6; color: #99a1ae; }
.practice-card, .history-card { margin-bottom: 16rpx; padding: 24rpx 28rpx; border-radius: 20rpx; background: #ffffff; border: 2rpx solid #f0f2f5; }
.member-card-pressed { background: #f6f3ed; }
.member-card-trailing { display: flex; align-items: center; flex-shrink: 0; gap: 12rpx; margin-left: auto; }
.member-card-chevron { flex-shrink: 0; color: #a9b0ba; font-size: 32rpx; line-height: 1; }
.member-row { gap: 17rpx; flex-wrap: wrap; }
.member-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #f2f4f6; flex-shrink: 0; }
.member-identity { flex: 1; min-width: 160rpx; }
.member-name-row { gap: 8rpx 10rpx; flex-wrap: wrap; align-items: baseline; }
.member-name { max-width: 100%; font-size: 28rpx; font-weight: 500; line-height: 1.5; white-space: normal; word-break: break-all; overflow-wrap: anywhere; }
.creator-tag { flex: none; white-space: nowrap; padding: 2rpx 8rpx; font-size: 20rpx; color: #a68a57; background: #b2976414; border-radius: 6rpx; line-height: 1.5; }
.member-subtitle { display: block; margin-top: 9rpx; color: #99a1ae; font-size: 22rpx; line-height: 1.5; }
.status-badge { flex-shrink: 0; padding: 7rpx 12rpx; border-radius: 9rpx; font-size: 20rpx; white-space: nowrap; }
.status-not_practiced { color: #7a8493; background: #f3f4f6; }
.status-below_goal { color: #a68a57; background: #b2976414; }
.status-qualified, .status-practiced { color: #52a277; background: #edf7f0; }
.practice-detail { margin: 22rpx 0 0 93rpx; }
.minutes-line { margin-bottom: 13rpx; }
.minutes-value { color: #354152; font-size: 36rpx; font-weight: 500; font-variant-numeric: tabular-nums; }
.minutes-unit { font-size: 22rpx; color: #99a1ae; }
.progress-track { height: 7rpx; background: #f2f4f6; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #b29764; border-radius: 8rpx; }
.progress-qualified { background: #81b997; }
.history-overview { padding: 28rpx; background: #ffffff; border-radius: 24rpx; }
.history-overview-top { justify-content: space-between; gap: 14rpx; }
.history-range { min-width: 0; line-height: 1.6; font-size: 24rpx; color: #697282; }
.history-day-count { white-space: nowrap; font-size: 36rpx; color: #b29764; font-weight: 500; }
.history-day-count text { font-size: 22rpx; font-weight: 400; }
.history-rule { display: block; font-size: 22rpx; color: #99a1ae; line-height: 1.7; margin-top: 12rpx; }
.history-summary { margin-top: 20rpx; padding: 28rpx 16rpx 20rpx; background: #ffffff; border-radius: 24rpx; }
.history-summary-metrics { padding: 0; }
.history-summary-metrics .summary-item { min-width: 0; padding: 3rpx 8rpx; text-align: center; }
.history-summary-metrics .summary-number { max-width: 100%; overflow-wrap: anywhere; }
.history-summary-metrics .summary-label { font-size: 22rpx; }
.history-summary-unit { font-size: 20rpx; font-weight: 400; white-space: nowrap; }
.history-summary-breakdown { margin: 24rpx 12rpx 0; padding-top: 18rpx; border-top: 2rpx solid #f2f4f6; }
.history-summary-breakdown > view { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 12rpx; padding: 8rpx 0; font-size: 22rpx; color: #99a1ae; line-height: 1.8; }
.history-summary-breakdown > view + view { margin-top: 6rpx; }
.history-summary-breakdown .breakdown-number { margin-left: auto; }
.history-summary-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx 16rpx; margin: 18rpx 12rpx 0; color: #99a1ae; font-size: 21rpx; line-height: 1.6; }
.history-summary-note { display: block; margin: 14rpx 3rpx 0; color: #99a1ae; font-size: 20rpx; line-height: 1.7; }
.history-list-caption { justify-content: space-between; margin: 30rpx 3rpx 19rpx; font-size: 22rpx; color: #99a1ae; }
.history-list-caption text:last-child { color: #99a1ae; font-size: 20rpx; }
.history-avatar { width: 62rpx; height: 62rpx; }
.history-qualified { margin-left: auto; color: #52a277; font-size: 22rpx; white-space: nowrap; }
.history-metrics { margin: 24rpx 0 20rpx; }
.history-metric { flex: 1; display: flex; flex-direction: column; gap: 8rpx; padding-left: 20rpx; }
.metric-label { font-size: 24rpx; color: #99a1ae; }
.metric-value { font-size: 44rpx; font-weight: 600; color: #354152; }
.metric-value.gold-number { color: #b29764; }
.metric-unit { color: #99a1ae; font-size: 22rpx; font-weight: 400; }
.metric-divider { height: 57rpx; width: 1rpx; background: #f2f4f6; }
.history-breakdown { justify-content: space-between; border-top: 2rpx solid #f2f4f6; padding: 18rpx 20rpx 0; color: #99a1ae; font-size: 22rpx; }
.breakdown-number { color: #697282; }
.page-footnote { display: block; text-align: center; color: #99a1ae; font-size: 20rpx; line-height: 1.8; margin: 30rpx 0 10rpx; }
.state-panel, .empty-panel { display: flex; flex-direction: column; align-items: center; padding: 76rpx 30rpx; text-align: center; }
.full-page-state { padding-top: 180rpx; }
.state-title { display: block; font-size: 28rpx; color: #697282; line-height: 1.5; }
.state-description { display: block; color: #99a1ae; font-size: 24rpx; line-height: 1.8; margin-top: 15rpx; }
.state-symbol, .empty-mark { color: #b29764; font-size: 62rpx; font-weight: 300; margin-bottom: 23rpx; }
.loading-dot { width: 34rpx; height: 34rpx; margin: 0 0 30rpx; border: 4rpx solid #f2f4f6; border-top-color: #b29764; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.secondary-button { margin-top: 27rpx; padding: 0 40rpx; line-height: 72rpx; font-size: 25rpx; border: 1rpx solid #edf0f3; background: transparent; color: #a68a57; border-radius: 36rpx; }
.text-button { background: transparent; color: #99a1ae; font-size: 24rpx; margin-top: 14rpx; line-height: 64rpx; }
.sheet-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; display: flex; align-items: flex-end; }
.sheet-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(29, 40, 56, .45); }
.settings-sheet { position: relative; display: flex; flex-direction: column; width: 100%; height: 90%; max-height: 1200rpx; overflow: hidden; box-sizing: border-box; padding-top: 18rpx; border-radius: 28rpx 28rpx 0 0; background: #f8fafc; }
.settings-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.settings-scroll-content { padding: 0 28rpx calc(26rpx + env(safe-area-inset-bottom)); }
.sheet-handle { flex-shrink: 0; width: 64rpx; height: 7rpx; border-radius: 8rpx; background: #c0c6cf; margin: 0 auto 24rpx; }
.sheet-heading { flex-shrink: 0; justify-content: space-between; padding: 0 28rpx 12rpx; }
.sheet-title { font-size: 32rpx; font-weight: 600; color: #1d293d; }
.sheet-heading .sheet-close { flex: none; width: 60rpx; min-width: 0; height: 60rpx; min-height: 0; margin: 0; line-height: 60rpx; padding: 0; font-size: 44rpx; font-weight: 300; color: #99a1ae; background: transparent; }
.sheet-description { display: block; font-size: 26rpx; color: #697282; line-height: 1.5; margin: 9rpx 0 28rpx; }
.settings-error { display: block; color: #d9534f; font-size: 24rpx; line-height: 1.6; margin-top: 21rpx; }
.dissolve-button { margin-top: 14rpx; width: 100%; line-height: 65rpx; font-size: 22rpx; color: #d9534f; background: transparent; }
@media (max-width: 360px) { .team-stats { gap: 10rpx; } .status-badge { margin-left: auto; } .practice-detail { margin-left: 0; } }
