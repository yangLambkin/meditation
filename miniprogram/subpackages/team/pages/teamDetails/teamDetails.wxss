/* 功能按钮区域样式 */
.button-group {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

/* 邀请成员按钮样式（原grid-item） */
.button-item:nth-child(1) {
  padding: 30rpx 72rpx;
  background-color: #ffffff;
  border-radius: 28rpx;
  filter: drop-shadow(0rpx 8rpx 6rpx #0000001a, 0rpx 20rpx 15rpx #0000001a);
}

/* 团队动态按钮样式（原grid-item_2） */
.button-item:nth-child(2) {
  padding: 30rpx 72rpx 30rpx 76rpx;
  background-image: linear-gradient(180deg, #b29764 0%, #c9a870 100%);
  border-radius: 28rpx;
  filter: drop-shadow(0rpx 8rpx 6rpx #0000001a, 0rpx 20rpx 15rpx #0000001a);
}

/* 标签页样式 */
.tab-container {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 8rpx;
  margin: 40rpx 32rpx 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  position: relative;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #b29764;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: white;
}

.tab-indicator {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #b29764;
  border-radius: 2rpx;
  opacity: 0;
}

.tab-item.active .tab-indicator {
  opacity: 1;
}

/* 练习动态样式 */
.activity-item {
  padding: 26rpx;
  background-color: #ffffff;
  border-radius: 28rpx;
  filter: drop-shadow(0rpx 4rpx 4rpx #0000001a, 0rpx 8rpx 6rpx #0000001a);
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  color: #999;
  font-size: 28rpx;
}