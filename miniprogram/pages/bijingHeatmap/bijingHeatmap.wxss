page { background: #faf8f3; color: #38352f; }
.heatmap-page { padding: 44rpx 28rpx; }
.heatmap-heading { font-size: 42rpx; font-weight: 600; }
.heatmap-subtitle, .heatmap-note { display: block; margin-top: 16rpx; color: #8c8477; font-size: 25rpx; line-height: 1.7; }
.heatmap-identity { margin: 36rpx 0 20rpx; color: #8c7345; font-size: 26rpx; }
.heatmap-card { background: #fff; border-radius: 24rpx; padding: 28rpx 24rpx; margin-bottom: 24rpx; }
.heatmap-card-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.heatmap-year { font-size: 30rpx; color: #8c7345; }
.heatmap-year-summary { font-size: 23rpx; color: #8c8477; }
.heatmap-chart { display: flex; }
.heatmap-weekdays { display: flex; flex-direction: column; flex: 0 0 32rpx; padding-top: 36rpx; }
.heatmap-weekdays text { font-size: 18rpx; color: #aaa; height: 28rpx; line-height: 24rpx; }
.heatmap-scroll { width: 0; flex: 1; white-space: nowrap; }
.heatmap-weeks { display: inline-flex; }
.heatmap-week { width: 28rpx; flex: 0 0 28rpx; }
.heatmap-month { display: block; height: 36rpx; font-size: 18rpx; color: #999; overflow: visible; }
.heatmap-day { height: 24rpx; width: 24rpx; margin-bottom: 4rpx; border-radius: 4rpx; }
.level-0 { background: #eeece7; }
.level-1 { background: #e4d3af; }
.level-2 { background: #c5a770; }
.level-3 { background: #917346; }
.heatmap-day-empty { visibility: hidden; }
.heatmap-day-future { opacity: .35; }
.heatmap-legend { display: flex; justify-content: flex-end; align-items: center; gap: 8rpx; margin-top: 24rpx; font-size: 20rpx; color: #999; }
.heatmap-legend .heatmap-day { margin-bottom: 0; }
.heatmap-hint { display: block; margin-top: 24rpx; color: #8c8477; font-size: 22rpx; }
.heatmap-empty { display: block; text-align: center; margin-top: 32rpx; color: #999; font-size: 26rpx; }
.heatmap-state { padding: 100rpx 24rpx; text-align: center; color: #8c8477; font-size: 28rpx; }
.heatmap-button { margin-top: 32rpx; background: #b29764; color: #fff; font-size: 28rpx; }
