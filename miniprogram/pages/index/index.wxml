<!--pages/index/index.wxml-->
<view class="flex-col page">
  <view class="flex-col section">
    <view class="flex-col home-overview">
      <view class="flex-col group">
        <view class="flex-col items-start relative section_2">
          <view class="flex-row items-center welcome-row">
            <text class="font text">欢迎回来，</text>
            <!-- 未登录时显示点击登录按钮 -->
            <text wx:if="{{!hasUserInfo}}" class="font text login-text" bindtap="showLoginModal" data-debug="login-button-click">点击登录</text>
            <!-- 已登录时显示用户昵称 -->
            <text wx:else class="font text">{{userNickname}}</text>
          </view>
          <view class="shrink-0 relative section_5"></view>
          <view class="flex-col justify-start items-end pos">
            <view class="section_3">
              <image class="section_3_bg" src="../../images/bg_image.png" mode="aspectFill" />
            </view>
            <text class="font_2 text_2 pos_2">保持觉察，自在当下</text>
          </view>
        </view>
        <view class="flex-col relative section_6">
          <!-- 日历头部 -->
          <view class="flex-row justify-between items-center">
            <view class="calendar-nav-btn" bindtap="prevMonth">
              <image class="image" src="/images/icons/chevron-left.svg" mode="aspectFit" />
            </view>
            <text class="font_5 text_3">{{currentYear}}年 {{currentMonth}}月</text>
            <view class="calendar-nav-btn" bindtap="nextMonth">
              <image class="image image_2" src="/images/icons/chevron-right.svg" mode="aspectFit" />
            </view>
          </view>

          <!-- 星期标题 -->
          <view class="flex-row justify-between items-baseline self-stretch group_2 mt-21">
            <text class="font_6 text_10">一</text>
            <text class="font_6 text_4">二</text>
            <text class="font_6 text_5">三</text>
            <text class="font_6 text_6">四</text>
            <text class="font_6 text_7">五</text>
            <text class="font_6 text_8">六</text>
            <text class="font_6 text_9">日</text>
          </view>

          <!-- 日历日期网格 -->
          <view class="calendar-grid">
            <view class="calendar-row" wx:for="{{calendarDays}}" wx:for-item="week" wx:key="weekIndex">
              <view
                class="calendar-day {{item.type}} {{item.isToday ? 'today' : ''}} {{item.isChecked ? 'checked' : ''}}"
                wx:for="{{week}}"
                wx:for-item="item"
                wx:key="day"
                bindtap="selectDate"
                data-date="{{item.fullDate}}"
              >
                <text class="day-text">{{item.day}}</text>
                <image
                  class="check-icon"
                  src="/images/icons/checked.svg"
                  mode="aspectFit"
                  wx:if="{{item.isChecked}}"
                />
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 觉察与静坐记录入口 -->
      <view class="meditation-btn-container">
        <button class="weui-btn meditation-btn primary" bindtap="startMeditation" hover-class="weui-btn_active">
          <image class="meditation-btn-icon" src="/images/icons/timer-start.svg" mode="aspectFit" />
          <text class="meditation-btn-text">开始觉察</text>
        </button>
        <button class="weui-btn meditation-btn meditation-btn-secondary" bindtap="openCheckinModal" hover-class="checkin-record-active">
          <text class="meditation-btn-text">记录静坐</text>
        </button>
      </view>

      <button wx:if="{{homeBackfillGrant}}" class="home-backfill-entry" bindtap="openApprovedBackfill" disabled="{{checkinSubmitting}}" hover-class="checkin-record-active">已获批补录 · {{homeBackfillGrant.startDate}} 至 {{homeBackfillGrant.endDate}} ›</button>

      <!-- 每日金句随首屏自适应布局落在操作按钮下方 -->
      <view class="flex-col items-start section_11">
        <text class="font_6 text_29">每日金句</text>
        <text class="font text_30 mt-11">{{wisdomQuote}}</text>
      </view>
    </view>

    <view class="checkin-history">
      <view class="checkin-history-heading">
        <text class="checkin-title">最近三天记录</text>
        <button class="checkin-scope-toggle" bindtap="openAllCheckins" aria-label="查看全部打卡记录" hover-class="checkin-record-active">
          <text>全部</text>
          <view class="checkin-scope-arrow" aria-hidden="true"></view>
        </button>
      </view>
      <view wx:if="{{pendingCheckinCount > 0}}" class="checkin-pending-banner">
        <text class="checkin-pending-text">全部日期共 {{pendingCheckinCount}} 条记录待上传或待确认</text>
        <button class="checkin-retry-button" bindtap="openCheckinUploadPreview" loading="{{checkinRetrying}}" disabled="{{checkinRetrying || checkinSubmitting}}" hover-class="checkin-record-active">重试上传</button>
      </view>
      <text wx:if="{{checkinTotal}}" class="checkin-load-hint">长按记录可删除</text>
      <view wx:if="{{!checkinTotal}}" class="checkin-empty">尚无打卡记录</view>
      <view wx:elif="{{!checkinGroups.length}}" class="checkin-empty">最近三天暂无打卡记录</view>
      <view wx:else>
        <view class="checkin-day-group" wx:for="{{checkinGroups}}" wx:for-item="group" wx:key="date">
          <view class="checkin-day-heading">
            <text class="checkin-day-date">{{group.date}}</text>
            <text class="checkin-day-summary">{{group.count}} 次 · {{group.totalDuration}} 分钟</text>
          </view>
          <view class="checkin-record {{!record.emotion.length && !record.experienceTexts.length && !record.syncError && !record.syncStatusText && !record.bijingSyncText ? 'checkin-record-brief' : ''}}" wx:for="{{group.records}}" wx:for-item="record" wx:key="id" bindtap="openCheckinHistory" catchlongpress="deleteCheckinRecord" data-id="{{record.id}}" data-date="{{record.dayDate}}" hover-class="checkin-record-active">
            <view class="checkin-record-heading">
              <text class="checkin-record-time">{{record.timeLabel}}{{record.isBackfill ? ' · 闭关补录' : ''}}</text>
              <view class="checkin-record-actions">
                <text class="checkin-record-duration">{{record.duration}} 分钟</text>
              </view>
            </view>
            <text wx:if="{{record.syncStatusText}}" class="record-sync-error">{{record.syncStatusText}}</text>
            <text wx:elif="{{record.syncError}}" class="record-sync-error">上传失败，已存本机，请手动上传</text>
            <view wx:if="{{record.bijingSyncText}}" class="record-bijing-sync">
              <text class="record-bijing-text record-bijing-{{record.bijingSyncStatus}}">{{record.bijingSyncText}}</text>
              <button wx:if="{{record.bijingCanRetry}}" class="record-bijing-retry" catchtap="retryBijingSync" data-date="{{record.dayDate}}" hover-class="checkin-record-active">重试必经同步</button>
            </view>
            <view wx:if="{{record.emotion.length}}" class="checkin-record-emotions">
              <text class="checkin-emotion" wx:for="{{record.emotion}}" wx:for-item="emotion" wx:key="*this">{{emotion}}</text>
            </view>
            <view wx:if="{{record.experienceTexts.length}}" class="checkin-record-experience">
              <text class="checkin-record-experience-text" wx:for="{{record.experienceTexts}}" wx:for-item="experience" wx:key="*this">{{experience}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{hiddenCheckinCount > 0}}" class="checkin-list-footer">
        <text class="checkin-load-hint">还有 {{hiddenCheckinCount}} 条更早记录，点击「全部」按月查看</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showCheckinUploadPreview}}" class="checkin-modal">
    <view class="checkin-modal-mask" bindtap="closeCheckinUploadPreview" catchtouchmove="preventCheckinModalTouchMove"></view>
    <view class="checkin-dialog" catchtap="preventCheckinModalTouchMove">
      <view class="checkin-dialog-header">
        <text class="checkin-title">待上传记录</text>
        <button class="checkin-close" bindtap="closeCheckinUploadPreview" disabled="{{checkinRetrying}}" aria-label="关闭待上传记录弹窗" hover-class="checkin-record-active">×</button>
      </view>
      <scroll-view class="checkin-dialog-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="checkin-dialog-body">
          <text class="checkin-subtitle">统一上传全部日期的未上传记录，不限最近三天。旧本机记录会先核对云端，无法确认时保留本机并提示核对。</text>
          <view class="checkin-upload-summary">
            <text>本次将尝试上传 {{checkinUploadCount}} 条 · {{checkinUploadDuration}} 分钟</text>
            <text class="checkin-subtitle">请核对记录后确认上传，上传失败的记录会保留在本机。</text>
          </view>
          <view class="checkin-day-group" wx:for="{{checkinUploadGroups}}" wx:for-item="group" wx:key="date">
            <view class="checkin-day-heading">
              <text class="checkin-day-date">{{group.date}}</text>
              <text class="checkin-day-summary">{{group.count}} 次 · {{group.totalDuration}} 分钟</text>
            </view>
            <view class="checkin-record checkin-upload-record" wx:for="{{group.records}}" wx:for-item="record" wx:key="id">
              <view class="checkin-record-heading">
                <text class="checkin-record-time">{{record.timeLabel}}</text>
                <text class="checkin-record-duration">{{record.duration}} 分钟</text>
              </view>
              <view wx:if="{{record.emotion.length}}" class="checkin-record-emotions">
                <text class="checkin-emotion" wx:for="{{record.emotion}}" wx:for-item="emotion" wx:key="*this">{{emotion}}</text>
              </view>
              <view wx:if="{{record.experienceTexts.length}}" class="checkin-record-experience">
                <text class="checkin-record-experience-text" wx:for="{{record.experienceTexts}}" wx:for-item="experience" wx:key="*this">{{experience}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{checkinUploadBlockedRecords.length}}" class="checkin-upload-blocked">
            <text class="checkin-day-date">暂无法上传 · {{checkinUploadBlockedRecords.length}} 条</text>
            <text class="checkin-subtitle">以下记录本次不会上传。相似记录核对后可忽略，仍保留在本机，不再提醒上传。</text>
            <view class="checkin-record checkin-upload-record" wx:for="{{checkinUploadBlockedRecords}}" wx:for-item="record" wx:key="id">
              <text class="checkin-upload-date">{{record.dayDate}}</text>
              <view class="checkin-record-heading">
                <text class="checkin-record-time">{{record.timeLabel}}</text>
                <text class="checkin-record-duration">{{record.duration}} 分钟</text>
              </view>
              <text class="record-sync-error">{{record.syncError || record.syncStatusText}}</text>
              <view wx:if="{{record.canIgnoreUpload}}" class="checkin-upload-record-actions">
                <button class="checkin-ignore-upload" bindtap="ignoreCheckinUpload" data-local-id="{{record.localId}}" disabled="{{checkinRetrying || checkinSubmitting}}" hover-class="checkin-record-active">忽略</button>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="checkin-dialog-actions">
        <button class="checkin-cancel" bindtap="closeCheckinUploadPreview" disabled="{{checkinRetrying}}" hover-class="checkin-record-active">{{checkinUploadCount ? '取消' : '关闭'}}</button>
        <button class="checkin-submit" bindtap="retryCheckinUploads" loading="{{checkinRetrying}}" disabled="{{checkinRetrying || !checkinUploadCount}}" hover-class="checkin-submit-active">{{checkinRetrying ? '正在上传' : '确认上传'}}</button>
      </view>
    </view>
  </view>

  <!-- 独立遮罩拦截背景滚动，表单内容仍可在弹窗内滚动 -->
  <view wx:if="{{showCheckinModal}}" class="checkin-modal">
    <view class="checkin-modal-mask" bindtap="closeCheckinModal" catchtouchmove="preventCheckinModalTouchMove"></view>
    <view class="checkin-dialog" catchtap="preventCheckinModalTouchMove">
      <view class="checkin-dialog-header">
        <text class="checkin-title">记录静坐</text>
        <button class="checkin-close" bindtap="closeCheckinModal" disabled="{{checkinSubmitting}}" aria-label="关闭记录静坐弹窗" hover-class="checkin-record-active">×</button>
      </view>
      <scroll-view class="checkin-dialog-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="checkin-dialog-body">
          <text class="checkin-subtitle">{{hasBackfillDates ? '可选获批补录日期 + 最近三天（含今天），北京时间凌晨 2 点换日' : '最近三天（含今天）无需申请即可记录，北京时间凌晨 2 点换日'}}</text>
          <text wx:if="{{homeBackfillGrant}}" class="checkin-subtitle">获批区间：{{homeBackfillGrant.startDate}} 至 {{homeBackfillGrant.endDate}}。请在 {{homeBackfillGrant.expiresText}}（北京时间）前完成补录；最近三天和获批区间以外的日期不可选。</text>
          <text wx:else class="checkin-subtitle">需要补录更早的闭关记录，请到「我 → 申请补录」选择日期区间、填写原因，管理员审批通过后再回首页补录。</text>
          <text wx:if="{{backfillLoading}}" class="checkin-subtitle">正在读取补录权限…</text>
          <view wx:if="{{backfillError}}" class="checkin-backfill-notice">
            <text>{{backfillError}}</text>
            <button class="checkin-retry-button" bindtap="initHomeBackfill" disabled="{{backfillLoading || checkinSubmitting}}">重试读取</button>
          </view>
          <text wx:if="{{checkinDateAccessHint}}" class="record-sync-error">{{checkinDateAccessHint}}</text>
          <view class="checkin-fields-row">
            <view class="checkin-field checkin-date-field">
              <text class="checkin-label">归属日期</text>
              <picker wx:if="{{hasBackfillDates}}" mode="selector" range="{{checkinDateOptions}}" range-key="label" value="{{checkinDateOptionIndex}}" bindchange="onAllowedCheckinDateChange" disabled="{{checkinSubmitting}}">
                <view class="checkin-picker"><text>{{checkinDate}}</text><text class="checkin-picker-arrow">⌄</text></view>
              </picker>
              <picker wx:else mode="date" value="{{checkinDate}}" start="{{minCheckinDate}}" end="{{maxCheckinDate}}" bindchange="onCheckinDateChange" disabled="{{checkinSubmitting}}">
                <view class="checkin-picker">
                  <text>{{checkinDate}}</text>
                  <text class="checkin-picker-arrow">⌄</text>
                </view>
              </picker>
            </view>
            <view class="checkin-field checkin-time-field">
              <text class="checkin-label">时间</text>
              <button class="checkin-picker checkin-time-trigger" bindtap="openCheckinTimePicker" disabled="{{checkinSubmitting}}" aria-label="选择时间，当前 {{checkinTime}}" hover-class="checkin-record-active">
                <text>{{checkinTime < '02:00' ? '次日 ' : ''}}{{checkinTime}}</text>
                <text class="checkin-picker-arrow">⌄</text>
              </button>
            </view>
          </view>
          <view wx:if="{{checkinBackfillGrant}}" class="checkin-backfill-notice">
            <text>闭关补录 · 每次填写一段静坐的实际时间和时长，一天多次请分次保存，勿重复补录。</text>
            <text class="checkin-subtitle">获批 {{checkinBackfillGrant.startDate}} 至 {{checkinBackfillGrant.endDate}}</text>
            <text class="checkin-subtitle">请在 {{checkinBackfillGrant.expiresText}}（北京时间）前联网保存；00:00–01:59 的静坐归入前一天。</text>
            <view class="checkin-backfill-heading">
              <text>当天已有记录</text>
              <button class="checkin-retry-button" bindtap="loadBackfillDayRecords" disabled="{{backfillDayLoading || checkinSubmitting}}">刷新</button>
            </view>
            <text wx:if="{{backfillDayLoading}}" class="checkin-subtitle">正在读取…</text>
            <block wx:elif="{{backfillDayLoaded}}">
              <text class="checkin-subtitle">共 {{backfillDayRecords.length}} 次 · {{backfillDayTotal}} 分钟</text>
              <view wx:for="{{backfillDayRecords}}" wx:key="_id" class="checkin-backfill-day-row"><text>{{item.timeText || '时间未记录'}}</text><text>{{item.duration}} 分钟</text></view>
            </block>
            <text wx:if="{{backfillDayError}}" class="record-sync-error">{{backfillDayError}}</text>
          </view>
          <view class="checkin-field">
            <text class="checkin-label">静坐时长</text>
            <view class="checkin-duration-field">
              <input class="checkin-duration-input" type="number" value="{{checkinDuration}}" bindinput="onCheckinDurationInput" maxlength="4" disabled="{{checkinSubmitting}}" cursor-spacing="20" placeholder="请输入静坐时长" placeholder-class="checkin-placeholder" />
              <text class="checkin-unit">分钟</text>
            </view>
          </view>
          <view class="checkin-field">
            <text class="checkin-label">静坐体验 <text class="checkin-optional">（选填）</text></text>
            <textarea class="checkin-experience" value="{{checkinExperience}}" bindinput="onCheckinExperienceInput" maxlength="500" disabled="{{checkinSubmitting}}" cursor-spacing="20" placeholder="记录此刻的感受（选填）" placeholder-class="checkin-placeholder" />
          </view>
          <text class="checkin-subtitle">今天之前的记录保存到云端后，会立即发起必经同步；今天的记录于次日自动同步。同步结果请查看页面提示。</text>
          <text wx:if="{{checkinBackfillError}}" class="record-sync-error" selectable>{{checkinBackfillError}}</text>
          <text wx:if="{{checkinBackfillMessage}}" class="checkin-backfill-success" selectable>{{checkinBackfillMessage}}</text>
          <view wx:if="{{backfillSyncState}}" class="checkin-backfill-notice">
            <text>{{backfillSyncState.message}}</text>
            <button wx:if="{{backfillSyncState.canRetry}}" class="checkin-retry-button" bindtap="retryBackfillSync" disabled="{{checkinSubmitting}}">重试必经同步</button>
          </view>
        </view>
      </scroll-view>
      <view class="checkin-dialog-actions">
        <button class="checkin-cancel" bindtap="closeCheckinModal" disabled="{{checkinSubmitting}}" hover-class="checkin-record-active">取消</button>
        <button class="checkin-submit" bindtap="submitCheckin" loading="{{checkinSubmitting}}" disabled="{{checkinSubmitting}}" hover-class="checkin-submit-active">{{checkinBackfillGrant ? '保存本次补录' : '打卡记录'}}</button>
      </view>
    </view>
  </view>
  <time-picker wx:if="{{showCheckinModal && showCheckinTimePicker}}" value="{{checkinTime}}" bindconfirm="onCheckinTimeChange" bindcancel="closeCheckinTimePicker" />
</view>
