<!--pages/index/index.wxml-->
<view class="flex-col page">
  <view class="flex-col section">
    <view class="flex-col home-overview">
      <view class="flex-col group">
        <view class="flex-col items-start relative section_2">
          <view class="flex-row items-center welcome-row">
            <text class="font text">欢迎回来，</text>
            <!-- 未登录时显示点击登录按钮 -->
            <text wx:if="{{!hasUserInfo}}" class="font text login-text" bindtap="showLoginModal" data-debug="login-button-click">点击登录</text>
            <!-- 已登录时显示用户昵称 -->
            <text wx:else class="font text">{{userNickname}}</text>
          </view>
          <view class="shrink-0 relative section_5"></view>
          <view class="flex-col justify-start items-end pos">
            <view class="section_3">
              <image class="section_3_bg" src="../../images/bg_image.png" mode="aspectFill" />
            </view>
            <text class="font_2 text_2 pos_2">保持觉察，自在当下</text>
          </view>
        </view>
        <view class="flex-col relative section_6">
          <!-- 日历头部 -->
          <view class="flex-row justify-between items-center">
            <view class="calendar-nav-btn" bindtap="prevMonth">
              <image class="image" src="/images/icons/left.png" />
            </view>
            <text class="font_5 text_3">{{currentYear}}年 {{currentMonth}}月</text>
            <view class="calendar-nav-btn" bindtap="nextMonth">
              <image class="image image_2" src="/images/icons/right.png" />
            </view>
          </view>

          <!-- 星期标题 -->
          <view class="flex-row justify-between items-baseline self-stretch group_2 mt-21">
            <text class="font_6 text_10">一</text>
            <text class="font_6 text_4">二</text>
            <text class="font_6 text_5">三</text>
            <text class="font_6 text_6">四</text>
            <text class="font_6 text_7">五</text>
            <text class="font_6 text_8">六</text>
            <text class="font_6 text_9">日</text>
          </view>

          <!-- 日历日期网格 -->
          <view class="calendar-grid">
            <view class="calendar-row" wx:for="{{calendarDays}}" wx:for-item="week" wx:key="weekIndex">
              <view
                class="calendar-day {{item.type}} {{item.isToday ? 'today' : ''}} {{item.isChecked ? 'checked' : ''}}"
                wx:for="{{week}}"
                wx:for-item="item"
                wx:key="day"
                bindtap="selectDate"
                data-date="{{item.fullDate}}"
              >
                <text class="day-text">{{item.day}}</text>
                <image
                  class="check-icon"
                  src="/images/icons/checked.png"
                  wx:if="{{item.isChecked}}"
                />
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 觉察与静坐记录入口 -->
      <view class="meditation-btn-container">
        <button class="weui-btn meditation-btn primary" bindtap="startMeditation" hover-class="weui-btn_active">
          <image class="meditation-btn-icon" src="/images/icons/start.png" />
          <text class="meditation-btn-text">开始觉察</text>
        </button>
        <button class="weui-btn meditation-btn meditation-btn-secondary" bindtap="openCheckinModal" hover-class="checkin-record-active">
          <text class="meditation-btn-text">记录静坐</text>
        </button>
      </view>

      <!-- 每日金句随首屏自适应布局落在操作按钮下方 -->
      <view class="flex-col items-start section_11">
        <text class="font_6 text_29">每日金句</text>
        <text class="font text_30 mt-11">{{wisdomQuote}}</text>
      </view>
    </view>

    <view class="checkin-history">
      <view class="checkin-history-heading">
        <text class="checkin-title">最近三天记录</text>
        <button class="checkin-scope-toggle" bindtap="openAllCheckins" aria-label="查看全部打卡记录" hover-class="checkin-record-active">
          <text>全部</text>
          <view class="checkin-scope-arrow" aria-hidden="true"></view>
        </button>
      </view>
      <view wx:if="{{pendingCheckinCount > 0}}" class="checkin-pending-banner">
        <text class="checkin-pending-text">{{pendingCheckinCount}} 条本机记录尚未上传</text>
        <button class="checkin-retry-button" bindtap="retryCheckinUploads" loading="{{checkinRetrying}}" disabled="{{checkinRetrying || checkinSubmitting}}" hover-class="checkin-record-active">重试上传</button>
      </view>
      <text wx:if="{{checkinTotal}}" class="checkin-load-hint">长按记录可删除</text>
      <view wx:if="{{!checkinTotal}}" class="checkin-empty">尚无打卡记录</view>
      <view wx:elif="{{!checkinGroups.length}}" class="checkin-empty">最近三天暂无打卡记录</view>
      <view wx:else>
        <view class="checkin-day-group" wx:for="{{checkinGroups}}" wx:for-item="group" wx:key="date">
          <view class="checkin-day-heading">
            <text class="checkin-day-date">{{group.date}}</text>
            <text class="checkin-day-summary">{{group.count}} 次 · {{group.totalDuration}} 分钟</text>
          </view>
          <view class="checkin-record {{!record.emotion.length && !record.experienceTexts.length && !record.syncError && !record.syncStatusText ? 'checkin-record-brief' : ''}}" wx:for="{{group.records}}" wx:for-item="record" wx:key="id" bindtap="openCheckinHistory" catchlongpress="deleteCheckinRecord" data-id="{{record.id}}" data-date="{{record.dayDate}}" hover-class="checkin-record-active">
            <view class="checkin-record-heading">
              <text class="checkin-record-time">{{record.timeLabel}}</text>
              <view class="checkin-record-actions">
                <text class="checkin-record-duration">{{record.duration}} 分钟</text>
              </view>
            </view>
            <text wx:if="{{record.syncStatusText}}" class="record-sync-error">{{record.syncStatusText}}</text>
            <text wx:elif="{{record.syncError}}" class="record-sync-error">已保存在本机，云端同步失败：{{record.syncError}}</text>
            <view wx:if="{{record.emotion.length}}" class="checkin-record-emotions">
              <text class="checkin-emotion" wx:for="{{record.emotion}}" wx:for-item="emotion" wx:key="*this">{{emotion}}</text>
            </view>
            <view wx:if="{{record.experienceTexts.length}}" class="checkin-record-experience">
              <text class="checkin-record-experience-text" wx:for="{{record.experienceTexts}}" wx:for-item="experience" wx:key="*this">{{experience}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{hiddenCheckinCount > 0}}" class="checkin-list-footer">
        <text class="checkin-load-hint">还有 {{hiddenCheckinCount}} 条更早记录，点击「全部」按月查看</text>
      </view>
    </view>
  </view>

  <!-- 独立遮罩拦截背景滚动，表单内容仍可在弹窗内滚动 -->
  <view wx:if="{{showCheckinModal}}" class="checkin-modal">
    <view class="checkin-modal-mask" bindtap="closeCheckinModal" catchtouchmove="preventCheckinModalTouchMove"></view>
    <view class="checkin-dialog" catchtap="preventCheckinModalTouchMove">
      <view class="checkin-dialog-header">
        <text class="checkin-title">记录静坐</text>
        <button class="checkin-close" bindtap="closeCheckinModal" disabled="{{checkinSubmitting}}" aria-label="关闭记录静坐弹窗" hover-class="checkin-record-active">×</button>
      </view>
      <scroll-view class="checkin-dialog-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="checkin-dialog-body">
          <text class="checkin-subtitle">仅可记录最近三天（含今天），北京时间凌晨 2 点换日</text>
          <view class="checkin-fields-row">
            <view class="checkin-field checkin-date-field">
              <text class="checkin-label">归属日期</text>
              <picker mode="date" value="{{checkinDate}}" start="{{minCheckinDate}}" end="{{maxCheckinDate}}" bindchange="onCheckinDateChange" disabled="{{checkinSubmitting}}">
                <view class="checkin-picker">
                  <text>{{checkinDate}}</text>
                  <text class="checkin-picker-arrow">⌄</text>
                </view>
              </picker>
            </view>
            <view class="checkin-field checkin-time-field">
              <text class="checkin-label">时间</text>
              <picker mode="time" value="{{checkinTime}}" bindchange="onCheckinTimeChange" disabled="{{checkinSubmitting}}">
                <view class="checkin-picker">
                  <text>{{checkinTime < '02:00' ? '次日 ' : ''}}{{checkinTime}}</text>
                  <text class="checkin-picker-arrow">⌄</text>
                </view>
              </picker>
            </view>
          </view>
          <view class="checkin-field">
            <text class="checkin-label">静坐时长</text>
            <view class="checkin-duration-field">
              <input class="checkin-duration-input" type="number" value="{{checkinDuration}}" bindinput="onCheckinDurationInput" maxlength="4" disabled="{{checkinSubmitting}}" cursor-spacing="20" placeholder="请输入静坐时长" placeholder-class="checkin-placeholder" />
              <text class="checkin-unit">分钟</text>
            </view>
          </view>
          <view class="checkin-field">
            <text class="checkin-label">静坐体验 <text class="checkin-optional">（选填）</text></text>
            <textarea class="checkin-experience" value="{{checkinExperience}}" bindinput="onCheckinExperienceInput" maxlength="500" disabled="{{checkinSubmitting}}" cursor-spacing="20" placeholder="记录此刻的感受（选填）" placeholder-class="checkin-placeholder" />
          </view>
        </view>
      </scroll-view>
      <view class="checkin-dialog-actions">
        <button class="checkin-cancel" bindtap="closeCheckinModal" disabled="{{checkinSubmitting}}" hover-class="checkin-record-active">取消</button>
        <button class="checkin-submit" bindtap="submitCheckin" loading="{{checkinSubmitting}}" disabled="{{checkinSubmitting}}" hover-class="checkin-submit-active">打卡记录</button>
      </view>
    </view>
  </view>
</view>
