/* ===== 交互式日历样式 ===== */

/* 日历导航按钮 */
.calendar-nav-btn {
  padding: 8rpx;
  border-radius: 50%;
  background-color: #f8f9fa;
  transition: background-color 0.3s ease;
}

.calendar-nav-btn:active {
  background-color: #e9ecef;
}

/* 日历网格容器 */
.calendar-grid {
  margin-top: 20rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 0 5rpx;
}

/* 日历行 */
.calendar-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  width: 100%;
  box-sizing: border-box;
  height: 40rpx;
  padding: 0 5rpx;
}

/* 日历日期单元格 */
.calendar-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
  position: relative;
  box-sizing: border-box;
  background-color: transparent;
  flex-shrink: 0;
  margin: 0 1rpx;
}

/* 当前月日期 */
.calendar-day.current-month {
  background-color: transparent;
}

.calendar-day.current-month:active {
  background-color: #f8f9fa;
}

/* 非当前月日期 */
.calendar-day.prev-month,
.calendar-day.next-month {
  color: #d0d5db;
}

/* 今日日期 */
.calendar-day.today {
  background-color: #b2976433;
  color: #b29764;
  font-weight: 700;
  border-radius: 50%;
}

/* 已打卡日期 */
.calendar-day.checked {
  background-color: #b297641a;
  color: #b29764;
  font-weight: 700;
}

/* 日期文字 */
.day-text {
  font-size: 24rpx;
  font-family: Arimo;
  line-height: 15rpx;
  color: inherit;
}

/* 打卡图标 - 右上角 */
.check-icon {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #B29764;
  box-shadow: 0rpx 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 静坐打卡按钮容器 */
.meditation-btn-container {
  position: relative;
  z-index: 20;
  margin: 40rpx 28.24rpx 20rpx;
  padding: 10rpx 0;
  background-color: transparent;
  min-height: 80rpx;
}

/* WeUI规范静坐打卡按钮 */
.meditation-btn {
  background-color: #B29764;
  border-radius: 16rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  width: 100%;
  margin-bottom: 0;
}

.meditation-btn:active {
  transform: scale(0.98);
  box-shadow: 0rpx 2rpx 4rpx rgba(178, 151, 100, 0.3);
}

.meditation-btn-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 24rpx;
}

.meditation-btn-text {
  font-size: 38rpx;
  font-family: Arimo;
  font-weight: 600;
  line-height: 1;
}

/* 图例图标样式 */
.check-indicator {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #B29764;
  display: block;
}

.today-indicator {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #F0EAE0;
  display: block;
}

/* 授权按钮样式 */
.auth-button {
  background-color: #b29764 !important;
  color: white !important;
  border-radius: 20rpx !important;
  font-size: 24rpx !important;
  padding: 8rpx 16rpx !important;
  border: none !important;
  line-height: 1.2 !important;
  height: auto !important;
  min-width: 100rpx !important;
}

.auth-button::after {
  border: none !important;
}

.auth-button:active {
  background-color: #9a8254 !important;
  transform: scale(0.95);
}

/* 点击登录文本按钮样式 */
.login-text {
  color: #fffefecc !important;
  font-size: 26rpx !important;
  font-family: Arimo !important;
  line-height: 23.45rpx !important;
  background-color: transparent !important;
  border: 1px solid rgba(255, 255, 255, 0.3) !important;
  border-radius: 20rpx !important;
  padding: 8rpx 16rpx !important;
  margin-left: 15rpx !important;
  text-decoration: none !important;
  cursor: pointer !important;
  transition: all 0.3s ease !important;
  display: inline-block !important;
  min-width: 120rpx !important;
  text-align: center !important;
  position: relative !important;
  z-index: 10 !important;
}

.login-text:active {
  background-color: rgba(255, 255, 255, 0.1) !important;
  transform: scale(0.95) !important;
}

.login-text::after {
  border: none !important;
}

/* 首页静坐记录 */
.checkin-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.checkin-modal-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(29, 40, 56, 0.45);
}

.checkin-dialog {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 680rpx;
  max-height: 86vh;
  background-color: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 60rpx #00000026;
  overflow: hidden;
}

.checkin-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 8rpx 32rpx;
}

.checkin-dialog .checkin-close {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background-color: transparent;
  color: #99a1ae;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 60rpx;
}

.checkin-dialog-scroll {
  height: 620rpx;
  max-height: calc(86vh - 232rpx);
  min-height: 0;
  flex-shrink: 1;
}

.checkin-dialog-body {
  padding: 0 32rpx 28rpx;
}

.checkin-dialog-actions {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 32rpx;
  border-top: 2rpx solid #f2f4f6;
  background-color: #ffffff;
}

.checkin-title {
  display: block;
  color: #354152;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.checkin-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #99a1ae;
  font-size: 24rpx;
  line-height: 1.5;
}

.checkin-fields-row {
  display: flex;
  align-items: flex-start;
}

.checkin-field {
  margin-top: 28rpx;
  min-width: 0;
}

.checkin-date-field {
  flex: 3;
}

.checkin-time-field {
  flex: 2;
  margin-left: 20rpx;
}

.checkin-label {
  display: block;
  margin-bottom: 12rpx;
  color: #596273;
  font-size: 26rpx;
  line-height: 1.4;
}

.checkin-picker,
.checkin-duration-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background-color: #f8fafc;
  border: 2rpx solid #edf0f3;
  border-radius: 12rpx;
  color: #354152;
  font-size: 28rpx;
}

.checkin-picker-arrow {
  margin-left: 12rpx;
  color: #99a1ae;
  font-size: 28rpx;
}

.checkin-duration-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 28rpx;
}

.checkin-unit {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #7a8493;
  font-size: 26rpx;
}

.checkin-placeholder,
.checkin-optional {
  color: #a7afbb;
  font-size: 24rpx;
}

.checkin-experience {
  display: block;
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #edf0f3;
  border-radius: 12rpx;
  background-color: #f8fafc;
  color: #354152;
  font-size: 28rpx;
  line-height: 1.6;
}

.checkin-dialog .checkin-submit,
.checkin-dialog .checkin-cancel {
  flex: 1;
  width: auto;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.checkin-dialog .checkin-submit {
  margin-left: 20rpx;
  background-color: #b29764;
  color: #ffffff;
}

.checkin-dialog .checkin-cancel {
  background-color: #f3f4f6;
  color: #7a8493;
}

.checkin-submit::after,
.checkin-cancel::after,
.checkin-close::after,
.checkin-open::after,
.checkin-load-more::after {
  border: none;
}

.checkin-dialog .checkin-submit.checkin-submit-active,
.checkin-history .checkin-open.checkin-submit-active {
  background-color: #9c8357;
}

.checkin-dialog .checkin-submit[disabled] {
  background-color: #c7b58f;
  color: #ffffff;
}

.checkin-history {
  margin: 40rpx 28.24rpx 0;
}

.checkin-history-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.checkin-history-title {
  min-width: 0;
}

.checkin-total {
  display: block;
  margin-top: 6rpx;
  color: #99a1ae;
  font-size: 24rpx;
  line-height: 1.5;
}

.checkin-history .checkin-open {
  width: auto;
  margin: 0 0 0 24rpx;
  padding: 0 26rpx;
  border-radius: 12rpx;
  background-color: #b29764;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.checkin-empty {
  padding: 64rpx 24rpx;
  border: 2rpx solid #f2f4f6;
  border-radius: 20rpx;
  background-color: #ffffff;
  color: #99a1ae;
  font-size: 28rpx;
  text-align: center;
}

.checkin-record {
  margin-bottom: 12rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid #f2f4f6;
  border-radius: 20rpx;
  background-color: #ffffff;
}

.checkin-record-active {
  background-color: #f7f4ee;
}

.checkin-dialog .checkin-cancel.checkin-record-active,
.checkin-dialog .checkin-close.checkin-record-active {
  background-color: #f7f4ee;
}

.checkin-record-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.checkin-record-datetime {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  align-items: baseline;
  min-width: 0;
}

.checkin-record-date {
  margin-right: 12rpx;
  color: #354152;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
}

.checkin-record-time {
  color: #99a1ae;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.checkin-record-duration {
  flex-shrink: 0;
  color: #b29764;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
}

.checkin-record-emotions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.checkin-emotion {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  background-color: #b2976414;
  color: #a68a57;
  font-size: 24rpx;
  line-height: 1.5;
}

.checkin-record-experience {
  margin-top: 8rpx;
  padding-bottom: 8rpx;
}

.checkin-record-experience-text {
  display: block;
  margin-top: 6rpx;
  color: #7a8493;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.checkin-record-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.checkin-record .checkin-delete {
  width: auto;
  min-width: 72rpx;
  flex-shrink: 0;
  margin: 0 0 0 12rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background-color: transparent;
  color: #99a1ae;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 72rpx;
}

.checkin-record .checkin-delete::after {
  border: none;
}

.checkin-record .checkin-delete.checkin-delete-active {
  background-color: #f2f4f6;
  color: #7a8493;
}

.checkin-record .checkin-delete[disabled] {
  color: #c0c6cf;
  background-color: transparent;
}

.checkin-list-footer {
  padding: 16rpx 0 8rpx;
  text-align: center;
}

.checkin-load-hint {
  display: block;
  color: #a7afbb;
  font-size: 24rpx;
  line-height: 1.5;
}

.checkin-load-more {
  display: inline-block;
  margin-top: 16rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  background-color: #b2976414;
  color: #a68a57;
  font-size: 26rpx;
  line-height: 64rpx;
}
