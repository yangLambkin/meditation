page { background: #f8fafc; color: #354152; }
.settings-page { padding: 36rpx 32rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.settings-title { display: block; font-size: 34rpx; font-weight: 600; line-height: 1.5; }
.settings-subtitle { display: block; margin-top: 12rpx; color: #99a1ae; font-size: 24rpx; line-height: 1.6; }
.settings-card { margin-top: 32rpx; border: 1rpx solid #edf0f3; border-radius: 24rpx; background: #fff; overflow: hidden; }
.settings-card picker + picker { border-top: 1rpx solid #f0f2f5; }
.reminder-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 28rpx; min-height: 132rpx; }
.reminder-row-hover { background: #faf8f3; }
.reminder-copy { flex: 1; min-width: 0; }
.reminder-title { display: block; font-size: 28rpx; line-height: 1.5; }
.reminder-description { display: block; margin-top: 8rpx; color: #99a1ae; font-size: 23rpx; line-height: 1.6; }
.reminder-value { display: flex; align-items: center; gap: 12rpx; color: #a68a57; font-size: 28rpx; }
.reminder-chevron { width: 28rpx; height: 28rpx; opacity: 0.65; }
.settings-hint, .settings-footnote { display: block; color: #99a1ae; font-size: 23rpx; line-height: 1.7; }
.settings-hint { margin: 26rpx 8rpx 0; }
.settings-footnote { margin: 20rpx 8rpx 0; font-size: 22rpx; }
.settings-error { display: block; margin-top: 24rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: #f7f1e7; color: #9c8050; font-size: 25rpx; line-height: 1.6; }
