<view class="settings-page">
  <text class="settings-title">偏好设置</text>
  <text class="settings-subtitle">调整记录偏好。</text>

  <view class="settings-card">
    <view class="settings-row" hover-class="settings-row-hover" bindtap="goToPracticeSettings" aria-role="button" aria-label="记录设置，记录入口与常用功课">
      <view class="settings-icon-wrap">
        <image class="settings-icon" src="/images/icons/practice-records-active.svg" mode="aspectFit" />
      </view>
      <view class="settings-copy">
        <text class="settings-label">记录设置</text>
        <text class="settings-description">记录入口与常用功课</text>
      </view>
      <image class="settings-chevron" src="/images/icons/chevron-right.svg" mode="aspectFit" />
    </view>
  </view>
</view>
