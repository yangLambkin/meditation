@import "../../styles/memberHistory.wxss";

page {
  background-color: #f8fafc;
}

.checkin-history-page {
  padding: 28rpx 28rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.history-navigation {
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.history-view-tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 16rpx;
  background-color: #f2f4f6;
}

.history-navigation .history-view-tabs .history-view-tab {
  flex: 1;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background: transparent;
  color: #8993a1;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 68rpx;
}

.history-navigation .history-view-tabs .history-view-tab-active {
  color: #a68a57;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(53, 65, 82, 0.04);
}

.history-period-navigation {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.history-period-arrow {
  width: 80rpx;
  flex: 0 0 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: transparent;
  color: #b29764;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 80rpx;
}

.history-period-arrow[disabled] {
  color: #d8dce1;
  background: transparent;
}

.history-period-picker {
  flex: 1;
  min-width: 0;
}

.history-period-value {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80rpx;
  color: #a68a57;
  font-size: 32rpx;
  font-weight: 600;
}

.history-picker-chevron {
  margin-left: 12rpx;
  color: #99a1ae;
  font-size: 26rpx;
  font-weight: 400;
}

.history-navigation .history-current-period {
  width: 160rpx;
  margin: 20rpx auto 0;
  padding: 0;
  border-radius: 24rpx;
  background-color: #f7f3eb;
  color: #a68a57;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.history-navigation .history-current-period[disabled] {
  background-color: #f7f3eb;
  color: #b7a47f;
}

.history-view-tab::after,
.history-period-arrow::after,
.history-current-period::after,
.checkin-record-more::after {
  border: none;
}

.history-control-active,
.history-navigation .history-current-period.history-control-active {
  background-color: #f2f4f6;
}

.checkin-history-hint {
  display: block;
  margin-top: 22rpx;
  color: #99a1ae;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.checkin-overview {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 28rpx 16rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.checkin-stat {
  flex: 1;
  text-align: center;
}

.checkin-stat-label {
  color: #99a1ae;
  font-size: 24rpx;
  line-height: 1.5;
}

.checkin-stat-value {
  margin-top: 10rpx;
  color: #b29764;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.checkin-stat-unit {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
}

.checkin-stat-divider {
  width: 2rpx;
  height: 64rpx;
  background-color: #f2f4f6;
}

.checkin-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 4rpx 12rpx;
}

.checkin-section-title {
  color: #596273;
  font-size: 27rpx;
  font-weight: 500;
}

.checkin-section-summary {
  color: #99a1ae;
  font-size: 23rpx;
}

.checkin-day-group {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.checkin-day-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 8rpx 4rpx 16rpx;
  border-radius: 10rpx;
}

.checkin-day-date {
  margin-right: 16rpx;
  color: #596273;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.5;
}

.checkin-day-summary {
  display: flex;
  align-items: center;
  color: #99a1ae;
  font-size: 23rpx;
  line-height: 1.5;
}

.checkin-day-chevron {
  margin-left: 12rpx;
  color: #aab1bc;
  font-size: 30rpx;
}

.checkin-empty {
  margin-top: 12rpx;
  padding: 64rpx 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  text-align: center;
}

.checkin-empty-title {
  display: block;
  color: #7a8493;
  font-size: 28rpx;
}

.checkin-empty-hint {
  display: block;
  margin-top: 16rpx;
  color: #aab1bc;
  font-size: 24rpx;
  line-height: 1.6;
}

.checkin-record {
  margin-bottom: 16rpx;
  padding: 20rpx 28rpx 26rpx;
  border: 2rpx solid #f0f2f5;
  border-radius: 20rpx;
  background-color: #ffffff;
}

.checkin-record-active {
  background-color: #f7f4ee;
}

.checkin-record-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.checkin-record-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
}

.checkin-record-time {
  color: #99a1ae;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.checkin-record-duration {
  color: #354152;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
}

.checkin-record .checkin-record-more {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin: 0 -12rpx 0 8rpx;
  padding: 0;
  border-radius: 12rpx;
  background-color: transparent;
  color: #99a1ae;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 64rpx;
  letter-spacing: 3rpx;
}

.checkin-record .checkin-record-more[disabled] {
  color: #c0c6cf;
  background-color: transparent;
}

.checkin-record-emotions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.checkin-emotion {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  background-color: #f2f4f6;
  color: #7a8493;
  font-size: 23rpx;
  line-height: 1.5;
}

.checkin-record-experience {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #f2f4f6;
}

.checkin-record-experience-text {
  display: block;
  margin-top: 6rpx;
  color: #7a8493;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
