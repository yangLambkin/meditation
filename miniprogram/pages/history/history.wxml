<import src="../../templates/memberHistory.wxml" />
<view class="history-page">
  <template is="member-history-header" data="{{isMemberHistory, memberName, memberAvatar, memberStartDate}}" />
  <view class="history-navigation">
    <view class="history-tabs">
      <view class="history-tab history-tab-active" aria-role="button" aria-label="按日查看，已选中">按日</view>
      <button class="history-tab" bindtap="openMonthlyHistory" hover-class="history-tab-hover">按月</button>
    </view>
    <view class="date-navigation">
      <button class="date-arrow" bindtap="previousDay" disabled="{{!canGoPrevious}}" aria-label="上一日" hover-class="date-button-hover">‹</button>
      <picker class="date-picker" mode="date" value="{{selectedDateKey}}" start="{{memberStartDate}}" end="{{todayDate}}" bindchange="onDateChange" aria-label="选择日期">
        <view class="date-picker-value"><text>{{selectedDate}}</text></view>
      </picker>
      <button class="date-arrow" bindtap="nextDay" disabled="{{!canGoNext}}" aria-label="下一日" hover-class="date-button-hover">›</button>
    </view>
    <text class="lunar-date">{{lunarDate}}</text>
  </view>

  <template is="member-history-status" data="{{isMemberHistory, memberLoading, memberError}}" />
  <block wx:if="{{!isMemberHistory || (!memberLoading && !memberError)}}">
  <view class="history-summary">
    <view class="summary-item">
      <text class="summary-label">当日打卡</text>
      <view class="summary-value"><text class="summary-number">{{recordCount}}</text><text class="summary-unit">次</text></view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-label">静坐时长</text>
      <view class="summary-value"><text class="summary-number">{{totalDuration}}</text><text class="summary-unit">分钟</text></view>
    </view>
  </view>

  <view class="records-heading"><text>静坐记录</text><text class="records-order" wx:if="{{recordCount}}">时间从近到远</text></view>
  <view class="empty-records" wx:if="{{!loadingRecords && !recordCount}}">
    <text class="empty-records-title">当天暂无静坐记录</text>
    <text class="empty-records-description">可以切换日期，回看每一次静坐。</text>
  </view>
  <view class="record-card" wx:for="{{recordList}}" wx:for-item="record" wx:key="recordKey">
    <view class="record-heading">
      <view class="record-title"><text class="record-duration">{{record.duration}}<text class="record-duration-unit"> 分钟</text></text><text class="record-time">{{record.timeLabel}}</text></view>
      <button wx:if="{{!isMemberHistory}}" class="record-more" catchtap="showRecordActions" data-record-key="{{record.recordKey}}" disabled="{{deleteBusy}}" loading="{{deletingRecordKey === record.recordKey}}" aria-label="{{record.timeLabel}} 静坐记录的更多操作" hover-class="record-more-hover">···</button>
    </view>
    <view class="emotion-tags" wx:if="{{record.emotion.length}}">
      <text class="emotion-tag" wx:for="{{record.emotion}}" wx:for-item="emotion" wx:key="*this">{{emotion}}</text>
    </view>
    <view class="record-experience" wx:if="{{record.experienceTexts.length}}">
      <text class="experience-text" wx:for="{{record.experienceTexts}}" wx:for-item="experience" wx:key="*this">{{experience}}</text>
    </view>
  </view>
  </block>
</view>
