@import "../../styles/memberHistory.wxss";

page {
  background-color: #f8fafc;
}

.history-page {
  padding: 28rpx 28rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.history-navigation {
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.history-tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 16rpx;
  background-color: #f2f4f6;
}

.history-tabs .history-tab {
  flex: 1;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background-color: transparent;
  color: #7a8493;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 68rpx;
  text-align: center;
}

.history-tabs .history-tab-active {
  background-color: #ffffff;
  color: #a68a57;
  box-shadow: 0 2rpx 8rpx #35415208;
}

.history-tab::after,
.date-arrow::after,
.record-more::after {
  border: none;
}

.date-navigation {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.date-navigation .date-arrow {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background-color: transparent;
  color: #a68a57;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 74rpx;
}

.date-navigation .date-arrow[disabled] {
  background-color: transparent;
  color: #d9dde3;
}

.date-picker {
  flex: 1;
  min-width: 0;
}

.date-picker-value {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  color: #a68a57;
  font-size: 32rpx;
  font-weight: 600;
  white-space: nowrap;
}

.lunar-date {
  display: block;
  color: #99a1ae;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

.history-summary {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 28rpx 16rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  color: #99a1ae;
  font-size: 24rpx;
  line-height: 1.5;
}

.summary-value {
  margin-top: 10rpx;
  color: #b29764;
}

.summary-number {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}

.summary-unit {
  margin-left: 8rpx;
  color: #b5a483;
  font-size: 23rpx;
}

.summary-divider {
  width: 2rpx;
  height: 64rpx;
  background-color: #f2f4f6;
}

.records-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32rpx 8rpx 18rpx;
  color: #596273;
  font-size: 27rpx;
  font-weight: 500;
}

.records-order {
  color: #a4acb8;
  font-size: 22rpx;
  font-weight: 400;
}

.record-card {
  margin-top: 16rpx;
  padding: 20rpx 28rpx 26rpx;
  border: 2rpx solid #f0f2f5;
  border-radius: 20rpx;
  background-color: #ffffff;
}

.record-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-title {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.record-duration {
  color: #354152;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.record-duration-unit {
  font-size: 26rpx;
  font-weight: 500;
}

.record-time {
  margin-left: 20rpx;
  color: #99a1ae;
  font-size: 23rpx;
  line-height: 1.5;
}

.record-card .record-more {
  width: 64rpx;
  height: 64rpx;
  margin: 0 -12rpx 0 12rpx;
  padding: 0;
  border-radius: 12rpx;
  background-color: transparent;
  color: #99a1ae;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 60rpx;
}

.record-card .record-more[disabled] {
  background-color: transparent;
  color: #c0c6cf;
}

.record-card .record-more-hover,
.history-tabs .history-tab-hover,
.history-navigation .date-button-hover {
  background-color: #f2f4f6;
}

.emotion-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.emotion-tag {
  margin: 0 10rpx 6rpx 0;
  padding: 5rpx 16rpx;
  border-radius: 20rpx;
  background-color: #f7f3eb;
  color: #a68a57;
  font-size: 23rpx;
  line-height: 1.5;
}

.record-experience {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #f5f6f8;
}

.experience-text {
  display: block;
  margin-top: 4rpx;
  color: #7a8493;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.empty-records {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 24rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
}

.empty-records-title {
  color: #596273;
  font-size: 28rpx;
}

.empty-records-description {
  margin-top: 16rpx;
  color: #99a1ae;
  font-size: 24rpx;
}
