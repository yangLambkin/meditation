page { background: #f8fafc; color: #354152; }
button::after { border: none; }
button { font-weight: 500; }
.practice-page { padding: 28rpx 32rpx calc(48rpx + 50px); padding-bottom: calc(48rpx + 50px + env(safe-area-inset-bottom)); }
.page-heading, .record-heading, .card-heading, .day-heading, .dialog-header, .pending-heading, .pending-item { display: flex; justify-content: space-between; align-items: center; }
.page-heading { gap: 20rpx; min-height: 76rpx; margin-bottom: 28rpx; }
.heading-copy { flex: 1; min-width: 0; }
.page-title { display: block; color: #354152; font-size: 36rpx; line-height: 1.4; font-weight: 600; }
button.add-button { flex: none; width: 208rpx; min-width: 0; height: 76rpx; margin: 0; padding: 0; line-height: 76rpx; background: #b29764; border-radius: 16rpx; color: #fff; font-size: 27rpx; }
button.add-button-disabled { color: #fff; background: #cbbda3; }
.history-notice { display: flex; align-items: center; gap: 20rpx; margin-top: 28rpx; padding: 24rpx 4rpx; border-top: 1rpx solid #e9ecf0; }
.history-copy { flex: 1; min-width: 0; }
.history-title { display: block; font-size: 25rpx; color: #7a8493; line-height: 1.5; }
.history-caption { display: block; margin-top: 6rpx; font-size: 22rpx; color: #99a1ae; line-height: 1.6; }
.history-entry { display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; min-width: 100rpx; min-height: 80rpx; padding-left: 12rpx; font-size: 25rpx; color: #9c8050; }
.history-arrow { font-size: 34rpx; }
.pending-card { margin-bottom: 28rpx; padding: 24rpx; border-radius: 20rpx; background: #fff7e9; color: #8b642f; }
.pending-heading { font-size: 26rpx; font-weight: 600; margin-bottom: 8rpx; }
.caption { display: block; color: #99a1ae; font-size: 23rpx; line-height: 1.6; }
.pending-card .caption { color: #a0855b; }
.pending-item { gap: 20rpx; padding: 20rpx 0; border-top: 1rpx solid #ede2ce; }
.pending-item:first-of-type { margin-top: 16rpx; }
.pending-item > view { min-width: 0; flex: 1; }
.pending-item .caption { word-break: break-all; }
.pending-name { font-size: 25rpx; }
.inline-button { width: auto; margin: 0; padding: 0 18rpx; background: transparent; color: #a18552; font-size: 24rpx; line-height: 60rpx; }
.retry-button { background: #fff; border-radius: 12rpx; margin: 16rpx 0 0 auto; width: 168rpx; }
.pending-delete { color: #b46f5e; }
.filters { display: flex; gap: 16rpx; margin-top: 20rpx; }
.filters picker { flex: 1; min-width: 0; }
.filter-pill { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 80rpx; padding: 18rpx 24rpx; background: #fff; border: 2rpx solid #edf0f3; border-radius: 16rpx; font-size: 27rpx; line-height: 1.5; }
.filter-pill > text { flex: 1; min-width: 0; }
button.type-filter { flex: 1; min-width: 0; width: auto; margin: 0; color: #354152; font-weight: 500; text-align: left; }
button.type-filter-active { color: #9c8050; border-color: #e5d9c2; background: #faf7f0; }
button.filter-pill-hover { background: #f5f1e8; }
.type-filter-active .filter-chevron { border-color: #b29764; }
.filter-chevron { flex-shrink: 0; width: 13rpx; height: 13rpx; margin: -6rpx 3rpx 0 4rpx; border-right: 2rpx solid #99a1ae; border-bottom: 2rpx solid #99a1ae; transform: rotate(45deg); }
.picker-arrow { color: #a8a49a; margin-left: 14rpx; }
.view-tabs { display: flex; padding: 6rpx; background: #fff; border: 1rpx solid #edf0f3; border-radius: 20rpx; }
button.view-tab { flex: 1; width: auto; min-width: 0; margin: 0; padding: 0 12rpx; border-radius: 16rpx; text-align: center; line-height: 72rpx; background: transparent; font-size: 28rpx; color: #8c949e; font-weight: 500; }
button.view-tab.selected { color: #a68a57; background: #f5f1e8; font-weight: 600; }
.date-filter-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: 16rpx 4rpx 0; }
.selected-date { color: #7a8493; font-size: 25rpx; }
.day-group { margin-top: 22rpx; }
.day-heading { gap: 16rpx; font-size: 26rpx; font-weight: 500; padding: 0 4rpx 12rpx; }
.day-heading-copy { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; flex: 1; min-width: 0; }
.day-heading .caption { font-weight: normal; }
button.day-stats-button { display: flex; align-items: center; flex-shrink: 0; gap: 10rpx; margin: 0; padding: 0 8rpx 0 16rpx; min-height: 64rpx; line-height: 64rpx; border-radius: 12rpx; background: transparent; color: #9c8050; font-size: 24rpx; font-weight: 500; }
button.day-stats-button-hover { background: #f5f1e8; }
.day-stats-arrow { color: #b29764; font-size: 30rpx; }
.record-card { margin: 0 0 16rpx; padding: 28rpx; background: #fff; border-radius: 20rpx; border: 2rpx solid #f0f2f5; }
.card-hover { background: #f7f4ee; }
.record-name { color: #354152; font-size: 28rpx; font-weight: 600; }
.record-time { color: #a1a8b2; font-size: 23rpx; margin-left: 18rpx; }
.record-amount { font-size: 34rpx; color: #a78a56; font-weight: 600; }
.record-unit { font-size: 23rpx; color: #a78a56; margin-left: 8rpx; }
.chevron { color: #bbc0c5; font-size: 32rpx; margin-left: 22rpx; }
.record-preview { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 16rpx; font-size: 25rpx; color: #7a8493; line-height: 1.65; word-break: break-all; }
.source-tag { display: inline-block; margin-top: 15rpx; padding: 5rpx 12rpx; color: #968261; font-size: 21rpx; background: #f5f1e8; border-radius: 7rpx; }
.empty-state { padding: 84rpx 24rpx; text-align: center; font-size: 27rpx; color: #8c949e; line-height: 1.6; }
.empty-state > text { display: block; }
.empty-state .caption { margin-top: 12rpx; }
.empty-symbol { font-size: 64rpx; color: #c5b592; margin-bottom: 16rpx; }
.state-card { margin: 20rpx 0; padding: 32rpx; border-radius: 24rpx; background: #fff; }
.state-title { display: block; font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.state-message { display: block; color: #7a8493; font-size: 25rpx; line-height: 1.7; word-break: break-all; }
.outline-button { margin: 24rpx 0 0; padding: 0 24rpx; border: 1rpx solid #d9cdb6; border-radius: 12rpx; color: #9c8050; background: #faf8f3; font-size: 25rpx; line-height: 70rpx; }
.error-card { padding: 48rpx 32rpx; text-align: center; }
.state-icon { display: block; width: 64rpx; height: 64rpx; margin: 0 auto 24rpx; }
.error-card .state-message { max-width: 500rpx; margin: 0 auto; }
button.state-button { display: block; width: 224rpx; max-width: 100%; margin: 28rpx auto 0; padding: 0 20rpx; line-height: 68rpx; border-radius: 34rpx; }
.list-footer { padding: 24rpx 0; text-align: center; }
.stats-card { padding: 28rpx; margin-top: 24rpx; background: #fff; border-radius: 24rpx; border: 1rpx solid #edf0f3; }
.card-title { display: block; font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
.month-overview { display: flex; gap: 32rpx; padding: 30rpx 8rpx 4rpx; }
.overview-stat { flex: 1; min-width: 0; }
.overview-value { margin-top: 10rpx; line-height: 1.3; }
.overview-name { display: block; color: #354152; font-size: 34rpx; font-weight: 500; line-height: 62rpx; }
.month-overview .stat-number { display: inline; color: #354152; font-size: 48rpx; font-weight: 500; line-height: 1.3; }
.stat-unit { margin-left: 10rpx; color: #8c949e; font-size: 24rpx; }
.headline-stats { display: flex; padding: 22rpx 0 30rpx; }
.headline-stats > view { flex: 1; }
.headline-stats > view + view { border-left: 1rpx solid #ece9e2; padding-left: 38rpx; }
.stat-number { display: block; font-size: 56rpx; color: #a78a56; line-height: 1.4; font-weight: 500; }
.metric-grid { display: flex; flex-wrap: wrap; border-top: 1rpx solid #f0ede7; }
.metric { width: 33.333%; box-sizing: border-box; padding: 28rpx 8rpx 12rpx 0; }
.metric-name { display: block; color: #8c949e; font-size: 23rpx; margin-bottom: 10rpx; }
.metric-value { color: #596273; font-size: 31rpx; font-weight: 600; }
.metric-unit { font-size: 21rpx; margin-left: 7rpx; color: #8c949e; }
.metric-month { display: block; margin-top: 10rpx; font-size: 22rpx; color: #8c949e; line-height: 1.5; }
.stats-note { display: block; margin-top: 24rpx; font-size: 22rpx; color: #a2a8b0; line-height: 1.65; }
.calendar-card { padding: 28rpx 24rpx 26rpx; border-color: #e5d9c2; border-radius: 28rpx; }
.weekdays, .calendar-week { display: flex; }
.weekdays { margin: 0 0 14rpx; }
.weekdays > text { width: 14.2857%; text-align: center; color: #8a795a; font-size: 24rpx; line-height: 36rpx; }
.calendar-cell { flex: 0 0 14.2857%; min-width: 0; height: 112rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 14rpx; }
.calendar-cell-hover { background: #faf7f0; }
.calendar-day { flex-shrink: 0; width: 54rpx; height: 54rpx; border-radius: 50%; color: #354152; text-align: center; font-size: 28rpx; line-height: 54rpx; font-weight: 500; }
.calendar-level-1 { background: #f7f4ee; }
.calendar-level-2 { background: #eee7d9; }
.calendar-level-3 { background: #dfd2b8; }
.calendar-level-4 { background: #c7b58f; }
.calendar-level-5 { color: #fff; background: #8c7345; }
.calendar-amount { display: block; min-height: 28rpx; max-width: 100%; margin-top: 4rpx; color: #9c8050; font-size: 21rpx; line-height: 28rpx; white-space: nowrap; font-variant-numeric: tabular-nums; }
.calendar-selected .calendar-day { outline: 2rpx solid #b29764; outline-offset: 3rpx; }
.is-today .calendar-day { box-shadow: inset 0 0 0 2rpx #b29764; font-weight: 700; }
.future .calendar-day { color: #cbbda3; }
.calendar-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }
.calendar-legend { display: flex; align-items: center; gap: 6rpx; flex-shrink: 0; color: #8a795a; font-size: 20rpx; line-height: 30rpx; }
.calendar-swatch { width: 14rpx; height: 14rpx; border-radius: 4rpx; }
.calendar-hint { color: #8a795a; font-size: 21rpx; line-height: 1.6; }
.trend-scroll { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.trend-chart { display: flex; }
.trend-column { flex-shrink: 0; width: 54rpx; text-align: center; }
.trend-bar-area { height: 176rpx; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; border-bottom: 1rpx solid #e9ecf0; }
.trend-bar { width: 22rpx; flex-shrink: 0; border-radius: 6rpx 6rpx 0 0; background: #b29764; }
.trend-zero { background: #e6e1d8; }
.trend-value { color: #a68a57; font-size: 18rpx; line-height: 30rpx; }
.trend-day { display: block; color: #99a1ae; font-size: 21rpx; line-height: 46rpx; }
.modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 32rpx; }
.modal-mask { position: absolute; inset: 0; background: rgba(29, 40, 56, .45); }
.dialog { position: relative; display: flex; flex-direction: column; width: 100%; max-width: 680rpx; max-height: 88vh; overflow: hidden; background: #fff; border-radius: 28rpx; box-shadow: 0 20rpx 60rpx #00000026; }
.dialog-header { align-items: flex-start; gap: 24rpx; padding: 28rpx 24rpx 16rpx 32rpx; }
.dialog-heading { flex: 1; min-width: 0; padding-top: 6rpx; }
.dialog-title { display: block; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
button.close-button { display: flex; align-items: center; justify-content: center; flex: 0 0 88rpx; width: 88rpx; min-width: 88rpx; height: 88rpx; padding: 0; margin: 0; box-sizing: border-box; border-radius: 50%; color: #7a8493; background: #f3f4f6; line-height: 1; }
button.close-button-hover { color: #596273; background: #e9ecf0; }
button.close-button[disabled] { color: #b5bbc3; background: #f8fafc; }
.close-icon { position: relative; width: 28rpx; height: 28rpx; }
.close-icon::before, .close-icon::after { content: ''; position: absolute; top: 50%; left: 0; width: 28rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; transform: translateY(-50%) rotate(45deg); }
.close-icon::after { transform: translateY(-50%) rotate(-45deg); }
.dialog-scroll { height: 680rpx; max-height: calc(88vh - 240rpx); min-height: 0; flex-shrink: 1; }
.dialog-body { padding: 0 32rpx 28rpx; }
.day-stats-dialog .dialog-header { align-items: center; padding-bottom: 20rpx; }
.day-stats-date { display: block; margin-top: 6rpx; }
.day-stats-scroll { height: 710rpx; max-height: calc(88vh - 156rpx); }
.day-stats-body { padding: 0 32rpx 24rpx; }
.day-stats-overview { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0 24rpx; color: #8c949e; font-size: 24rpx; line-height: 36rpx; }
.day-stats-dot { color: #c8cdd3; }
.day-stats-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 88rpx; border-top: 1rpx solid #f0f2f5; }
.day-stats-name { flex: 1; min-width: 0; color: #596273; font-size: 27rpx; }
.day-stats-quantity { display: flex; align-items: baseline; gap: 10rpx; }
.day-stats-value { color: #9c8050; font-size: 34rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.day-stats-unit { min-width: 48rpx; color: #8c949e; font-size: 23rpx; }
.day-stats-zero .day-stats-value, .day-stats-zero .day-stats-unit { color: #b5bbc3; }
.day-stats-note { display: block; margin-top: 22rpx; color: #99a1ae; font-size: 22rpx; line-height: 34rpx; }
.day-stats-state { padding: 64rpx 32rpx; text-align: center; color: #8c949e; font-size: 26rpx; line-height: 1.7; }
.privacy-notice { margin: 12rpx 0 20rpx; padding: 18rpx 20rpx; color: #8a7145; background: #f7f2e8; border-radius: 12rpx; font-size: 23rpx; line-height: 1.65; }
.privacy-notice > text { display: block; }
.field-row { display: flex; gap: 18rpx; }
.field-date { flex: 3; }
.field-time { flex: 2; }
.field { margin-top: 26rpx; min-width: 0; }
.label { display: block; font-size: 26rpx; color: #596273; margin-bottom: 12rpx; }
.field-control { height: 84rpx; padding: 0 20rpx; display: flex; justify-content: space-between; align-items: center; border: 2rpx solid #edf0f3; border-radius: 12rpx; background: #f8fafc; font-size: 28rpx; box-sizing: border-box; }
.field-time .field-control { padding: 0 14rpx; font-size: 25rpx; }
.amount-input { flex: 1; min-width: 0; height: 82rpx; font-size: 28rpx; }
.field-unit { flex-shrink: 0; color: #8c949e; font-size: 25rpx; margin-left: 16rpx; }
.field-hint { margin-top: 10rpx; }
.textarea { width: 100%; height: 180rpx; padding: 20rpx; box-sizing: border-box; border: 2rpx solid #edf0f3; border-radius: 12rpx; background: #f8fafc; font-size: 28rpx; color: #354152; line-height: 1.6; }
.content-textarea { height: 150rpx; }
.optional { color: #a7afbb; font-size: 23rpx; margin-left: 10rpx; }
.required { color: #a08450; font-size: 23rpx; margin-left: 10rpx; }
.word-count { display: block; text-align: right; margin-top: 8rpx; color: #a7afbb; font-size: 21rpx; }
.form-error { display: block; margin: 22rpx 0 14rpx; color: #a76b3c; background: #fff7eb; padding: 18rpx; border-radius: 12rpx; font-size: 24rpx; line-height: 1.6; word-break: break-all; }
.dialog-footer { display: flex; gap: 20rpx; padding: 24rpx 32rpx 32rpx; border-top: 1rpx solid #f0ede8; }
.primary-button, .secondary-button, .danger-button { flex: 1; margin: 0; border-radius: 14rpx; padding: 0 24rpx; font-size: 30rpx; font-weight: 600; line-height: 84rpx; }
.primary-button { color: #fff; background: #b29764; }
.primary-button-disabled { color: #fff; background: #c7b58f; }
.secondary-button { color: #7a8493; background: #f3f4f6; }
.danger-button { color: #b46f5e; background: #fbf1ed; }
.full-button { width: 100%; }
.detail-amount { padding: 20rpx 0 4rpx; color: #a78a56; font-size: 64rpx; font-weight: 500; }
.detail-unit { font-size: 27rpx; margin-left: 12rpx; }
.detail-date { display: block; font-size: 24rpx; color: #99a1ae; margin-bottom: 28rpx; }
.detail-section { margin-top: 30rpx; }
.detail-text { display: block; white-space: pre-wrap; word-break: break-all; font-size: 27rpx; line-height: 1.8; color: #596273; }
.muted { color: #a7afbb; }
@media (max-height: 600px) { .dialog-scroll { max-height: calc(88vh - 230rpx); } .dialog-header { padding-top: 18rpx; } .dialog-footer { padding-top: 18rpx; padding-bottom: 22rpx; } }
