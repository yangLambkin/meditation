<template name="read-failure">
  <view class="state-card error-card">
    <image class="state-icon" src="/images/icons/info.svg" aria-hidden="true" />
    <text class="state-title">{{failure.title}}</text>
    <text class="state-message">{{failure.message}}</text>
    <button size="mini" class="outline-button state-button" bindtap="handleReadFailure" data-scope="{{scope}}">{{failure.actionText}}</button>
  </view>
</template>

<view class="practice-page">
  <view class="page-heading">
    <view class="heading-copy"><text class="page-title">功课记录</text></view>
    <button size="mini" class="add-button {{!enabled ? 'add-button-disabled' : ''}}" bindtap="choosePractice" disabled="{{!enabled}}" aria-label="记录一份功课">＋ 记录功课</button>
  </view>

  <view wx:if="{{!enabled}}" class="state-card">
    <text class="state-title">功课记录准备中</text>
    <text class="state-message">这里即将支持更多功课的记录与统计。现在可以继续记录静坐。</text>
    <button class="outline-button" bindtap="openSittingForm">记录静坐</button>
  </view>

  <block wx:if="{{enabled}}">
    <view wx:if="{{pendingCount}}" class="pending-card">
      <view class="pending-heading" bindtap="togglePending"><text>{{pendingCount}} 条功课记录待上传</text><text>{{showPending ? '收起' : '查看'}} ›</text></view>
      <text class="caption">静坐原记录保存结果不受影响。待上传记录不计入下方统计。</text>
      <block wx:if="{{showPending}}">
        <view class="pending-item" wx:for="{{pending}}" wx:key="id">
          <view><text class="pending-name">{{item.typeName}} · {{item.dateLabel}}</text><text class="caption">{{item.operation === 'delete' ? '删除 · ' : item.operation === 'update' ? '更新 · ' : ''}}{{item.stateText}}</text></view>
          <button wx:if="{{item.canCancel}}" class="inline-button" data-id="{{item.id}}" bindtap="cancelPending">取消</button>
          <button wx:elif="{{item.canDeletePending}}" class="inline-button pending-delete" data-id="{{item.id}}" bindtap="deletePending" loading="{{pendingActionId === item.id}}" disabled="{{!!pendingActionId}}">删除</button>
          <text wx:elif="{{item.deletionQueued}}" class="caption">待删除</text>
        </view>
      </block>
      <button class="inline-button retry-button" bindtap="retryPending" loading="{{retrying}}" disabled="{{retrying}}">重试上传</button>
    </view>

    <view class="records-toolbar">
      <view class="view-tabs">
        <button size="mini" class="view-tab {{view === 'detail' ? 'selected' : ''}}" bindtap="changeView" data-view="detail" aria-label="功课明细">明细</button>
        <button size="mini" class="view-tab {{view === 'stats' ? 'selected' : ''}}" bindtap="changeView" data-view="stats" aria-label="功课统计">统计</button>
      </view>
      <view class="filters">
        <button class="filter-pill type-filter {{type !== 'all' ? 'type-filter-active' : ''}}" bindtap="openTypePicker" hover-class="filter-pill-hover" aria-label="{{'筛选功课类型，当前' + typeOptions[typeIndex].name}}" aria-expanded="{{showTypePicker}}"><text>{{typeOptions[typeIndex].name}}</text><view class="filter-chevron" aria-hidden="true"></view></button>
        <picker mode="date" fields="month" value="{{month}}" end="{{today}}" bindchange="onMonthChange" aria-label="筛选月份"><view class="filter-pill"><text>{{monthLabel}}</text><view class="filter-chevron" aria-hidden="true"></view></view></picker>
      </view>
    </view>

    <view wx:if="{{view === 'detail'}}">
      <view wx:if="{{selectedDate && !loading && !error}}" class="date-filter-row">
        <text class="selected-date">{{selectedDate}}</text>
        <button size="mini" class="inline-button" bindtap="clearDate">查看整月</button>
      </view>
      <view wx:if="{{loading}}" class="empty-state">正在读取功课…</view>
      <template wx:elif="{{error}}" is="read-failure" data="{{failure: feedFailure, scope: 'feed'}}" />
      <view wx:elif="{{loaded && !records.length}}" class="empty-state"><text class="empty-symbol">○</text><text>这{{selectedDate ? '一天' : '个月'}}还没有已上传的功课</text><text class="caption">每一份练习，都值得记录</text></view>
      <view class="day-group" wx:for="{{groups}}" wx:for-item="group" wx:key="date">
        <view class="day-heading"><text>{{group.date}}</text><text class="caption">{{group.records.length}} 条{{nextCursor ? '已载入' : ''}}</text></view>
        <view class="record-card" wx:for="{{group.records}}" wx:for-item="record" wx:key="key" bindtap="openDetail" data-key="{{record.key}}" hover-class="card-hover">
          <view class="record-heading"><view><text class="record-name">{{record.typeName}}</text><text class="record-time">{{record.timeLabel}}</text></view><view><text class="record-amount">{{record.quantity}}</text><text class="record-unit">{{record.unit}}</text><text class="chevron">›</text></view></view>
          <text wx:if="{{record.preview}}" class="record-preview">{{record.preview}}</text>
          <text wx:if="{{record.mirrored}}" class="source-tag">来自静坐记录</text>
        </view>
      </view>
      <view wx:if="{{records.length}}" class="list-footer"><button wx:if="{{nextCursor}}" class="inline-button" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button><text wx:else class="caption">已显示当前筛选下全部记录</text></view>
    </view>

    <view wx:if="{{view === 'stats'}}">
      <view wx:if="{{summaryLoading}}" class="empty-state">正在读取统计…</view>
      <template wx:elif="{{summaryError}}" is="read-failure" data="{{failure: summaryFailure, scope: 'summary'}}" />
      <block wx:elif="{{summary}}">
        <view wx:if="{{type === 'all'}}" class="stats-card practice-overview-card">
          <view class="practice-overview-header"><text>功课名称</text><text>本月记录件数</text></view>
          <view wx:for="{{monthCards}}" wx:key="type" class="practice-overview-row">
            <text class="practice-overview-name">{{item.name}}</text>
            <view><text class="practice-overview-value">{{item.records}}</text><text class="practice-overview-unit">件</text></view>
          </view>
        </view>
        <view wx:else class="month-overview">
          <view class="overview-stat"><text class="caption">功课名称</text><view class="overview-value"><text class="overview-name">{{typeOptions[typeIndex].name}}</text></view></view>
          <view class="overview-stat"><text class="caption">{{overviewLabel}}</text><view class="overview-value"><text class="stat-number">{{overviewTotal}}</text><text class="stat-unit">{{overviewUnit}}</text></view></view>
        </view>

        <view class="stats-card calendar-card">
          <view class="weekdays"><text>周一</text><text>周二</text><text>周三</text><text>周四</text><text>周五</text><text>周六</text><text>周日</text></view>
          <view class="calendar-week" wx:for="{{calendar}}" wx:for-item="week" wx:for-index="weekIndex" wx:key="weekIndex">
            <view class="calendar-cell {{day.active ? 'has-practice' : ''}} {{day.selected ? 'calendar-selected' : ''}} {{day.today ? 'is-today' : ''}} {{day.future ? 'future' : ''}}" wx:for="{{week}}" wx:for-item="day" wx:key="key" data-date="{{day.date}}" bindtap="selectCalendarDay" hover-class="{{!day.empty && !day.future ? 'calendar-cell-hover' : 'none'}}" aria-role="{{!day.empty && !day.future ? 'button' : ''}}" aria-label="{{day.empty ? '' : day.future ? day.date + '，尚未到来' : day.date + '，当天累计' + day.value + selectedMonthUnit + '，点击查看当日明细'}}">
              <text wx:if="{{!day.empty}}" class="calendar-day calendar-level-{{day.level}}">{{day.day}}</text>
              <text wx:if="{{!day.empty}}" class="calendar-amount">{{!day.future && day.value > 0 ? '+' + day.valueLabel + (type === 'all' ? '件' : '') : ''}}</text>
            </view>
          </view>
          <view class="calendar-footer">
            <view class="calendar-legend" aria-label="颜色越深表示当天累计越多"><text>少</text><view class="calendar-swatch calendar-level-1"></view><view class="calendar-swatch calendar-level-2"></view><view class="calendar-swatch calendar-level-3"></view><view class="calendar-swatch calendar-level-4"></view><view class="calendar-swatch calendar-level-5"></view><text>多</text></view>
            <text class="calendar-hint">{{type === 'all' ? '记录件数 · 点击日期查看详情' : '点击日期查看详情'}}</text>
          </view>
        </view>

        <view wx:if="{{type !== 'all'}}" class="stats-card trend-card">
          <view class="card-heading"><text class="card-title">每日完成量趋势</text><text class="caption">{{typeOptions[typeIndex].unit}} / 日</text></view>
          <text class="caption">本月最高 {{trendMax}} {{typeOptions[typeIndex].unit}}</text>
          <scroll-view scroll-x="{{true}}" class="trend-scroll" aria-label="{{month}}每日{{typeOptions[typeIndex].name}}完成量，左右滑动查看整月">
            <view class="trend-chart" style="width: {{trendWidth}}rpx;">
              <view class="trend-column" wx:for="{{trend}}" wx:key="date" data-date="{{item.date}}" bindtap="selectCalendarDay" aria-role="button" aria-label="{{item.date}}，{{item.value}}{{typeOptions[typeIndex].unit}}，点击查看当日明细">
                <view class="trend-bar-area"><text wx:if="{{item.value}}" class="trend-value">{{item.label}}</text><view class="trend-bar {{!item.value ? 'trend-zero' : ''}}" style="height: {{item.height}}rpx;"></view></view>
                <text class="trend-day">{{item.day}}</text>
              </view>
            </view>
          </scroll-view>
          <text class="stats-note">左右滑动查看整月，点选柱形查看当日明细。无记录日期记为 0。</text>
        </view>
        <view class="stats-card">
          <text class="card-title">已上传功课累计</text><text class="caption">当前功课筛选下，已上传记录的累计</text>
          <view class="headline-stats"><view><text class="stat-number">{{allTimePracticeDays}}</text><text class="caption">功课天数</text></view><view><text class="stat-number">{{allTimeRecordCount}}</text><text class="caption">{{type === 'all' ? '记录件数' : '记录条数'}}</text></view></view>
          <view class="metric-grid"><view wx:for="{{allTimeCards}}" wx:key="type" wx:if="{{type === 'all' || type === item.type}}" class="metric"><text class="metric-name">{{item.name}}</text><view><text class="metric-value">{{type === 'all' ? item.records : item.value}}</text><text class="metric-unit">{{type === 'all' ? '件' : item.unit}}</text></view></view></view>
          <text class="stats-note">静坐历史尚未全部导入；这里的累计不代表原静坐完整历史。团队、勋章继续沿用原静坐统计。</text>
        </view>
      </block>
    </view>
  </block>
  <view wx:if="{{type === 'sitting'}}" class="history-notice">
    <view class="history-copy"><text class="history-title">以往的静坐记录</text><text class="history-caption">静坐历史尚未全部导入，可在原记录中查看。</text></view>
    <view class="history-entry" bindtap="openOriginalHistory" hover-class="card-hover" aria-role="button" aria-label="查看原静坐完整历史"><text>查看</text><text class="history-arrow">›</text></view>
  </view>
</view>

<practice-picker wx:if="{{showTypePicker}}" visible="{{showTypePicker}}" options="{{typeOptions}}" selected-type="{{type}}" title="选择功课" subtitle="按功课查看记录与统计" bindselect="onTypeChange" bindclose="closeTypePicker" bindsettings="openPracticeSettings" />

<view wx:if="{{showForm}}" class="modal">
  <view class="modal-mask" bindtap="closeForm" catchtouchmove="noop"></view>
  <view class="dialog" catchtap="noop">
    <view class="dialog-header"><view class="dialog-heading"><text class="dialog-title">{{formEditing ? '编辑' : '记录'}}{{formTypeName}}</text><text class="caption">日期和时间均为北京时间</text></view><button size="mini" class="close-button" hover-class="close-button-hover" bindtap="closeForm" disabled="{{formBusy}}" aria-label="关闭功课表单"><view class="close-icon" aria-hidden="true"></view></button></view>
    <scroll-view class="dialog-scroll" scroll-y="{{true}}">
      <view class="dialog-body">
        <view wx:if="{{formType === 'kindness'}}" class="privacy-notice"><text>善事内容和感悟对已登录成员可见。</text><text>{{formEditing ? '修改会同步更新「做善事」，原件数及关联数据保持不变。' : '新建默认记一件，也会展示在「做善事」中。'}}</text></view>
        <view class="field-row"><view class="field field-date"><text class="label">发生日期</text><picker mode="date" value="{{formDate}}" end="{{today}}" bindchange="onFormDate" disabled="{{formBusy || formPending}}"><view class="field-control">{{formDate}}<text class="picker-arrow">⌄</text></view></picker></view><view class="field field-time"><text class="label">发生时间</text><picker mode="time" value="{{formTime}}" bindchange="onFormTime" disabled="{{formBusy || formPending}}"><view class="field-control">{{formTime || '原记录无时间'}}<text class="picker-arrow">⌄</text></view></picker></view></view>
        <text wx:if="{{formEditing && !formTime}}" class="caption field-hint">原记录仅有日期，请补充真实发生时间后保存。</text>
        <view wx:if="{{formType !== 'kindness'}}" class="field"><text class="label">{{formType === 'instant' ? '完成次数' : '完成时长'}}</text><view class="field-control"><input class="amount-input" type="number" value="{{formValue}}" bindinput="onFormValue" disabled="{{formBusy || formPending}}" maxlength="7"/><text class="field-unit">{{formUnit}}</text></view><text class="caption field-hint">{{formType === 'instant' ? '请填写已完成的整数次数。' : '填写已完成的整数分钟数。'}}</text></view>
        <view wx:else class="field"><text class="label">善事内容 <text class="required">必填</text></text><textarea class="textarea content-textarea" value="{{formContent}}" bindinput="onFormContent" maxlength="1000" placeholder="记录今天的一件善行" disabled="{{formBusy || formPending}}"/><text class="word-count">{{formContent.length}} / 1000</text><text wx:if="{{formEditing}}" class="caption">原记录 {{formValue}} 件，本次编辑保留件数。</text></view>
        <view class="field"><text class="label">感悟 <text class="optional">选填</text></text><textarea class="textarea" value="{{formReflection}}" bindinput="onFormReflection" maxlength="{{formMaxReflection}}" placeholder="写下此刻的体会" disabled="{{formBusy || formPending}}"/><text class="word-count">{{formReflection.length}} / {{formMaxReflection}}</text></view>
        <text wx:if="{{formError}}" class="form-error">{{formError}}</text>
        <text wx:if="{{formPending}}" class="caption">已持久保存在本机。上传确认前保留本次内容，重试沿用同一条记录。</text>
      </view>
    </scroll-view>
    <view class="dialog-footer"><button class="secondary-button" bindtap="closeForm" disabled="{{formBusy}}">{{formPending ? '稍后上传' : '取消'}}</button><button class="primary-button {{formBusy ? 'primary-button-disabled' : ''}}" bindtap="saveForm" loading="{{formBusy}}" disabled="{{formBusy}}">{{formBusy ? '正在保存' : formPending ? '重试上传' : '保存功课'}}</button></view>
  </view>
</view>

<view wx:if="{{detail}}" class="modal">
  <view class="modal-mask" bindtap="closeDetail" catchtouchmove="noop"></view>
  <view class="dialog" catchtap="noop">
    <view class="dialog-header"><text class="dialog-title dialog-heading">{{detail.typeName}}</text><button size="mini" class="close-button" hover-class="close-button-hover" bindtap="closeDetail" disabled="{{deleting}}" aria-label="关闭功课详情"><view class="close-icon" aria-hidden="true"></view></button></view>
    <scroll-view class="dialog-scroll" scroll-y="{{true}}"><view class="dialog-body">
      <view class="detail-amount"><text>{{detail.quantity}}</text><text class="detail-unit">{{detail.unit}}</text></view>
      <text class="detail-date">{{detail.recordDate}} · {{detail.timeLabel}}（北京时间）</text>
      <view wx:if="{{detail.mirrored}}" class="privacy-notice"><text>来自静坐记录</text><text>请通过原静坐入口查看、更新感悟或删除，功课记录将单向同步。</text></view>
      <view wx:if="{{detail.type === 'kindness'}}" class="privacy-notice"><text>内容与感悟对已登录成员可见；编辑、删除也会更新「做善事」。记录条数与善事件数分别统计。</text></view>
      <view wx:if="{{detail.content}}" class="detail-section"><text class="label">善事内容</text><text class="detail-text" selectable="{{true}}">{{detail.content}}</text></view>
      <view class="detail-section"><text class="label">感悟</text><text class="detail-text {{!detail.reflection ? 'muted' : ''}}" selectable="{{true}}">{{detail.reflection || '这次练习没有填写感悟'}}</text></view>
    </view></scroll-view>
    <view class="dialog-footer" wx:if="{{detail.type === 'sitting'}}"><button class="primary-button full-button" bindtap="openOriginalRecord">前往原静坐记录</button></view>
    <view class="dialog-footer" wx:elif="{{detail.canEdit || detail.canDelete}}"><button wx:if="{{detail.canDelete}}" class="danger-button" bindtap="deleteDetail" loading="{{deleting}}" disabled="{{deleting}}">删除</button><button wx:if="{{detail.canEdit}}" class="primary-button" bindtap="editDetail" disabled="{{deleting}}">编辑功课</button></view>
  </view>
</view>
