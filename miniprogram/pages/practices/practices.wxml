<template name="read-failure">
  <view class="state-card error-card">
    <text class="state-title">{{failure.title}}</text>
    <text class="state-message">{{failure.message}}</text>
    <button size="mini" class="outline-button state-button" bindtap="handleReadFailure" data-scope="{{scope}}">{{failure.actionText}}</button>
  </view>
</template>

<view class="practice-page practice-home">
  <view class="page-heading home-heading">
    <view class="heading-copy">
      <view class="home-title-row"><text class="page-title">今日功课</text><text class="home-date">{{todayLabel}}</text></view>
      <text wx:if="{{enabled && homeCards.length}}" class="home-grid-hint">点击功课卡片，记录今日练习</text>
      <text wx:if="{{enabled}}" class="home-grid-hint">每日 02:00 至次日 02:00 统计</text>
    </view>
    <button size="mini" class="add-button {{!enabled ? 'add-button-disabled' : ''}}" bindtap="choosePractice" disabled="{{!enabled}}" aria-label="记录一份功课">＋ 记录</button>
  </view>

  <view wx:if="{{!enabled}}" class="state-card">
    <text class="state-title">功课记录准备中</text>
    <text class="state-message">现在可以继续记录静坐。</text>
    <button class="outline-button" bindtap="openSittingForm">记录静坐</button>
  </view>

  <block wx:else>
    <include src="practicePending.wxml" />
    <block wx:if="{{homeCards.length}}">
      <view class="home-practice-grid {{homeCards.length === 1 ? 'home-practice-single' : homeCards.length === 2 || homeCards.length === 4 ? 'home-practice-pairs' : ''}}">
        <button class="home-practice-card {{item.value > 0 && todayLoaded ? 'home-practice-done' : ''}}" wx:for="{{homeCards}}" wx:key="type" data-type="{{item.type}}" bindtap="openPracticeCard" hover-class="home-practice-hover" disabled="{{formBusy}}" aria-label="{{item.name + (todayLoaded ? '，今日累计' + item.value + item.unit + (todayError ? '，刷新失败，显示上次结果' : '') : todayError ? '，今日累计暂时无法读取' : '，正在读取今日累计') + '，点击记录'}}">
          <text class="home-practice-name">{{item.name}}</text>
          <view class="home-practice-amount"><text class="home-practice-value">{{todayLoaded ? item.valueLabel : '—'}}</text><text class="home-practice-unit">{{item.unit}}</text></view>
        </button>
      </view>
      <text wx:if="{{todayLoading && !todayLoaded && !todayError}}" class="home-stats-status">正在读取今日累计…</text>
      <view wx:elif="{{todayError}}" class="home-stats-error"><text>{{todayLoaded ? '刷新失败，显示上次结果。' : ''}}{{todayFailure.message}}</text><button class="inline-button" bindtap="handleReadFailure" data-scope="today">{{todayFailure.actionText}}</button></view>
    </block>
    <view wx:else class="state-card home-no-practices">
      <text class="state-title">选择今天要做的功课</text>
      <text class="state-message">在记录设置中开启需要的功课，就能在这里直接记录。</text>
      <button size="mini" class="outline-button" bindtap="openPracticeSettings">选择功课</button>
    </view>

    <view class="home-recent">
      <view class="home-section-heading"><text class="home-section-title">最近三天记录</text><button size="mini" class="home-records-link" bindtap="openRecords" data-view="detail" hover-class="card-hover">查看全部<text class="home-entry-arrow" aria-hidden="true">›</text></button></view>
      <block wx:if="{{homeCards.length}}">
        <view wx:if="{{homeLoading && !homeLoaded && !homeError}}" class="empty-state home-loading">正在读取最近记录…</view>
        <template wx:if="{{homeError}}" is="read-failure" data="{{failure: homeFailure, scope: 'home'}}" />
        <block wx:if="{{homeLoaded}}">
          <text wx:if="{{homeError}}" class="caption">刷新失败，以下为上次读取的记录</text>
          <view class="home-day-group" wx:for="{{recentGroups}}" wx:for-item="group" wx:key="date">
            <view class="home-day-heading"><text class="home-day-label">{{group.label}}</text><text class="home-day-date">{{group.dateLabel}}</text></view>
            <view wx:if="{{!group.records.length}}" class="home-today-empty"><text>今天还没有已上传的记录</text></view>
            <view wx:else class="home-record-list">
              <view class="home-record" wx:for="{{group.records}}" wx:for-item="record" wx:key="key" data-key="{{record.key}}" bindtap="openDetail" catchlongpress="showRecordActions" hover-class="card-hover" aria-role="button" aria-label="{{record.typeName + '，' + record.quantity + record.unit + '，' + record.timeLabel + '，点击查看详情'}}">
                <view class="home-record-copy"><view class="home-record-heading"><text class="home-record-name">{{record.typeName}}</text><text class="home-record-time">{{record.timeLabel}}</text></view><text wx:if="{{record.preview}}" class="home-record-preview">{{record.preview}}</text></view>
                <view class="home-record-quantity"><text class="home-record-value">{{record.quantity}}</text><text class="home-record-unit">{{record.unit}}</text></view>
              </view>
            </view>
          </view>
          <text wx:if="{{recentRecords.length}}" class="home-footer-note">更早的记录，可在明细中查看</text>
        </block>
      </block>
    </view>
  </block>
</view>

<include src="practiceDialogs.wxml" />
