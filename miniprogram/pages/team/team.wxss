/* pages/team/team.wxss */

.team-container {
  background-color: #f8f8f8;
  min-height: 100vh;
  padding: 20rpx;
}

/* 按照首页样式调整 */
.page {
  background-color: #ffffff;
  width: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  height: 100%;
}
.section {
  overflow: hidden;
  background-color: #f8fafc;
  height: 1406.51rpx;
}
.group {
  height: 950.93rpx;
}
.section_2 {
  padding-top: 60rpx;
  background-color: #b29764;
  overflow: hidden;
  height: 400rpx;
}
.font {
  font-size: 32rpx;
  font-family: Arimo;
  line-height: 25rpx;
  color: #fffefecc;
}
.text {
  color: #fffefecc;
  line-height: 28rpx;
}

/* 团队图标样式 */
.team-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

/* 标题区域样式 - 与统计卡片左对齐 */
.title-section {
  margin-left: 42.35rpx;
  margin-bottom: 40rpx;
}

/* 我的团队标题加粗 */
.team-title {
  font-weight: bold;
  display: block;
  margin-bottom: 28rpx; /* 增加标题与副标题之间的间距 */
}

/* 副标题样式 - 在我的团队下方，保持左对齐 */
.subtitle {
  display: block;
  color: #ffffffcc;
  line-height: 26.1rpx;
  font-weight: unset;
  font-size: 28rpx;
  text-align: left; /* 确保左对齐 */
}
.section_5 {
  margin: 250.59rpx 0 -112.94rpx;
  background-color: #ffffff1a;
  border-radius: 0 88820470.59rpx 88820470.59rpx 0;
  width: 169.99rpx;
  height: 282.32rpx;
}
.pos {
  position: absolute;
  left: 42.35rpx;
  right: 0;
  top: 0;
}
.section_3 {
  margin-left: 370.59rpx;
  background-image: linear-gradient(135deg, #b29764 0%, #c9a870 100%);
  background-size: 100% 100%;
  width: 300rpx;
  height: 337rpx;
}
.equal-division {
  position: absolute;
  left: 0;
  right: 41.52rpx;
  top: 220rpx;
}
.font_3 {
  font-size: 26rpx;
  font-family: Arimo;
  line-height: 19.5rpx;
  color: #fffefeb3;
}
.font_2 {
  font-size: 42.35rpx;
  font-family: Arimo;
  line-height: 29.56rpx;
  font-weight: 500;
  color: #ffffff;
}
.font_4 {
  font-size: 26rpx;
  font-family: Arimo;
  line-height: 19.5rpx;
  color: #fffefeb3;
}
.section_4 {
  flex: 1 1 311rpx;
}
.equal-division-item {
  padding: 32rpx 24rpx 32rpx 32rpx;
  background-color: #0000001a;
  border-radius: 28rpx;
  height: 140rpx;
  border-left: solid 4rpx #ffffff1a;
  border-right: solid 4rpx #ffffff1a;
  border-top: solid 4rpx #ffffff1a;
  border-bottom: solid 4rpx #ffffff1a;
}
.text_2 {
  color: #ffffffcc;
  line-height: 26.1rpx;
  font-size: 26rpx;
}
.pos_2 {
  position: absolute;
  left: 0;
  top: 50%;
}
.mt-14 {
  margin-top: 24.71rpx;
}
.mt-12 {
  margin-top: 21.18rpx;
}
.ml-7 {
  margin-left: 12.35rpx;
}
.ml-9 {
  margin-left: 15.88rpx;
}
.section_6 {
  position: relative;
  margin-top: 40rpx;
}

/* 创建团队按钮 */
.create-team-btn {
  background: white;
  border: 2rpx solid #b29764;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  transition: all 0.3s ease;
}

.create-team-btn:active {
  background-color: #f8f8f8;
  transform: scale(0.98);
}

.create-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.create-text {
  color: #b29764;
  font-size: 28rpx;
  font-weight: bold;
}

/* 标签页样式 */
.tab-container {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  position: relative;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #b29764;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: white;
}

.tab-indicator {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #b29764;
  border-radius: 2rpx;
  opacity: 0;
}

.tab-item.active .tab-indicator {
  opacity: 1;
}

/* 加载状态 */
.loading-container {
  text-align: center;
  padding: 80rpx;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 团队列表 */
.team-list {
  margin-bottom: 40rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background: white;
  border-radius: 24rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  color: #666;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.empty-subtext {
  display: block;
  color: #999;
  font-size: 24rpx;
}

/* 删除按钮区域 */
.delete-btn-container {
  width: 160rpx;
  background: #ff4d4f;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
}

.delete-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

.delete-btn:active {
  background: rgba(0, 0, 0, 0.1);
}

.delete-icon {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 8rpx;
}

.delete-text {
  color: white;
  font-size: 24rpx;
  font-weight: 500;
}

/* 团队项 */
.team-item {
  background: white;
  border-radius: 24rpx;
  padding: 0;
  margin-bottom: 24rpx;
  display: flex;
  align-items: stretch;
  transition: all 0.3s ease;
  overflow: hidden;
}

.team-content {
  flex: 1;
  padding: 32rpx;
  display: flex;
  align-items: flex-start;
}

.team-item:active {
  transform: scale(0.98);
  background: #f8f8f8;
}

.team-icon-container {
  flex-shrink: 0;
  margin-right: 24rpx;
}

.team-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}

.team-info {
  flex: 1;
}

.team-header-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.team-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.team-arrow {
  width: 24rpx;
  height: 24rpx;
}

.team-description {
  color: #666;
  font-size: 24rpx;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.team-stats {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.team-stat {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.stat-icon {
  width: 20rpx;
  height: 20rpx;
  margin-right: 8rpx;
}

.stat-text {
  color: #666;
  font-size: 22rpx;
}

.creator-text {
  color: #666;
  font-size: 22rpx;
}

.team-footer {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.create-time, .join-time {
  color: #999;
  font-size: 20rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .team-container {
    padding: 16rpx;
  }
  
  .team-item {
    padding: 24rpx;
  }
  
  .team-item-icon {
    width: 64rpx;
    height: 64rpx;
  }
  
  .team-name {
    font-size: 28rpx;
  }
}