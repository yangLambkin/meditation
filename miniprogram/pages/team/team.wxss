/* 暖金色 Hero 呼应首页，列表延续浅灰页底与白色卡片。 */
page { background-color: #f8fafc; color: #354152; }
.team-page { padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom)); min-height: 100vh; box-sizing: border-box; }
button { margin: 0; font-weight: 500; }
button::after { border: none; }
.team-hero { position: relative; overflow: hidden; margin: 0 -28rpx; padding: 46rpx 40rpx 66rpx; background-color: #b29764; color: #ffffff; }
.hero-decoration { position: absolute; top: 0; right: 0; bottom: 0; width: 340rpx; pointer-events: none; }
.hero-orbit { position: absolute; border: 2rpx solid rgba(255, 255, 255, .12); border-radius: 50%; }
.hero-orbit-outer { width: 440rpx; height: 440rpx; top: -164rpx; right: -176rpx; }
.hero-orbit-inner { width: 318rpx; height: 318rpx; top: -103rpx; right: -115rpx; }
.hero-glow { position: absolute; width: 196rpx; height: 196rpx; top: -42rpx; right: -54rpx; border-radius: 50%; background-color: rgba(255, 255, 255, .07); }
.hero-content { position: relative; z-index: 1; }
.hero-eyebrow { display: block; color: #fff8eb; font-size: 24rpx; line-height: 1.5; letter-spacing: 3rpx; }
.hero-title { display: block; margin-top: 18rpx; font-size: 46rpx; font-weight: 600; line-height: 1.4; letter-spacing: 1rpx; }
.hero-description { display: block; margin-top: 14rpx; color: #fff8eb; font-size: 25rpx; line-height: 1.7; }
.hero-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 28rpx; margin-top: 36rpx; }
.overview-summary { display: flex; align-items: center; gap: 28rpx; min-width: 0; }
.hero-stat { display: flex; flex-direction: column; gap: 6rpx; }
.count-number { color: #ffffff; font-weight: 600; font-size: 44rpx; line-height: 1.15; }
.count-label { color: #fff8eb; font-size: 22rpx; line-height: 1.5; }
.stat-divider { width: 1rpx; height: 46rpx; background-color: rgba(255, 255, 255, .28); }
.create-button { flex-shrink: 0; padding: 0 20rpx; line-height: 74rpx; border: 1rpx solid rgba(255, 255, 255, .3); border-radius: 16rpx; background-color: transparent; color: #fff8eb; font-size: 24rpx; font-weight: 400; }
.create-button-hover, .create-button:active { background-color: rgba(255, 255, 255, .1); }
.primary-button:active { background-color: #9c8357; }
.tabs { position: relative; z-index: 2; display: flex; margin: -28rpx 0 28rpx; padding: 8rpx; border: 2rpx solid #ffffff; border-radius: 20rpx; background-color: #ffffff; box-shadow: 0 6rpx 22rpx rgba(53, 65, 82, .05); }
.tab { flex: 1; color: #7a8493; font-size: 28rpx; font-weight: 500; line-height: 68rpx; text-align: center; border-radius: 12rpx; }
.tab.selected { color: #a68a57; background-color: #b2976414; font-weight: 600; }
.refresh-hint { display: flex; gap: 12rpx; justify-content: center; align-items: center; font-size: 24rpx; color: #99a1ae; padding: 0 0 22rpx; }
.loading-dot { height: 10rpx; width: 10rpx; border-radius: 50%; background-color: #b29764; }
.list-caption { color: #99a1ae; font-size: 22rpx; line-height: 1.6; padding: 0 8rpx 18rpx; }
.team-card { background-color: #ffffff; border: 2rpx solid #f0f2f5; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.team-card-clickable:active { background-color: #f7f4ee; }
.card-top { display: flex; align-items: center; gap: 20rpx; }
.team-avatar { width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 20rpx; background-color: #f2f4f6; }
.team-identity { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.team-name { font-size: 30rpx; font-weight: 600; color: #354152; line-height: 1.4; word-break: break-all; }
.role-badge { font-size: 20rpx; border-radius: 8rpx; background-color: #f2f4f6; color: #7a8493; padding: 4rpx 10rpx; white-space: nowrap; }
.role-badge.owner { background-color: #b2976414; color: #a68a57; }
.team-owner { display: block; color: #697282; font-size: 24rpx; line-height: 1.5; margin-top: 10rpx; word-break: break-all; }
.member-count { display: block; color: #99a1ae; font-size: 24rpx; margin-top: 10rpx; }
.chevron { color: #c0c6cf; font-size: 40rpx; flex-shrink: 0; }
.team-description { display: block; font-size: 26rpx; line-height: 1.6; color: #697282; margin-top: 22rpx; word-break: break-all; }
.rule-row { display: flex; flex-wrap: wrap; gap: 10rpx; color: #697282; font-size: 24rpx; margin-top: 24rpx; }
.rule-dot { color: #c0c6cf; }
.card-footer { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; flex-wrap: wrap; border-top: 2rpx solid #f2f4f6; margin-top: 24rpx; padding-top: 20rpx; font-size: 24rpx; color: #a68a57; }
.empty-state { padding: 70rpx 24rpx; text-align: center; border-radius: 20rpx; background-color: #ffffff; }
.empty-symbol { font-size: 72rpx; color: #b29764; margin-bottom: 24rpx; }
.empty-title { display: block; font-size: 30rpx; color: #354152; margin-bottom: 16rpx; }
.empty-description { display: block; color: #99a1ae; font-size: 24rpx; line-height: 1.8; white-space: pre-line; }
.primary-button { margin: 32rpx auto 0; background-color: #b29764; color: #ffffff; font-size: 30rpx; font-weight: 600; padding: 0 32rpx; line-height: 84rpx; border-radius: 14rpx; display: inline-block; }
