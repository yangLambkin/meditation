<view class="team-page">
  <view class="team-hero">
    <view class="hero-decoration" aria-hidden="true">
      <view class="hero-shape"></view>
      <image class="hero-image" src="/images/bg_image.png" mode="aspectFill" />
    </view>
    <view class="hero-content">
      <view class="hero-welcome">欢迎回来，{{hasUserInfo ? userNickname : '静坐的朋友'}}</view>
      <text class="hero-title">结伴静坐，共同成长</text>
    </view>
  </view>
  <view class="team-summary-card">
      <view class="hero-footer">
        <view class="overview-summary">
          <view class="hero-stat"><text class="count-number">{{totalJoinedTeams}}</text><text class="count-label">已加入团队</text></view>
          <view class="stat-divider"></view>
          <view class="hero-stat"><text class="count-number">{{myTeams.length}}</text><text class="count-label">我创建的</text></view>
        </view>
        <button class="create-button" bindtap="createNewTeam" hover-class="create-button-hover">＋ 创建团队</button>
      </view>
  </view>
  <view class="tabs">
    <view class="tab {{currentTab === 'created' ? 'selected' : ''}}" bindtap="switchTab" data-tab="created">我的团队</view>
    <view class="tab {{currentTab === 'joined' ? 'selected' : ''}}" bindtap="switchTab" data-tab="joined">发现团队</view>
  </view>

  <block wx:if="{{currentTab === 'created'}}">
    <view class="team-card team-card-clickable" wx:for="{{mergedJoinedTeams}}" wx:key="_id" bindtap="viewTeamDetail" data-team-id="{{item._id}}">
      <view class="card-top">
        <image class="team-avatar" src="{{item.icon}}" mode="aspectFill" />
        <view class="team-identity">
          <view class="name-row"><text class="team-name">{{item.name}}</text><text class="role-badge owner" wx:if="{{item.isSelfCreated}}">我创建的</text></view>
          <text class="team-owner">团长：{{item.creatorName || '匿名用户'}}</text>
          <text class="member-count">{{item.memberCount || 0}} 位成员</text>
        </view>
      </view>
      <text class="team-description">{{item.description || '每一次静坐，都有伙伴同行'}}</text>
    </view>
    <view wx:if="{{!totalJoinedTeams && !isLoading}}" class="empty-state">
      <view class="empty-symbol">◎</view><text class="empty-title">从一个小组开始</text><text class="empty-description">请联系团长，通过邀请加入团队。
也可以创建自己的团队，邀请伙伴一起练习。</text>
      <button class="primary-button" bindtap="createNewTeam">创建第一个团队</button>
    </view>
  </block>

  <block wx:if="{{currentTab === 'joined'}}">
    <view class="list-caption">找到一起静坐的伙伴，联系团长获取邀请即可加入。</view>
    <view class="team-card" wx:for="{{allTeams}}" wx:key="_id">
      <view class="card-top">
        <image class="team-avatar" src="{{item.icon}}" mode="aspectFill" />
        <view class="team-identity">
          <view class="name-row"><text class="team-name">{{item.name}}</text><text class="role-badge owner" wx:if="{{item.isSelfCreated}}">我创建的</text></view>
          <text class="team-owner">团长：{{item.creatorName || '匿名用户'}}</text>
          <text class="member-count">{{item.memberCount || 0}} 位成员</text>
        </view>
      </view>
      <text class="team-description">{{item.description || '每一次静坐，都有伙伴同行'}}</text>
    </view>
    <view wx:if="{{!allTeams.length && !isLoading}}" class="empty-state"><view class="empty-symbol">◎</view><text class="empty-title">还没有公开团队</text><text class="empty-description">创建一个团队，邀请伙伴加入。</text></view>
  </block>
</view>
