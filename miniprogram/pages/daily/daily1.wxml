<view class="daily-page">
  <view class="daily-intro">
    <view class="daily-intro-title"><view class="daily-intro-dot"></view><text>今日 · 静心卡</text></view>
    <text class="daily-intro-note">{{isSharedView ? '一张静心卡，一份安静' : '静坐之后 · 留一刻给自己'}}</text>
  </view>

  <view class="daily-card">
    <view class="daily-date">
      <view class="daily-date-main">
        <text class="daily-date-day">{{day}}</text>
        <view class="daily-date-month"><text class="daily-month-name">{{month}}</text><text class="daily-date-year">{{year}}</text></view>
      </view>
      <view class="daily-date-detail"><text>{{weekDay}}</text><text class="daily-lunar-date">{{lunarDate}}</text></view>
    </view>
    <view wx:if="{{session}}" class="daily-session">
      <view class="daily-session-copy">
        <text class="daily-session-name">{{session.name}}</text>
        <text class="daily-session-time">{{session.dateLabel}} {{session.timeLabel}} 收坐</text>
      </view>
      <view class="daily-session-duration"><text class="daily-session-minutes">{{session.minutes}}</text><text>分钟静坐</text></view>
    </view>
    <view class="daily-art">
      <view wx:if="{{isImageLoading || imageLoadFailed}}" class="daily-art-placeholder">
        <text>{{isImageLoading ? '正在打开静心卡…' : '卡片暂未加载'}}</text>
        <button wx:if="{{imageLoadFailed}}" class="daily-art-retry" bindtap="retryDailyImage">重新加载</button>
      </view>
      <image wx:else class="daily-art-image" src="{{displayImage}}" mode="aspectFit" bindtap="previewDailyCard" binderror="fallbackToDefaultImage" show-menu-by-longpress="{{true}}" aria-label="查看静心卡大图" />
    </view>
    <view class="daily-wisdom">
      <view class="daily-wisdom-line"></view>
      <text class="daily-wisdom-text">{{wisdomQuote || '静心即是修心，心安即是归处。'}}</text>
    </view>
    <view wx:if="{{!isSharedView}}" class="daily-personal">
      <view class="daily-profile">
        <nickname-avatar src="{{userAvatar}}" nickname="{{userName}}" size="{{64}}" />
        <view class="daily-profile-copy">
          <text class="daily-profile-name">{{userName || '静心者'}}</text>
          <text class="daily-profile-note">每一次静坐，都是与自己的相遇</text>
        </view>
        <view wx:if="{{highestLevelBadge}}" class="daily-profile-badge"><text>{{highestLevelBadge.name}}</text></view>
      </view>
      <view class="daily-stats">
        <view class="daily-stat">
          <view class="daily-stat-value"><text>{{totalMinutes || 0}}</text><text class="daily-stat-unit">分钟</text></view>
          <text class="daily-stat-label">本次静坐</text>
        </view>
        <view class="daily-stat-divider"></view>
        <view class="daily-stat">
          <view class="daily-stat-value"><text>{{totalCount || 0}}</text><text class="daily-stat-unit">次</text></view>
          <text class="daily-stat-label">今日打卡</text>
        </view>
      </view>
    </view>
    <view class="daily-card-footer"><text>静坐觉察</text><text class="daily-card-footer-dot">·</text><text>把心安放在当下</text></view>
  </view>

  <text class="daily-sharing-note">将这一刻的安静，分享给在意的人</text>
  <button wx:if="{{isSharedView}}" class="daily-start-button" bindtap="onBack" hover-class="daily-text-pressed">开启我的静坐 <text class="daily-start-arrow">→</text></button>

  <view class="daily-action-bar">
    <view class="daily-actions">
      <button class="daily-action daily-action-save" bindtap="saveDailyImage" loading="{{isSavingImage}}" disabled="{{isSavingImage}}" hover-class="daily-action-pressed">
        <view wx:if="{{!isSavingImage}}" class="daily-save-icon"><view></view></view>
        <text>{{isSavingImage ? '正在保存' : '保存图片'}}</text>
      </button>
      <button class="daily-action daily-action-share" open-type="share" hover-class="daily-action-pressed">
        <view class="daily-share-icon"><view></view></view><text>分享给朋友</text>
      </button>
    </view>
  </view>

  <view class="daily-export-host" aria-hidden="true">
    <canvas type="2d" id="dailyCanvas" class="daily-export-canvas" style="position: fixed; left: -10000px; top: 0; width: 750px; height: 1334px; opacity: 0; pointer-events: none;"></canvas>
    <canvas type="2d" id="dailyShareCanvas" class="daily-export-canvas" style="position: fixed; left: -10000px; top: 0; width: 500px; height: 400px; opacity: 0; pointer-events: none;"></canvas>
  </view>
</view>
