<view class="flex-col page">
  <!-- 主要内容区域 -->
  <view class="flex-col section">
    <view class="flex-col main-content">
      <!-- 页面标题 -->
      <view class="flex-row justify-center self-stretch relative">
        <view class="flex-col items-center">
          <text class="font text_2 mt-8">本次冥想时长</text>
        </view>
      </view>
      
      <!-- 冥想时长显示 -->
      <text class="self-center text_4 mt-8">{{durationText || '0分钟'}}</text>
      
      <!-- 情绪选择器 -->
      <view class="flex-col self-stretch group_2 mt-30">
        <text class="self-center emotion-main-text">{{currentEmotion}}</text>
        <view class="flex-col self-stretch mt-25">
          <!-- 滑动条 -->
          <view class="flex-col justify-start self-stretch relative group_2" 
                bindtouchstart="handleSliderStart"
                bindtouchmove="handleSliderMove"
                bindtouchend="handleSliderEnd">
            <view class="section_3"></view>
            <view class="slider-thumb pos" style="left: {{sliderPosition}}rpx"></view>
          </view>
          <text class="self-center font_2 text_5">选择具体情绪</text>
          <!-- 子情绪选择 -->
          <view class="flex-row self-stretch group_3">
            <view wx:for="{{currentSubEmotions}}" wx:key="index" 
                  class="flex-col justify-start items-center text-wrapper {{item.selected ? 'selected' : ''}}"
                  bindtap="toggleSubEmotion" data-index="{{index}}">
              <text class="font">{{item.name}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 记录区域 -->
      <view class="flex-col self-stretch group_2 mt-30">
        <view class="flex-col text-input-container">
          <textarea
            placeholder="记录您的感受和想法..." 
            class="textarea-input"
            maxlength="500"
            value="{{currentText}}"
            bindinput="onTextInput"
            bindfocus="onTextFocus"
            bindblur="onTextBlur"
          />
          <text class="self-end font_3 mt-16">{{currentTextLength}} / 500</text>
        </view>
      </view>
      
      <!-- 打卡完成按钮 -->
      <view class="flex-col self-stretch group_2 mt-30">
        <view class="complete-checkin-btn" bindtap="completeCheckIn">
          <text class="complete-checkin-text">打卡完成</text>
        </view>
      </view>
    </view>
  </view>
</view>