<view class="recorder-page">
  <text class="recorder-title">静坐已结束</text>
  <view class="recorder-duration">{{duration}}<text> 分钟</text></view>
  <view class="recorder-card">
    <text class="recorder-label">此刻的感受 <text>（选填）</text></text>
    <textarea class="recorder-input" value="{{currentText}}" bindinput="onTextInput" maxlength="500" disabled="{{submitting || completed}}" placeholder="写下感受，或直接点确定结束" />
    <text class="recorder-count">{{currentTextLength}} / 500</text>
  </view>
  <button class="recorder-submit" bindtap="completeCheckIn" loading="{{submitting}}" disabled="{{submitting || completed}}">确定</button>
</view>
