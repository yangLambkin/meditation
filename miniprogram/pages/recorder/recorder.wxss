page { background: #faf8f3; }
.recorder-page { padding: 72rpx 36rpx; color: #38352f; }
.recorder-title { display: block; text-align: center; font-size: 32rpx; }
.recorder-duration { margin: 24rpx 0 56rpx; text-align: center; font-size: 72rpx; color: #b29764; }
.recorder-duration text { font-size: 28rpx; }
.recorder-card { padding: 32rpx; border-radius: 24rpx; background: #fff; }
.recorder-label { font-size: 28rpx; }
.recorder-label text { color: #999; font-size: 24rpx; }
.recorder-input { width: 100%; height: 260rpx; margin-top: 24rpx; font-size: 28rpx; line-height: 1.8; }
.recorder-count { display: block; text-align: right; color: #999; font-size: 22rpx; }
.recorder-submit { margin-top: 40rpx; background: #b29764; color: #fff; border-radius: 20rpx; }
.recorder-submit::after { border: 0; }
