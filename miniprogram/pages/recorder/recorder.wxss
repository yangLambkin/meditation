/* ===== 页面整体布局调整 ===== */

/* 页面容器 */
.page {
  background-color: #ffffff;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 主要内容区域 - 占据剩余空间 */
.section {
  padding: 40rpx 32rpx 32rpx;
  background-color: #ffffff;
  flex: 1;
  overflow-y: auto;
}

/* 主要内容区域 */
.main-content {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

/* 减小元素间距 */
.mt-20 {
  margin-top: 40rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mt-60 {
  margin-top: 120rpx;
}

/* 文本输入容器 */
.text-input-container {
  padding: 24rpx 32rpx 16rpx;
  min-height: 160rpx;
  background-color: #f8f8f8;
  border-radius: 32rpx;
  overflow: hidden;
  border: solid 2rpx #e8e8e8;
}

/* 调整保存记录按钮 */
.text-wrapper {
  padding: 24rpx 0;
  min-height: 80rpx;
}

/* ===== 底部打卡完成按钮样式 ===== */


/* 打卡完成按钮 */
.complete-checkin-btn {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 32.96rpx 0 33.38rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: solid 2rpx #b29764;
  transition: all 0.3s ease;
  width: 100%;
  margin-bottom: 0;
}

.complete-checkin-btn:active {
  background-color: #f8f8f8;
  transform: scale(0.98);
}

/* 按钮文字 */
.complete-checkin-text {
  color: #b29764;
  font-size: 32rpx;
  font-family: Arimo;
  font-weight: 700;
  line-height: 29.66rpx;
}

/* ===== 5星评分组件样式 ===== */

/* 星星容器 */
.star-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 80rpx;
  height: 80rpx;
  transition: all 0.3s ease;
  
  /* 确保容器背景透明 */
  background-color: transparent !important;
}

/* 星星图片 - 简化样式，去除阴影效果，保留基本悬停 */
.star-icon {
  width: 56rpx;
  height: 56rpx;
  transition: all 0.3s ease;
  /* 强制背景透明，移除所有阴影效果 */
  background-color: transparent !important;
}

/* 悬停状态 - 简化效果 */
.star-item.hover .star-icon {
  opacity: 0.9;
  transform: scale(1.1);
}

/* 选中状态 - 无额外效果，仅改变图片 */
.star-item.active .star-icon {
  opacity: 1;
  /* 移除所有阴影和发光效果 */
}

/* 悬停 + 选中状态 */
.star-item.active.hover .star-icon {
  opacity: 0.95;
  transform: scale(1.15);
}

/* 触摸效果 */
.star-item:active {
  transform: scale(0.95);
}

/* 响应式效果 */
@media (min-width: 768px) {
  .star-item:hover {
    transform: scale(1.05);
  }
  
  .star-item:hover .star-icon {
    opacity: 0.8;
    transform: scale(1.1);
  }
}

