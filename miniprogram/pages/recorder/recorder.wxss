  animation: mainEmotionGlow 2s ease-in-out infinite alternate;
}

/* 主情绪发光动画 */
@keyframes mainEmotionGlow {
  from {
    text-shadow: 0 0 5rpx rgba(255, 215, 0, 0.5),
                 0 0 10rpx rgba(255, 215, 0, 0.3);
    transform: scale(1);
  }
  to {
    text-shadow: 0 0 15rpx rgba(255, 215, 0, 0.8),
                 0 0 25rpx rgba(255, 215, 0, 0.5),
                 0 0 35rpx rgba(255, 215, 0, 0.3);
    transform: scale(1.05);
  }
}

