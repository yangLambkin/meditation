/* 子情绪容器 */
.group_3 {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start; /* 左对齐 */
  gap: 8rpx; /* 选项间的固定间距 */
}

/* 子情绪按钮 */
.text-wrapper {
  flex: 0 0 calc((100% - 32rpx) / 5); /* 每行5个，减去总间距后平均分配 */
  padding: 16rpx 0;
  background-color: #ffffff1a;
  border-radius: 20rpx;
  height: 76rpx;
  border-left: solid 2rpx #ffffff33;
  border-right: solid 2rpx #ffffff33;
  border-top: solid 2rpx #ffffff33;
  border-bottom: solid 2rpx #ffffff33;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 8rpx; /* 行间距 */
}

/* 子情绪选中状态 - 灯被点亮效果 */
.text-wrapper.selected {
  background-color: #fff8e6; /* 偏黄色的亮色背景 */
  border-color: #ffd700; /* 金色边框 */
  border-width: 3rpx;
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.6); /* 金色发光效果 */
  transform: scale(1.05);
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
}

/* 选中状态下的字体颜色 */
.text-wrapper.selected .font {
  color: #8b6b00; /* 深棕色字体，在黄色背景上清晰可见 */
  font-weight: 600;
}

/* 添加发光效果 */
.text-wrapper.selected::before {
  content: '';
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  border-radius: 20rpx;
  background: radial-gradient(circle at center, rgba(255, 215, 0, 0.3) 0%, transparent 70%);
  z-index: -1;
  animation: glow 1.5s ease-in-out infinite alternate;
}

/* 发光动画 */
@keyframes glow {
  from {
    opacity: 0.6;
    transform: scale(1);
  }
  to {
    opacity: 1;
    transform: scale(1.02);
  }
}

