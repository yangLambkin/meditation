<!--pages/timer/timer.wxml-->
<view class="flex-col page">
  <view class="flex-col section">
    <view class="flex-col self-stretch">
      <text class="self-center text_2 mt-17">知道有念，知道无念，知道就好</text>
    </view>
    <view class="mt-34 flex-col items-center self-center section_2">
      <!-- 进度圈容器 -->
      <view class="progress-circle-container">
        <!-- 背景圆环 -->
        <view class="progress-circle-bg {{!isCountdown ? 'progress-circle-static' : ''}}"></view>
        <!-- 两个固定裁剪区分别显示剩余进度，旋转中心均位于圆心 -->
        <view wx:if="{{isCountdown}}" class="progress-circle-fill {{isRunning ? 'is-animating' : ''}}">
          <view class="progress-circle-clip progress-circle-clip-left">
            <view class="progress-circle-half progress-circle-left" style="transform: rotate({{progressAngleLeft}}deg);"></view>
          </view>
          <view class="progress-circle-clip progress-circle-clip-right">
            <view class="progress-circle-half progress-circle-right" style="transform: rotate({{progressAngleRight}}deg);"></view>
          </view>
        </view>
        <!-- 时间显示 -->
        <view class="time-display">
          <text class="text_3">{{displayTime}}</text>
          <text class="mt-8 font text_4">{{isCountdown ? '倒计时' : '正计时'}}</text>
        </view>
      </view>
    </view>
    <!-- 计时器控制按钮 -->
    <view class="timer-button-container">
      
      <!-- 有计时进度时显示重置按钮，隐藏时保留占位以保持主按钮居中 -->
      <view class="reset-btn-wrapper">
        <view class="weui-btn-circle reset-btn" bindtap="resetTimer" wx:if="{{showResetButton}}">
          <image class="reset-btn-icon" src="{{resetIcon}}" mode="aspectFit" />
          <text class="reset-btn-text">重置</text>
        </view>
        <view class="reset-btn-placeholder" wx:else></view>
      </view>
      
      <!-- 主控制按钮 - 开始和暂停按钮在同一位置切换 -->
      <view class="weui-btn-circle main-btn primary" bindtap="startTimer" wx:if="{{showStartButton}}">
        <image class="main-btn-icon" src="{{startIcon}}" mode="aspectFit" />
        <text class="main-btn-text">开始</text>
      </view>
      
      <view class="weui-btn-circle pause-btn primary" bindtap="pauseTimer" wx:if="{{showPauseButton}}">
        <image class="pause-btn-icon" src="{{pauseIcon}}" mode="aspectFit" />
        <text class="pause-btn-text">暂停</text>
      </view>
      
      <!-- 停止按钮 - 使用占位方式确保布局对称 -->
      <view class="stop-btn-wrapper">
        <view class="weui-btn-circle stop-btn warn-btn" bindtap="handleStop" wx:if="{{showStopButton}}">
          <image class="stop-btn-icon" src="{{stopIcon}}" mode="aspectFit" />
          <text class="stop-btn-text">停止</text>
        </view>
        <!-- 隐藏时的占位元素 -->
        <view class="stop-btn-placeholder" wx:if="{{!showStopButton}}"></view>
      </view>
      
    </view>
    <view class="mt-34 flex-col self-stretch group_2">
      <view class="flex-col section_3">
        <view class="flex-row justify-between items-center group_3">
          <view class="flex-row items-center">
            <image
              class="shrink-0 image_4"
              src="/images/icons/stopwatch.svg"
              mode="aspectFit"
            />
            <text class="font ml-13">{{isCountdown ? '倒计时' : '正计时'}}模式</text>
          </view>
          <switch checked="{{isCountdown}}" bindchange="toggleMode" color="#b29764" />
        </view>
        <view class="flex-row justify-between items-center section_4" bindtap="showTimePicker" wx:if="{{isCountdown}}">
          <view class="flex-col items-start">
            <text class="font_2 text_5 text_6">时长</text>
            <text class="mt-8 font text_7">{{durationText}}</text>
          </view>
          <image
            class="image_6"
            src="/images/icons/chevron-right.svg"
            mode="aspectFit"
          />
        </view>
      </view>
        <view class="mt-12 flex-row justify-between items-center section_5" bindtap="showMusicPicker">
        <view class="flex-row items-center">
          <image
            class="image_4"
            src="/images/icons/music.svg"
            mode="aspectFit"
          />
          <view class="flex-col items-center ml-13">
            <text class="font_2 text_5 text_8">背景音乐</text>
            <text class="font mt-7">{{musicText}}</text>
          </view>
        </view>
        <image
          class="image_6"
          src="/images/icons/chevron-right.svg"
          mode="aspectFit"
        />
      </view>
    </view>
  </view>

  <!-- 时长选择器模态框 -->
  <view wx:if="{{showTimePicker}}" class="time-picker-modal">
    <view class="time-picker-overlay" bindtap="hideTimePicker"></view>
    <view class="time-picker-content">
      <view class="time-picker-header">
        <text class="time-picker-title">选择时长</text>
        <text class="duration-manage" bindtap="toggleDurationEditing">{{editingDurations ? '完成' : '管理推荐'}}</text>
        <view class="time-picker-close" bindtap="hideTimePicker">✕</view>
      </view>
      <view class="time-picker-options">
        <view 
          wx:for="{{timeOptions}}" 
          wx:key="value"
          class="time-option {{item.value === duration ? 'selected' : ''}} {{editingDurations ? 'time-option-editing' : ''}}"
          bindtap="selectDuration"
          data-value="{{item.value}}"
        >
          <text class="time-option-text">{{item.text}}</text>
          <view wx:if="{{editingDurations}}" class="duration-actions">
            <view class="duration-reorder">
              <button class="duration-move" size="mini" hover-class="duration-move-pressed" catchtap="moveRecommendedDuration" data-value="{{item.value}}" data-offset="-1" disabled="{{index === 0}}" aria-label="上移{{item.text}}">
                <view class="duration-arrow duration-arrow-up" aria-hidden="true"></view>
              </button>
            </view>
            <text class="duration-delete" catchtap="removeRecommendedDuration" data-value="{{item.value}}">移除</text>
          </view>
        </view>
        <text wx:if="{{!timeOptions.length}}" class="duration-empty">添加你常用的静坐时长</text>
      </view>
      <view class="duration-footer">
        <button class="duration-add" bindtap="addRecommendedDuration">＋ 添加推荐</button>
        <button class="duration-custom" bindtap="chooseCustomDuration">自定义时长</button>
      </view>
    </view>
  </view>

  <!-- 自定义时长弹窗 -->
  <view wx:if="{{showCustomTimePicker}}" class="custom-time-modal">
    <view class="custom-time-overlay" bindtap="hideCustomTimePicker"></view>
    <view class="custom-time-content">
      <view class="custom-time-header">
        <text class="custom-time-title">{{customTimeTitle}}</text>
        <view class="custom-time-close" bindtap="hideCustomTimePicker">✕</view>
      </view>
      <view class="custom-time-body">
        <view class="custom-time-input-container">
          <input 
            class="custom-time-input" 
            type="number" 
            placeholder="请输入"
            bindinput="onCustomTimeInput"
            value="{{customTimeInput}}"
            maxlength="3"
          />
          <text class="custom-time-unit">分钟</text>
        </view>
        <view class="custom-time-validation">
          <text wx:if="{{customTimeInput && !isValidCustomTime}}" class="validation-error">
            时长必须在1-180分钟之间
          </text>
        </view>
      </view>
      <view class="custom-time-footer">
        <button 
          class="custom-time-cancel-btn" 
          bindtap="hideCustomTimePicker"
        >取消</button>
        <button 
          class="custom-time-confirm-btn {{isValidCustomTime ? 'active' : 'disabled'}}" 
          bindtap="confirmCustomTime"
          disabled="{{!isValidCustomTime}}"
        >确定</button>
      </view>
    </view>
  </view>

  <!-- 背景音乐选择器模态框 -->
  <view wx:if="{{showMusicPicker}}" class="music-picker-modal">
    <view class="music-picker-overlay" bindtap="hideMusicPicker"></view>
    <view class="music-picker-content">
      <view class="music-picker-header">
        <text class="music-picker-title">选择背景音乐</text>
        <view class="music-picker-close" bindtap="hideMusicPicker">✕</view>
      </view>
      <view class="music-picker-options">
        <view 
          wx:for="{{musicOptions}}" 
          wx:key="value"
          class="music-option {{item.value === backgroundMusic ? 'selected' : ''}}"
          bindtap="selectMusic"
          data-value="{{item.value}}"
        >
          <text class="music-option-text">{{item.text}}</text>
        </view>
      </view>
    </view>
  </view>
  <!-- 感受可留空，直接确认即可完成本次静坐。 -->
  <view wx:if="{{showCompletionDialog}}" class="completion-modal">
    <view class="completion-overlay"></view>
    <view class="completion-content">
      <text class="completion-title">静坐结束</text>
      <text class="completion-summary">这一刻，已静坐 {{completionDuration}} 分钟</text>
      <textarea class="completion-input" placeholder="此刻有什么感受？可以写下来，也可以留白。" value="{{completionText}}" bindinput="onCompletionInput" maxlength="2000" disabled="{{isSavingCompletion || isCompletionSaved}}" show-confirm-bar="{{false}}" />
      <text class="completion-hint">感受选填，留空也可以直接确定</text>
      <button class="completion-confirm" bindtap="confirmCompletion" loading="{{isSavingCompletion}}" disabled="{{isSavingCompletion}}">{{isCompletionSaved ? '查看日签' : '确定'}}</button>
    </view>
  </view>
</view>
