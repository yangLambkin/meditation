/* 登录按钮样式 */
.login-button {
  background-color: #b29764;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  margin: 0;
}

.login-button:active {
  background-color: #8c7345;
}

/* 头像修改功能样式 */
.avatar-container {
  position: relative;
  width: 127.96rpx;
  height: 127.96rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  padding: 8rpx;
  text-align: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.avatar-container:active .avatar-edit-hint {
  opacity: 1;
}

.edit-text {
  color: white;
  font-size: 20rpx;
  font-weight: 500;
}

.edit-hint {
  font-size: 20rpx;
  color: #b29764;
  margin-top: 4rpx;
  display: block;
}

/* 必经之路绑定区块（在"坚持静坐第 X 天"下方，左对齐到文字起点） */
.bijing-inline {
  margin-top: 36rpx;
  background-color: #ffffff;
}
.bijing-row {
  display: flex;
  align-items: center;
}
.bijing-bound-tip {
  display: block;
  font-size: 20rpx;
  color: #b29764;
  margin-top: 12rpx;
}
.bijing-last {
  display: block;
  font-size: 20rpx;
  color: #99a1ae;
  line-height: 28rpx;
  margin-top: 8rpx;
}
.bijing-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bijing-input {
  width: 280rpx;
  height: 45rpx;
  border: solid 2rpx #e3e7ec;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 23rpx;
  background-color: #f8fafc;
}
.bijing-btn-sm {
  display: inline-block;
  background-color: #b29764;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  padding: 13rpx 20rpx;
  border-radius: 8rpx;
  line-height: 1;
}
.bijing-btn-sm:active {
  background-color: #8c7345;
}
.bijing-btn-sm.cancel {
  background-color: #c0c6cf;
}
.bijing-btn-sm.rebind {
  background-color: #f2f3f5;
  color: #8a8f99;
  margin-left: 20rpx;
}
.bijing-btn-sm.rebind:active {
  background-color: #e8eaed;
}

/* 绑定确认弹窗 */
.bijing-modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.bijing-modal {
  width: 560rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 36rpx 28rpx;
  box-sizing: border-box;
}
.bijing-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 28rpx;
}
.bijing-modal-row {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 14rpx;
  text-align: left;
}
.bijing-modal-label {
  color: #888888;
  flex-shrink: 0;
}
.bijing-modal-value {
  color: #333333;
  word-break: break-all;
}
.bijing-modal-btns {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}
.bijing-modal-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  padding: 18rpx 0;
  border-radius: 8rpx;
}
.bijing-modal-btn.cancel {
  background-color: #f2f3f5;
  color: #666666;
  margin-right: 20rpx;
}
.bijing-modal-btn.confirm {
  background-color: #b29764;
  color: #ffffff;
}
.bijing-card-inline {
  padding: 8rpx 48rpx 28rpx;
  background-color: #ffffff;
}
.bijing-card {
  padding: 16rpx 48rpx 36rpx;
  background-color: #ffffff;
}