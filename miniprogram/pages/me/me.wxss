/* pages/me/me.wxss */
page {
  overflow: hidden;
}

/* 功能列表：统一图标、行高与分隔线，跳转项显示箭头 */
.me-menu {
  margin: 20rpx 32rpx 0;
  border: 1rpx solid #eef0f3;
  border-radius: 24rpx;
  background-color: #ffffff;
  overflow: hidden;
}
.me-menu-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 16rpx 28rpx;
  gap: 16rpx;
}
.me-menu-row + .me-menu-row::before {
  content: '';
  position: absolute;
  top: 0;
  left: 108rpx;
  right: 28rpx;
  height: 1rpx;
  background-color: #f0f2f5;
}
.me-menu-row-hover {
  background-color: #faf8f3;
}
.me-menu-leading,
.me-menu-trailing {
  display: flex;
  align-items: center;
}
.me-menu-leading {
  min-width: 0;
  gap: 20rpx;
}
.me-menu-trailing {
  flex-shrink: 0;
  gap: 12rpx;
}
.me-menu-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background-color: #faf7f0;
}
.me-menu-icon {
  display: block;
  width: 38rpx;
  height: 38rpx;
}
.me-menu-label {
  color: #354152;
  font-size: 28rpx;
  line-height: 1.5;
}
.me-menu-label-with-dot {
  position: relative;
  display: flex;
  align-items: center;
}
.me-menu-alert-dot {
  position: absolute;
  top: 50%;
  right: -22rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #ff4d4f;
  transform: translateY(-50%);
}
.me-menu-note {
  color: #8b94a2;
  font-size: 24rpx;
  line-height: 1.5;
}
.me-menu-version {
  flex-shrink: 0;
}
.me-menu-chevron {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  opacity: 0.65;
}
.ml-17 {
  margin-left: 34rpx;
}
.page {
  padding-bottom: 32rpx;
  background-color: #f8fafc;
  overflow: hidden;
  width: 100%;
  height: 100%;
}
.section {
  padding: 16rpx 48rpx;
  background-color: #ffffff;
}
.group {
  padding: 12rpx 0;
}
.text-wrapper {
  padding: 48rpx 0;
  background-image: linear-gradient(180deg, #b29764 0%, #8c7345 100%);
  border-radius: 100663200rpx;
  overflow: hidden;
  width: 127.96rpx;
  height: 127.96rpx;
}
.font {
  font-size: 30rpx;
  font-family: Arimo;
  font-weight: 700;
}
.text_2 {
  color: #ffffff;
  line-height: 27.52rpx;
}

.avatar-circle {
  width: 127.96rpx;
  height: 127.96rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f0f0f0; /* 备用背景色 */
}
.text {
  color: #b29764;
  line-height: 38.08rpx;
}
.image_2 {
  margin-right: 16rpx;
}
.group_2 {
  padding: 20rpx 0 12rpx;
  border-top: solid 3rpx #f2f4f6;
}
.group_3 {
  padding: 16rpx 0 24rpx;
  width: 218rpx;
  border-right: solid 3rpx #f2f4f6;
}
.font_3 {
  font-size: 40rpx;
  font-family: Arimo;
  line-height: 33.52rpx;
  font-weight: 700;
  color: #b29764;
}
.text_4 {
  line-height: 33.98rpx;
}
.group_4 {
  margin-right: 84rpx;
  margin-top: 16rpx;
}
.text_5 {
  line-height: 33.5rpx;
}
.text_3 {
  color: #697282;
}
.font_4 {
  font-size: 24rpx;
  font-family: Arimo;
  line-height: 22.18rpx;
  color: #697282;
}
.text_6 {
  line-height: 22.12rpx;
}
.text_10 {
  margin-top: auto;
  padding-top: 16rpx;
  color: #99a1ae;
  line-height: 22.38rpx;
}

/* 登录按钮样式 */
.login-button {
  background-color: #b29764;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  margin: 0;
}

.login-button:active {
  background-color: #8c7345;
}

/* 头像修改功能样式 */
.avatar-container {
  position: relative;
  width: 127.96rpx;
  height: 127.96rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  padding: 8rpx;
  text-align: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.avatar-container:active .avatar-edit-hint {
  opacity: 1;
}

.edit-text {
  color: white;
  font-size: 20rpx;
  font-weight: 500;
}

.edit-hint {
  font-size: 20rpx;
  color: #b29764;
  margin-top: 4rpx;
  display: block;
}

/* 必经之路同步：突出默认自动同步，手动操作保持次要层级 */
.bijing-sync-card {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #eee7da;
  border-radius: 20rpx;
  background-color: #faf8f3;
}
.bijing-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.bijing-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #514a3e;
}
.bijing-auto-badge {
  padding: 6rpx 14rpx;
  border-radius: 100rpx;
  background-color: #eee8da;
  font-size: 20rpx;
  line-height: 1.4;
  color: #826b40;
}
.bijing-account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  column-gap: 16rpx;
  margin-top: 8rpx;
}
.bijing-bound-tip {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7c7569;
  word-break: break-all;
}
.bijing-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.bijing-auto-note {
  margin-top: 12rpx;
}
.bijing-auto-note-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.6;
  color: #62594a;
}
.bijing-auto-note-detail,
.bijing-bind-description {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #857d70;
}
.bijing-auto-note-detail {
  margin-top: 4rpx;
}
.bijing-bind-description {
  margin-top: 12rpx;
}
.bijing-last {
  display: block;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #eee7da;
  font-size: 22rpx;
  color: #7c7569;
  line-height: 1.6;
  word-break: break-word;
}
.bijing-input-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.bijing-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  box-sizing: border-box;
  border: solid 2rpx #e3e7ec;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  background-color: #ffffff;
}
.bijing-btn-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  background-color: #b29764;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  line-height: 1.4;
}
.bijing-btn-sm:active {
  background-color: #8c7345;
}
.bijing-manual-btn {
  border: 2rpx solid #c9b68f;
  background-color: #ffffff;
  color: #8c7345;
}
.bijing-manual-btn:active {
  background-color: #f0eadd;
}
.bijing-manual-btn.is-syncing {
  opacity: 0.6;
}
.bijing-text-action {
  padding: 16rpx 0;
  color: #8a8173;
  font-size: 22rpx;
  line-height: 1.5;
}
.bijing-text-action:active {
  color: #8c7345;
}
.bijing-unbind {
  color: #a14b3c;
}
.bijing-btn-sm.is-busy,
.bijing-text-action.is-busy {
  opacity: 0.5;
}

/* 绑定确认与同步日期弹窗 */
.bijing-modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.bijing-modal {
  width: 560rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 36rpx 28rpx;
  box-sizing: border-box;
}
.bijing-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 28rpx;
}
.bijing-modal-row {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 14rpx;
  text-align: left;
}
.bijing-modal-label {
  color: #888888;
  flex-shrink: 0;
}
.bijing-modal-value {
  color: #333333;
  word-break: break-all;
}
.bijing-modal-btns {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}
.bijing-modal-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  padding: 18rpx 0;
  border-radius: 8rpx;
}
.bijing-modal-btn.cancel {
  background-color: #f2f3f5;
  color: #666666;
  margin-right: 20rpx;
}
.bijing-modal-btn.confirm {
  background-color: #b29764;
  color: #ffffff;
}
.bijing-sync-hint {
  color: #888888;
  font-size: 24rpx;
  line-height: 1.6;
  margin: -8rpx 0 24rpx;
}
.bijing-date-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e3e7ec;
  border-radius: 12rpx;
  color: #333333;
  font-size: 28rpx;
}
.bijing-date-option.selected {
  border-color: #b29764;
  background-color: #faf7f0;
}
.bijing-date-text {
  display: flex;
  align-items: center;
}
.bijing-date-label {
  margin-left: 20rpx;
  color: #888888;
  font-size: 24rpx;
}
.bijing-sync-modal {
  width: 650rpx;
  padding: 28rpx 32rpx;
}
.bijing-sync-dates {
  height: 252rpx;
}
.bijing-sync-modal .bijing-date-option {
  padding: 12rpx 20rpx;
  margin-bottom: 12rpx;
}
.bijing-sync-details {
  margin-top: 24rpx;
  color: #333333;
  text-align: left;
}
.bijing-details-title {
  font-size: 26rpx;
  font-weight: 600;
}
.bijing-details-total {
  margin: 12rpx 0;
  color: #8c7345;
  font-size: 28rpx;
  font-weight: 600;
}
.bijing-details-note {
  margin-bottom: 10rpx;
  color: #888888;
  font-size: 22rpx;
}
.bijing-record-heading,
.bijing-record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: 1.5;
}
.bijing-record-heading {
  color: #888888;
  background-color: #faf7f0;
  padding: 10rpx 12rpx;
  font-size: 22rpx;
}
.bijing-sync-records {
  height: 180rpx;
}
.bijing-record-row {
  padding: 14rpx 12rpx;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 26rpx;
}
.bijing-details-state {
  padding: 28rpx 0;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}
.bijing-details-error {
  display: block;
  overflow-wrap: break-word;
}
.bijing-details-retry {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  color: #8c7345;
  background-color: #faf7f0;
  border-radius: 8rpx;
}
.bijing-sync-modal .bijing-modal-btn {
  line-height: 1.4;
}
.bijing-sync-submit {
  margin: 0;
  font-weight: normal;
}
.bijing-sync-submit::after {
  border: none;
}
.bijing-sync-submit[disabled] {
  background-color: #e6e1d7;
  color: #aaa296;
}
.bijing-card-inline {
  padding: 8rpx 48rpx 28rpx;
  background-color: #ffffff;
}
.bijing-card {
  padding: 16rpx 48rpx 36rpx;
  background-color: #ffffff;
}

/* 短屏进一步收紧留白，禁用页面滚动后仍能看到底部菜单。 */
@media (max-height: 600px) {
  .section {
    padding: 8rpx 40rpx;
  }
  .group {
    padding: 8rpx 0;
  }
  .bijing-sync-card {
    margin-bottom: 12rpx;
    padding: 16rpx;
  }
  .group_2 {
    padding-top: 12rpx;
  }
  .group_3 {
    padding: 8rpx 0 20rpx;
  }
  .me-menu {
    margin-top: 12rpx;
  }
  .me-menu-row {
    min-height: 88rpx;
    padding-top: 12rpx;
    padding-bottom: 12rpx;
  }
  .text_10 {
    padding-top: 12rpx;
  }
}
