/* 登录按钮样式 */
.login-button {
  background-color: #b29764;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  margin: 0;
}

.login-button:active {
  background-color: #8c7345;
}

/* 头像修改功能样式 */
.avatar-container {
  position: relative;
  width: 127.96rpx;
  height: 127.96rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  padding: 8rpx;
  text-align: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.avatar-container:active .avatar-edit-hint {
  opacity: 1;
}

.edit-text {
  color: white;
  font-size: 20rpx;
  font-weight: 500;
}

.edit-hint {
  font-size: 20rpx;
  color: #b29764;
  margin-top: 4rpx;
  display: block;
}

/* 必经之路同步：突出默认自动同步，手动操作保持次要层级 */
.bijing-sync-card {
  margin-bottom: 32rpx;
  padding: 28rpx;
  border: 2rpx solid #eee7da;
  border-radius: 20rpx;
  background-color: #faf8f3;
}
.bijing-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.bijing-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #514a3e;
}
.bijing-auto-badge {
  padding: 6rpx 14rpx;
  border-radius: 100rpx;
  background-color: #eee8da;
  font-size: 20rpx;
  line-height: 1.4;
  color: #826b40;
}
.bijing-account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  column-gap: 16rpx;
  margin-top: 8rpx;
}
.bijing-bound-tip {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7c7569;
  word-break: break-all;
}
.bijing-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}
.bijing-auto-note {
  margin-top: 20rpx;
}
.bijing-auto-note-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.6;
  color: #62594a;
}
.bijing-auto-note-detail,
.bijing-bind-description {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #857d70;
}
.bijing-auto-note-detail {
  margin-top: 4rpx;
}
.bijing-bind-description {
  margin-top: 12rpx;
}
.bijing-last {
  display: block;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #eee7da;
  font-size: 22rpx;
  color: #7c7569;
  line-height: 1.6;
  word-break: break-word;
}
.bijing-input-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.bijing-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  box-sizing: border-box;
  border: solid 2rpx #e3e7ec;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  background-color: #ffffff;
}
.bijing-btn-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  background-color: #b29764;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  line-height: 1.4;
}
.bijing-btn-sm:active {
  background-color: #8c7345;
}
.bijing-manual-btn {
  border: 2rpx solid #c9b68f;
  background-color: #ffffff;
  color: #8c7345;
}
.bijing-manual-btn:active {
  background-color: #f0eadd;
}
.bijing-manual-btn.is-syncing {
  opacity: 0.6;
}
.bijing-text-action {
  padding: 16rpx 0;
  color: #8a8173;
  font-size: 22rpx;
  line-height: 1.5;
}
.bijing-text-action:active {
  color: #8c7345;
}

/* 绑定确认与同步日期弹窗 */
.bijing-modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.bijing-modal {
  width: 560rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 36rpx 28rpx;
  box-sizing: border-box;
}
.bijing-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 28rpx;
}
.bijing-modal-row {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 14rpx;
  text-align: left;
}
.bijing-modal-label {
  color: #888888;
  flex-shrink: 0;
}
.bijing-modal-value {
  color: #333333;
  word-break: break-all;
}
.bijing-modal-btns {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}
.bijing-modal-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  padding: 18rpx 0;
  border-radius: 8rpx;
}
.bijing-modal-btn.cancel {
  background-color: #f2f3f5;
  color: #666666;
  margin-right: 20rpx;
}
.bijing-modal-btn.confirm {
  background-color: #b29764;
  color: #ffffff;
}
.bijing-sync-hint {
  color: #888888;
  font-size: 24rpx;
  line-height: 1.6;
  margin: -8rpx 0 24rpx;
}
.bijing-date-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e3e7ec;
  border-radius: 12rpx;
  color: #333333;
  font-size: 28rpx;
}
.bijing-date-option.selected {
  border-color: #b29764;
  background-color: #faf7f0;
}
.bijing-date-text {
  display: flex;
  align-items: center;
}
.bijing-date-label {
  margin-left: 20rpx;
  color: #888888;
  font-size: 24rpx;
}
.bijing-sync-modal {
  width: 650rpx;
  padding: 28rpx 32rpx;
}
.bijing-sync-modal .bijing-date-option {
  padding: 12rpx 20rpx;
  margin-bottom: 12rpx;
}
.bijing-sync-details {
  margin-top: 24rpx;
  color: #333333;
  text-align: left;
}
.bijing-details-title {
  font-size: 26rpx;
  font-weight: 600;
}
.bijing-details-total {
  margin: 12rpx 0;
  color: #8c7345;
  font-size: 28rpx;
  font-weight: 600;
}
.bijing-details-note {
  margin-bottom: 10rpx;
  color: #888888;
  font-size: 22rpx;
}
.bijing-record-heading,
.bijing-record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: 1.5;
}
.bijing-record-heading {
  color: #888888;
  background-color: #faf7f0;
  padding: 10rpx 12rpx;
  font-size: 22rpx;
}
.bijing-sync-records {
  height: 180rpx;
}
.bijing-record-row {
  padding: 14rpx 12rpx;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 26rpx;
}
.bijing-details-state {
  padding: 28rpx 0;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}
.bijing-details-error {
  display: block;
  overflow-wrap: break-word;
}
.bijing-details-retry {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  color: #8c7345;
  background-color: #faf7f0;
  border-radius: 8rpx;
}
.bijing-sync-modal .bijing-modal-btn {
  line-height: 1.4;
}
.bijing-sync-submit {
  margin: 0;
  font-weight: normal;
}
.bijing-sync-submit::after {
  border: none;
}
.bijing-sync-submit[disabled] {
  background-color: #e6e1d7;
  color: #aaa296;
}
.bijing-card-inline {
  padding: 8rpx 48rpx 28rpx;
  background-color: #ffffff;
}
.bijing-card {
  padding: 16rpx 48rpx 36rpx;
  background-color: #ffffff;
}
