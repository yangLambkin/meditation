  color: #b29764;
}
.text_4 {
  line-height: 33.98rpx;
}
.group_4 {
  margin-right: 84rpx;
  margin-top: 16rpx;
}
.text_5 {
  line-height: 33.5rpx;
}
.section_2 {
  padding-bottom: 32rpx;
  background-color: #ffffff;
}
.group_5 {
  padding: 32rpx 48rpx;
  border-bottom: solid 3rpx #f8fafb;
}
.image_3 {
  width: 32rpx;
  height: 32rpx;
}
.group_6 {
  padding: 0 48rpx;
}
.section_3 {
  background-color: #ffffff;
}
