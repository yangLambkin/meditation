.page {
  padding-bottom: 448rpx;
  background-color: #f8fafc;
  overflow: hidden;
  width: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  height: 100%;
}
.section {
  padding: 36rpx 48rpx 48rpx;
  background-color: #ffffff;
}
.group {
  padding: 36rpx 0;
}
.text-wrapper {
  padding: 48rpx 0;
  background-image: linear-gradient(180deg, #b29764 0%, #8c7345 100%);
  border-radius: 100663200rpx;
  overflow: hidden;
