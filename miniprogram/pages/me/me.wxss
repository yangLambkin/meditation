  line-height: 27.52rpx;
}

.avatar-circle {
  width: 127.96rpx;
  height: 127.96rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f0f0f0; /* 备用背景色 */
}
.text {
  color: #b29764;
  line-height: 38.08rpx;
}
.image {
  width: 40rpx;
  height: 40rpx;
}
.image_2 {
  margin-right: 16rpx;
}
.group_2 {
  padding: 52rpx 0 4rpx;
  border-top: solid 3rpx #f2f4f6;
}
.group_3 {
  padding-top: 16rpx;
  width: 218rpx;
  height: 89.92rpx;
