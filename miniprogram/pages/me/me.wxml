<!--pages/me/me.wxml-->
<view class="flex-col page">
  <view class="flex-col self-stretch">
    <view class="flex-col section">
      <!-- 用户信息显示区域 -->
      <view class="flex-row justify-between items-center group">
        <view class="flex-row items-center">
          <!-- 头像区域，点击可修改 -->
          <view class="avatar-container" bindtap="changeAvatar">
            <nickname-avatar
              avatar-class="shrink-0 avatar-circle"
              src="{{userAvatar}}"
              nickname="{{userNickname}}"
              size="{{127.96}}"
            />
            <view class="avatar-edit-hint">
              <text class="edit-text">修改</text>
            </view>
          </view>
          <view class="flex-col items-start ml-17">
            <!-- 未设置个人信息时显示 -->
            <view wx:if="{{!hasUserInfo}}" bindtap="goToProfilePage">
              <text class="font text">点击登录</text>
            </view>
            <!-- 已设置个人信息时显示昵称，点击可修改 -->
            <view wx:else bindtap="goToProfilePage">
              <text class="font text">{{userNickname}}</text>
              <text class="edit-hint">点击修改</text>
            </view>
            <!-- 同步日为北京时间 02:00 至次日 02:00，只提供最近七个已结束的同步日 -->
            <view wx:if="{{bijingShowSyncDatePicker}}" class="bijing-modal-mask" bindtap="cancelBijingSyncDate" catchtouchmove="noop">
              <view class="bijing-modal bijing-sync-modal" catchtap="noop">
                <view class="bijing-modal-title">选择同步日期</view>
                <view class="bijing-sync-hint">每天按北京时间 02:00 至次日 02:00 统计，可同步最近 7 个已结束的同步日，滑动选择日期</view>
                <scroll-view class="bijing-sync-dates" scroll-y="{{true}}" scroll-into-view="bijing-date-{{bijingSyncDate}}">
                  <radio-group bindchange="onBijingSyncDateChange">
                    <label wx:for="{{bijingSyncDateOptions}}" wx:key="date" id="bijing-date-{{item.date}}" class="bijing-date-option {{bijingSyncDate === item.date ? 'selected' : ''}}">
                      <view class="bijing-date-text"><text>{{item.date}}</text><text class="bijing-date-label">{{item.label}}</text></view>
                      <radio value="{{item.date}}" checked="{{bijingSyncDate === item.date}}" color="#b29764" />
                    </label>
                  </radio-group>
                </scroll-view>
                <view class="bijing-sync-details">
                  <view class="bijing-details-title">{{bijingSyncDate}} 打卡明细</view>
                  <view class="bijing-details-note">{{bijingSyncDate}} 02:00 至次日 02:00 前（北京时间）</view>
                  <view wx:if="{{bijingSyncDetailsLoading}}" class="bijing-details-state">正在加载当天记录…</view>
                  <view wx:elif="{{bijingSyncDetailsError}}" class="bijing-details-state">
                    <text class="bijing-details-error">{{bijingSyncDetailsError}}</text>
                    <view class="bijing-details-retry" bindtap="retryBijingSyncDetails">重新加载</view>
                  </view>
                  <block wx:else>
                    <view class="bijing-details-total">共 {{bijingSyncRecordCount}} 次，合计 {{bijingSyncTotalDuration}} 分钟</view>
                    <view wx:if="{{bijingSyncTotalDuration !== bijingSyncDuration}}" class="bijing-details-note">同步时按 {{bijingSyncDuration}} 分钟上报</view>
                    <view wx:if="{{bijingSyncAlreadySynced}}" class="bijing-details-note">这一天已同步，可再次同步更新记录</view>
                    <view wx:if="{{!bijingSyncRecordCount}}" class="bijing-details-state">当天暂无打卡记录</view>
                    <block wx:else>
                      <view class="bijing-record-heading"><text>打卡时间（北京时间）</text><text>静坐时长</text></view>
                      <scroll-view class="bijing-sync-records" scroll-y="{{true}}">
                        <view wx:for="{{bijingSyncRecords}}" wx:key="id" class="bijing-record-row">
                          <text>{{item.timeLabel}}</text><text>{{item.durationText}} 分钟</text>
                        </view>
                      </scroll-view>
                    </block>
                  </block>
                </view>
                <view class="bijing-modal-btns">
                  <view class="bijing-modal-btn cancel" bindtap="cancelBijingSyncDate">取消</view>
                  <button class="bijing-modal-btn confirm bijing-sync-submit" disabled="{{bijingSyncDetailsLoading || bijingSyncDetailsError || bijingSyncDetailsDate !== bijingSyncDate || !bijingSyncRecordCount || bijingSyncDuration <= 0}}" bindtap="confirmBijingSyncDate">同步这一天</button>
                </view>
              </view>
            </view>

            <!-- 绑定确认弹窗 -->
            <view wx:if="{{bijingShowConfirm}}" class="bijing-modal-mask" bindtap="cancelBindConfirm">
              <view class="bijing-modal" catchtap="noop">
                <view class="bijing-modal-title">确认绑定</view>
                <view class="bijing-modal-row"><text class="bijing-modal-label">学号：</text><text class="bijing-modal-value">{{bijingConfirmSn}}</text></view>
                <view class="bijing-modal-row"><text class="bijing-modal-label">昵称：</text><text class="bijing-modal-value">{{bijingConfirmNickname}}</text></view>
                <view class="bijing-modal-btns">
                  <view class="bijing-modal-btn cancel" bindtap="cancelBindConfirm">取消</view>
                  <view class="bijing-modal-btn confirm" bindtap="confirmBindConfirm">确定</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 同步独立成卡片，自动同步为默认方式，手动入口用于补录与重试 -->
      <view class="bijing-sync-card">
        <view class="bijing-card-header">
          <text class="bijing-card-title">必经之路同步</text>
          <text wx:if="{{bijingBound}}" class="bijing-auto-badge">自动同步</text>
        </view>
        <view wx:if="{{bijingShowBindInput}}" class="bijing-binding-form">
          <text class="bijing-bind-description">{{bijingBound ? '输入新学号，确认后更换绑定' : '绑定学号后，静坐记录将每天自动同步'}}</text>
          <view class="bijing-input-row">
            <input
              class="bijing-input"
              placeholder="请输入以大写 BJ 开头的学号"
              value="{{bijingInputValue}}"
              bindinput="onBijingInput"
            />
          </view>
          <view class="bijing-actions">
            <view class="bijing-btn-sm" bindtap="confirmBindBijing">确认绑定</view>
            <view class="bijing-text-action" bindtap="cancelBindBijing">取消</view>
          </view>
        </view>
        <block wx:elif="{{bijingBound}}">
          <view class="bijing-account-row">
            <text class="bijing-bound-tip">已绑定学号：{{bijingStudentNumber}}</text>
            <view class="bijing-text-action" bindtap="toggleBindInput">重新绑定</view>
          </view>
          <view class="bijing-actions">
            <view class="bijing-btn-sm bijing-manual-btn {{bijingSyncing ? 'is-syncing' : ''}}" bindtap="syncBijingNow">{{bijingSyncing ? '同步中...' : '手动同步'}}</view>
            <view wx:if="{{bijingStudentNumber}}" class="bijing-text-action" bindtap="openBijingHeatmap">查看热力图</view>
          </view>
          <view class="bijing-auto-note">
            <text class="bijing-auto-note-title">日常无需手动同步</text>
            <text class="bijing-auto-note-detail">每天北京时间 02:00 自动同步；补录或重试时，再使用手动同步。</text>
          </view>
          <text wx:if="{{bijingLastSync}}" class="bijing-last">{{bijingLastSync}}</text>
        </block>
        <block wx:else>
          <text class="bijing-bind-description">绑定学号后，静坐记录将每天自动同步到必经之路。</text>
          <view class="bijing-actions">
            <view class="bijing-btn-sm" bindtap="toggleBindInput">绑定学号</view>
          </view>
        </block>
      </view>

      <view class="flex-row justify-between group_2">
        <view class="flex-row self-center">
          <view class="flex-col items-center group_3">
            <text class="font_3 text_4">{{totalMinutes}}</text>
            <text class="mt-14 font_4">当月总分钟</text>
          </view>
          <view class="flex-col items-center group_3">
            <text class="font_3">{{longestCheckInDays}}</text>
            <text class="mt-14 font_4">最长连续天数</text>
          </view>
        </view>
        <view class="flex-col items-center group_3">
          <text class="font_3 text_5">{{medals}}</text>
          <text class="mt-14 font_4">勋章</text>
        </view>
      </view>
    </view>
    <view class="mt-16 flex-col section_2">
      <view class="flex-row justify-between items-center group_5" bindtap="goToBadgePage">
        <view class="flex-row items-center">
          <image
            class="shrink-0 image"
          />
          <text class="font_2 ml-17">我的勋章</text>
        </view>
        <image
          class="image_3"
        />
      </view>
    </view>
    <view class="mt-16 flex-col section_3">
      <view class="flex-row justify-between items-center group_7" bindtap="onVersionTap">
        <view class="flex-row items-center">
          <image
            class="shrink-0 image"
          />
          <text class="font_2 text_9 ml-17">版本 V2.10.1</text>
        </view>
        <image
          class="image_3"
        />
      </view>
    </view>
  </view>
  <text class="mt-20 self-center font_4 text_10">Designed by GenXin</text>
</view>
