@import "../practices/practices.wxss";
.practice-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.stats-periods { display: flex; gap: 12rpx; margin-top: 24rpx; }
button.stats-period { flex: 1; width: auto; margin: 0; padding: 0 16rpx; border: 1rpx solid #e8e4dc; border-radius: 32rpx; color: #8c949e; background: transparent; font-size: 25rpx; font-weight: 400; line-height: 62rpx; }
button.stats-period.selected { color: #9c8050; background: #f5f1e8; border-color: #d9cdb6; font-weight: 600; }
.period-summary { border-color: #e5d9c2; }
.period-heading { display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; align-items: baseline; justify-content: space-between; }
.period-heading .card-title { margin-bottom: 0; }
.period-summary .headline-stats { padding-top: 20rpx; }
.period-summary .metric { min-width: 0; }
.metric-value { overflow-wrap: anywhere; }
.year-month { display: flex; align-items: center; gap: 16rpx; min-height: 76rpx; padding: 0 4rpx; border-radius: 10rpx; }
.year-month-label { flex: 0 0 64rpx; color: #596273; font-size: 25rpx; }
.year-month-track { flex: 1; height: 14rpx; border-radius: 7rpx; background: #f5f2ec; overflow: hidden; }
.year-month-bar { height: 100%; border-radius: 7rpx; background: #b29764; }
.year-month-value { flex: 0 0 96rpx; text-align: right; color: #8a795a; font-size: 24rpx; font-variant-numeric: tabular-nums; }
.year-month-arrow { flex-shrink: 0; width: 10rpx; height: 10rpx; margin-right: 4rpx; border-top: 2rpx solid #b29764; border-right: 2rpx solid #b29764; transform: rotate(45deg); }
.year-month-future { padding-right: 18rpx; }
.year-month-future .year-month-label, .year-month-future .year-month-value { color: #c2c6cc; }
.stats-history-note { padding: 0 8rpx; }
